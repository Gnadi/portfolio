---
// Learn about using Astro layouts:
// https://docs.astro.build/en/core-concepts/layouts/

// Component Imports
import MainHead from '../components/MainHead.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import AskAi from '../components/AskAi.astro';
import Analytics from '@vercel/analytics/astro';
import { DEFAULT_DESCRIPTION, DEFAULT_TITLE, type JsonLdNode } from '../lib/schema';

interface Props {
	title?: string | undefined;
	description?: string | undefined;
	/** Whether this page has both an English and a German counterpart. */
	alternates?: boolean;
	/** Extra JSON-LD nodes merged into the site-wide `@graph`. */
	schema?: JsonLdNode[] | undefined;
	/** `article` on project detail pages, `website` everywhere else. */
	ogType?: 'website' | 'article';
	/** Publication date, for `article:published_time`. */
	publishedTime?: Date | undefined;
	/** Keep the page out of the index (404s). */
	noindex?: boolean;
	/** Offer the “summarise with AI” links. Off where there is nothing to
	 *  summarise, i.e. the 404s. */
	askAi?: boolean;
}

const {
	title,
	description,
	alternates = true,
	schema,
	ogType,
	publishedTime,
	noindex,
	askAi = true,
} = Astro.props;

const pathname = Astro.url.pathname;
const lang = pathname === '/de' || pathname.startsWith('/de/') ? 'de' : 'en';
---

<html lang={lang}>
	<head>
		<link rel="sitemap" href="/sitemap-index.xml"/>
		<MainHead
			title={title}
			description={description}
			alternates={alternates}
			schema={schema}
			ogType={ogType}
			publishedTime={publishedTime}
			noindex={noindex}
		/>
		<Analytics />
	</head>
	<body>
		<div class="stack backgrounds">
			<Nav />
			<slot />
			<div class="page-end">
				{askAi && <AskAi title={title ?? DEFAULT_TITLE} description={description ?? DEFAULT_DESCRIPTION} />}
				<Footer />
			</div>
		</div>

		<style>
			/* Leiste und Footer bleiben zusammen: Ein Auto-Margin für den ganzen
			   Block, statt je eines pro Element — sonst teilt Flexbox den freien
			   Platz einer kurzen Seite gleichmäßig zwischen beiden auf. */
			.page-end {
				margin-top: auto;
			}

			/* The page is a flat surface: one background colour, a thin rule of
			   US Open blue across the top, and nothing else. The old stack of
			   photographic gradients, curve SVGs and a noise overlay is gone —
			   it was what made every page read as murky. */
			.backgrounds {
				min-height: 100%;
				background-color: var(--gray-999);
				border-top: 3px solid var(--accent-regular);
			}
		</style>
	</body>
</html>
