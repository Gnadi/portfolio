---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import aboutPhoto from '../assets/about.jpg';

import ContactCTA from '../components/ContactCTA.astro';
import Hero from '../components/Hero.astro';
import BusinessCard from '../components/BusinessCard.astro';
import { breadcrumbNode, canonicalUrl, profilePageNode } from '../lib/schema';

const canonical = canonicalUrl(Astro.url.pathname);
const schema = [
	profilePageNode(canonical),
	breadcrumbNode(canonical, [
		{ name: 'Gnadlinger', item: canonicalUrl('/') },
		{ name: 'About' },
	]),
];
---

<BaseLayout
	title="About Johannes Gnadlinger | Gnadlinger"
	description="Who Johannes Gnadlinger is: Backend Engineer at Raiffeisen Software GmbH in Linz, Austria, working on corporate payment systems — plus background, education and life outside work."
	schema={schema}
>
	<div class="stack gap-20">
		<main class="wrapper about">
			<Hero
				title="Johannes Gnadlinger"
				tagline="Thanks for stopping by. A short note on what I work on, and who I am off-duty."
			>
				<Image
					src={aboutPhoto}
					widths={[480, 800, 1200, 1600]}
					sizes="(min-width: 50em) 60vw, 100vw"
					loading="eager"
					fetchpriority="high"
					alt="Johannes Gnadlinger"
				/>
			</Hero>

			<section>
				<h2 class="section-title">Background</h2>
				<div class="content">
					<p>
						My focus is corporate payment systems — designing and implementing backend services for transaction processing, SEPA flows, and regulated financial infrastructure.
					</p>
					<p>
						Earlier in my career I built full-stack applications for private banking, which gave me end-to-end experience across frontend and backend before specializing.
					</p>
					<p>
						I work on systems where correctness, reliability, and compliance are critical.
					</p>
				</div>
			</section>

			<section>
				<h2 class="section-title">Personal</h2>
				<div class="content">
					<p>
						Granted, the photo is a bit older ;) But it still describes me well — a cheerful person who loves to travel and meet new people.
					</p>
					<p>
						Growing up in Wels, I moved to Linz several years ago and have been living here with my wife and our two daughters since then.
					</p>
					<p>
						I discovered my passion for programming as a teenager. At sixteen I wrote my first "Hello World"; at twenty I began my career at Raiffeisen Software GmbH, where I continue to learn new things every day.
					</p>
					<p>
						In my free time, I experiment with new technologies on side projects and listen to podcasts on science and politics (exception: Gemischtes Hack).
					</p>
					<p>
						I've managed to quit smoking, and while my success on the tennis court hasn't noticeably improved, I feel better overall.
					</p>
					<p>
						A respectful interaction with others is important to me.
					</p>
				</div>
			</section>

			<section>
				<h2 class="section-title">Education</h2>
				<div class="content">
					<ul>
						<li>HTL (Austrian technical secondary college)</li>
						<li>Civilian service</li>
						<li>Trainee programme @ Raiffeisen Software GmbH</li>
					</ul>
				</div>
			</section>

			<section>
				<h2 class="section-title">Off-duty</h2>
				<div class="content">
					<ul>
						<li>Family</li>
						<li>Tennis</li>
						<li>Hackathons (more so in the past)</li>
					</ul>
				</div>
			</section>

			<div class="card-section">
				<BusinessCard />
				<a class="card-link" href="/card/">Open the card on its own page →</a>
			</div>
		</main>

		<ContactCTA />
	</div>
</BaseLayout>

<style>
	.about {
		display: flex;
		flex-direction: column;
		gap: 3.5rem;
	}

	img {
		margin-top: 1.5rem;
		border-radius: 1.5rem;
		box-shadow: var(--shadow-md);
	}

	section {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		color: var(--gray-200);
	}

	.section-title {
		grid-column-start: 1;
		font-size: var(--text-xl);
		color: var(--gray-0);
	}

	.content {
		grid-column: 2 / 4;
	}

	.content :global(a) {
		text-decoration: 1px solid underline transparent;
		text-underline-offset: 0.25em;
		transition: text-decoration-color var(--theme-transition);
	}

	.content :global(a:hover),
	.content :global(a:focus) {
		text-decoration-color: currentColor;
	}

	.card-section {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.75rem;
	}

	.card-link {
		font-size: var(--text-sm);
		color: var(--gray-400);
		text-decoration: none;
		transition: color var(--theme-transition);
	}

	.card-link:hover,
	.card-link:focus-visible {
		color: var(--accent-regular);
	}

	@media (min-width: 50em) {
		.about {
			display: grid;
			grid-template-columns: 1fr 60% 1fr;
		}

		.about > :global(:first-child) {
			grid-column-start: 2;
		}

		section {
			display: contents;
			font-size: var(--text-lg);
		}

		.card-section {
			grid-column: 2 / 3;
		}
	}
</style>
