---
import BaseLayout from '../layouts/BaseLayout.astro';
import BusinessCardPage from '../components/BusinessCardPage.astro';
import { breadcrumbNode, canonicalUrl } from '../lib/schema';

const canonical = canonicalUrl(Astro.url.pathname);
const schema = [
	breadcrumbNode(canonical, [
		{ name: 'Gnadlinger', item: canonicalUrl('/') },
		{ name: 'About', item: canonicalUrl('/about/') },
		{ name: 'Card' },
	]),
];
---

<BaseLayout
	title="Card | Gnadlinger"
	description="Digital business card for Johannes Gnadlinger — Backend Engineer at Raiffeisen Software GmbH, Linz, Austria."
	schema={schema}
>
	<BusinessCardPage lang="en" />
</BaseLayout>
