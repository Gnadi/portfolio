---
import { getCollection } from 'astro:content';

import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectDetail from '../../components/ProjectDetail.astro';
import { breadcrumbNode, canonicalUrl, projectNode } from '../../lib/schema';

export async function getStaticPaths() {
	// English entries live at the collection root; German ones under `de/`.
	const entries = await getCollection('work');
	return entries
		.map((entry) => ({ entry, id: entry.id.replace(/\.md$/, '') }))
		.filter(({ id }) => !id.startsWith('de/'))
		.map(({ entry, id }) => ({
			params: { slug: id },
			props: { entry },
		}));
}

const { entry } = Astro.props;

const canonical = canonicalUrl(Astro.url.pathname);
const schema = [
	projectNode({
		canonical,
		name: entry.data.title,
		description: entry.data.description,
		datePublished: entry.data.publishDate,
		url: entry.data.url,
		repo: entry.data.repo,
		stack: entry.data.stack,
		image: entry.data.img ? canonicalUrl(entry.data.img) : undefined,
		lang: 'en',
	}),
	breadcrumbNode(canonical, [
		{ name: 'Gnadlinger', item: canonicalUrl('/') },
		{ name: 'Projects', item: canonicalUrl('/work/') },
		{ name: entry.data.title },
	]),
];
---

<BaseLayout
	title={`${entry.data.title} | Gnadlinger`}
	description={entry.data.description}
	schema={schema}
	ogType="article"
	publishedTime={entry.data.publishDate}
>
	<ProjectDetail entry={entry} lang="en" />
</BaseLayout>
