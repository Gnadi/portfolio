---
import { getCollection } from 'astro:content';

import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectDetail from '../../components/ProjectDetail.astro';

export async function getStaticPaths() {
	// English entries live at the collection root; German ones under `de/`.
	const entries = await getCollection('work');
	return entries
		.map((entry) => ({ entry, id: entry.id.replace(/\.md$/, '') }))
		.filter(({ id }) => !id.startsWith('de/'))
		.map(({ entry, id }) => ({
			params: { slug: id },
			props: { entry },
		}));
}

const { entry } = Astro.props;
---

<BaseLayout
	title={`${entry.data.title} | Johannes Gnadlinger`}
	description={entry.data.description}
>
	<ProjectDetail entry={entry} lang="en" />
</BaseLayout>
