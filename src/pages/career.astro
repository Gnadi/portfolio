---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ContactCTA from '../components/ContactCTA.astro';
import CareerTimeline from '../components/CareerTimeline.astro';
import { careerUi } from '../data/career';
import {
	breadcrumbNode,
	canonicalUrl,
	careerListNode,
	collectionPageNode,
} from '../lib/schema';

const lang = 'en';
const canonical = canonicalUrl(Astro.url.pathname);

const schema = [
	collectionPageNode(canonical, careerUi.heroTitle[lang], careerUi.pageDescription[lang]),
	careerListNode(canonical, lang),
	breadcrumbNode(canonical, [
		{ name: 'Gnadlinger', item: canonicalUrl('/') },
		{ name: careerUi.breadcrumb[lang] },
	]),
];
---

<BaseLayout
	title={careerUi.pageTitle[lang]}
	description={careerUi.pageDescription[lang]}
	schema={schema}
>
	<div class="stack gap-20">
		<main class="wrapper stack gap-8">
			<Hero
				title={careerUi.heroTitle[lang]}
				tagline={careerUi.heroTagline[lang]}
				align="start"
			/>
			<CareerTimeline lang={lang} />
		</main>
		<ContactCTA />
	</div>
</BaseLayout>
