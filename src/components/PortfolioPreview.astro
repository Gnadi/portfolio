---
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import Pill from './Pill.astro';

interface Props {
	project: CollectionEntry<'work'>;
	headingLevel?: 2 | 3;
}

const { project, headingLevel = 3 } = Astro.props;
const { data } = project;
// German entries are stored under `de/` and are served from `/de/work/<slug>`.
const id = project.id.replace(/\.md$/, '');
const isDe = id.startsWith('de/');
const slug = id.replace(/^de\//, '');
const href = isDe ? `/de/work/${slug}` : `/work/${slug}/`;
const statusLabel = data.status === 'live'
	? 'Live'
	: data.status === 'preview'
		? (isDe ? 'Vorschau' : 'Preview')
		: null;
const HeadingTag = `h${headingLevel}` as 'h2' | 'h3';
---
<a class:list={['card', { preview: data.status === 'preview' }]} href={href}>
	<div class="header">
		<HeadingTag class="title">{data.title}</HeadingTag>
		<div class="meta">
			{statusLabel && <Pill>{statusLabel}</Pill>}
			<span class="external"><Icon icon="arrow-right" size="1.2em" /></span>
		</div>
	</div>
	<p class="description">{data.description}</p>
</a>
<style>
	/* Border-defined cards: the hover state moves the border to blue instead of
	   stacking up a bigger shadow. */
	.card {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		height: 100%;
		min-height: 9rem;
		padding: 1.25rem;
		background-color: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius-lg);
		text-decoration: none;
		color: var(--gray-200);
		font-family: var(--font-brand);
		transition:
			border-color var(--theme-transition),
			background-color var(--theme-transition);
	}

	.card:hover,
	.card:focus-visible {
		border-color: var(--accent-regular);
	}

	.card:hover .title,
	.card:focus-visible .title {
		color: var(--accent-regular);
	}

	.card:hover .external,
	.card:focus-visible .external {
		color: var(--accent-regular);
	}

	.header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
	}

	.title {
		margin: 0;
		font-size: var(--text-xl);
		font-weight: 600;
		color: var(--gray-0);
		transition: color var(--theme-transition);
	}

	.meta {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		flex-shrink: 0;
	}

	.external {
		display: inline-flex;
		color: var(--gray-400);
		transition: color var(--theme-transition);
	}

	.description {
		margin: 0;
		font-size: var(--text-sm);
		line-height: 1.5;
		color: var(--gray-300);
	}

	@media (min-width: 50em) {
		.card {
			min-height: 12rem;
			padding: 2rem;
			gap: 1.25rem;
		}

		.title {
			font-size: var(--text-2xl);
		}

		.description {
			font-size: var(--text-md);
		}
	}
</style>
