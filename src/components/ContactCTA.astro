---
import CallToAction from './CallToAction.astro';
import Icon from './Icon.astro';
import { Image } from 'astro:assets';
import {getLangFromUrl} from "../i18n/utils";
// Imported (not a public/ path) so Astro resizes it and serves WebP — the
// source JPEG is ~470 KB and this runs on every page.
import logo from '../assets/logo.jpg';
const isDe = getLangFromUrl(Astro.url) == "de";
const title = isDe ? "Starten wir das nächste Projekt gemeinsam?" : "Interested in working together?";
const message = isDe ? "Schreiben Sie mir" : "Send Me a Message";
const logoAlt = isDe ? "Logo von Johannes Gnadlinger" : "Johannes Gnadlinger’s logo";
---

<aside>
	<h2>{title}</h2>
	<Image
		alt={logoAlt}
		width={300}
		height={300}
		densities={[1, 2]}
		loading="lazy"
		src={logo}
	/>
	<CallToAction href="mailto:johannes.gnadlinger1997@gmail.com">
		{message}
		<Icon icon="paper-plane-tilt" size="1.2em" />
	</CallToAction>
</aside>

<style>
	img {
		border-radius: var(--radius-lg);
		border: 1px solid var(--border);
	}
	aside {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 3rem;
		border-top: 1px solid var(--border);
		border-bottom: 1px solid var(--border);
		padding: 5rem 1.5rem;
		background-color: var(--surface);
	}

	h2 {
		font-size: var(--text-xl);
		text-align: center;
		max-width: 15ch;
	}

	@media (min-width: 50em) {
		aside {
			padding: 7.5rem;
			flex-direction: row;
			flex-wrap: wrap;
			justify-content: space-between;
		}

		h2 {
			font-size: var(--text-3xl);
			text-align: left;
		}
	}
</style>
