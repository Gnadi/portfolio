---
import Icon from "./Icon.astro";
import ThemeToggle from "./ThemeToggle.astro";
import type { iconPaths } from "./IconPaths";
import Language from "./Language.astro";
import { getLangFromUrl } from "../i18n/utils";
import { FULL_NAME } from "../lib/schema";

const lang = getLangFromUrl(Astro.url);
/** Home link has to follow the current language — `/` would drop German
 *  visitors onto the English homepage. */
const homeHref = lang == "de" ? "/de/" : "/";

/** Main menu items */
const textLinks: { label: string; href: string }[] =
	lang == "de"
		? [
				{ label: "Home", href: "/de/" },
				{ label: "Projekte", href: "/de/work/" },
				{ label: "Karriere", href: "/de/career/" },
				{ label: "Über mich", href: "/de/about/" },
				{ label: "Lebenslauf", href: "https://cv.gnadlinger.me/" },
				{ label: "Blog", href: "https://blog.gnadlinger.me/" },
			]
		: [
				{ label: "Home", href: "/" },
				{ label: "Projects", href: "/work/" },
				{ label: "Career", href: "/career/" },
				{ label: "About", href: "/about/" },
				{ label: "CV", href: "https://cv.gnadlinger.me/" },
				{ label: "Blog", href: "https://blog.gnadlinger.me/" },
			];

/** Icon links to social media — edit these with links to your profiles! */
const iconLinks: {
	label: string;
	href: string;
	icon: keyof typeof iconPaths;
}[] = [
	{
		label: "Stackoverflow",
		href: "https://stackoverflow.com/users/6504152/johannes-gnadlinger",
		icon: "stackoverflow-logo",
	},
	{ label: "GitHub", href: "https://github.com/Gnadi", icon: "github-logo" },
	{
		label: "LinkedIn",
		href: "https://www.linkedin.com/in/johannes-gnadlinger-842293271",
		icon: "linkedin-logo",
	},
];
---

<nav>
	<div class="menu-header">
		<a href={homeHref} class="site-title">
			<Icon icon="home" color="var(--accent-regular)" size="3em" />
			{FULL_NAME}
		</a>
		<menu-button>
			<template>
				<button class="menu-button" aria-expanded="false">
					<span class="sr-only">Menu</span>
					<Icon icon="list" />
				</button>
			</template>
		</menu-button>
	</div>
	<noscript>
		<ul class="nav-items">
			{
				textLinks.map(({ label, href }) => (
					<li>
						<a
							aria-current={Astro.url.pathname === href}
							class:list={[
								"link",
								{
									active:
										Astro.url.pathname === href &&
										href !== "/" &&
										href != "de",
								},
							]}
							href={href}
						>
							{label}
						</a>
					</li>
				))
			}
		</ul>
	</noscript>
	<noscript>
		<div class="menu-footer">
			<div class="socials">
				{
					iconLinks.map(({ href, icon, label }) => (
						<a href={href} class="social">
							<span class="sr-only">{label}</span>
							<Icon icon={icon} />
						</a>
					))
				}
			</div>
		</div>
	</noscript>
	<div id="menu-content" hidden>
		<ul class="nav-items">
			{
				textLinks.map(({ label, href }) => (
					<li>
						<a
							aria-current={Astro.url.pathname === href}
							target={
								label === "CV" ||
								label === "Lebenslauf" ||
								label === "Blog"
									? "_blank"
									: "_parent"
							}
							class:list={[
								"link",
								{
									active:
										Astro.url.pathname === href ||
										(href !== "/" &&
											href !== "/de/" &&
											Astro.url.pathname.startsWith(
												href,
											)),
								},
							]}
							href={href}
						>
							<div class="pill">
								{label}{" "}
								{label === "CV" ||
								label === "Lebenslauf" ||
								label === "Blog" ? (
									<Icon icon="external" size="1.33em" />
								) : (
									""
								)}
							</div>
						</a>
					</li>
				))
			}
		</ul>
		<div class="menu-footer">
			<div class="socials">
				{
					iconLinks.map(({ href, icon, label }) => (
						<a href={href} class="social">
							<span class="sr-only">{label}</span>
							<Icon icon={icon} />
						</a>
					))
				}
			</div>

			{/* One group, so that on a narrow menu both controls wrap to the
			    next line together instead of one at a time. */}
			<div class="controls">
				<Language />
				<div class="theme-toggle">
					<ThemeToggle />
				</div>
			</div>
		</div>
	</div>
</nav>

<script>
	class MenuButton extends HTMLElement {
		constructor() {
			super();

			// Inject menu toggle button when JS runs.
			this.appendChild(
				this.querySelector("template")!.content.cloneNode(true),
			);
			const btn = this.querySelector("button")!;

			// Hide menu (shown by default to support no-JS browsers).
			const menu = document.getElementById("menu-content")!;
			menu.hidden = true;
			// Add "menu-content" class in JS to avoid covering content in non-JS browsers.
			menu.classList.add("menu-content");

			/** Set whether the menu is currently expanded or collapsed. */
			const setExpanded = (expand: boolean) => {
				btn.setAttribute("aria-expanded", expand ? "true" : "false");
				menu.hidden = !expand;
			};

			// Toggle menu visibility when the menu button is clicked.
			btn.addEventListener("click", () => setExpanded(menu.hidden));

			// Hide menu button for large screens.
			const handleViewports = (
				e: MediaQueryList | MediaQueryListEvent,
			) => {
				setExpanded(e.matches);
				btn.hidden = e.matches;
			};
			// Same breakpoint as the horizontal nav in the styles below: above
			// it the menu is always open and the button is gone.
			const mediaQueries = window.matchMedia("(min-width: 72em)");
			handleViewports(mediaQueries);
			mediaQueries.addEventListener("change", handleViewports);
		}
	}
	customElements.define("menu-button", MenuButton);
</script>

<style>
	.pill {
		display: flex;
		gap: 0.5rem;
		white-space: nowrap;
	}
	nav {
		z-index: 9999;
		position: relative;
		font-family: var(--font-brand);
		font-weight: 500;
		margin-bottom: 3.5rem;
	}

	.menu-header {
		display: flex;
		justify-content: space-between;
		gap: 0.5rem;
		padding: 1.5rem;
	}

	.site-title {
		display: flex;
		gap: 0.5rem;
		align-items: center;
		line-height: 1.1;
		color: var(--gray-0);
		text-decoration: none;
	}

	.menu-button {
		display: flex;
		border: 1px solid var(--border);
		border-radius: var(--radius-full);
		padding: 0.5rem;
		font-size: 1.5rem;
		color: var(--gray-300);
		background-color: var(--surface);
		transition:
			color var(--theme-transition),
			border-color var(--theme-transition);
	}

	.menu-button[aria-expanded='true'] {
		color: var(--accent-regular);
		border-color: var(--accent-regular);
	}

	.menu-button[hidden] {
		display: none;
	}

	.menu-content {
		position: absolute;
		left: 0;
		right: 0;
	}

	.nav-items {
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 1rem;
		font-size: var(--text-md);
		line-height: 1.2;
		list-style: none;
		padding: 2rem;
		background-color: var(--surface);
		border-bottom: 1px solid var(--border);
	}

	.link {
		display: inline-block;
		color: var(--gray-300);
		text-decoration: none;
		transition: color var(--theme-transition);
	}

	.link:hover,
	.link:focus-visible {
		color: var(--accent-regular);
	}

	.link.active {
		color: var(--gray-0);
	}

	.menu-footer {
		--icon-size: var(--text-xl);
		--icon-padding: 0.5rem;

		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		padding: 1.5rem 2rem 1.5rem 1.5rem;
		background-color: var(--surface);
		border-bottom: 1px solid var(--border);
		border-radius: 0 0 var(--radius-lg) var(--radius-lg);
	}

	.socials {
		display: flex;
		flex-wrap: wrap;
		gap: 0.625rem;
		font-size: var(--icon-size);
	}

	.social {
		display: flex;
		padding: var(--icon-padding);
		text-decoration: none;
		color: var(--gray-400);
		transition: color var(--theme-transition);
	}

	.social:hover,
	.social:focus {
		color: var(--accent-regular);
	}

	.controls {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: flex-end;
		gap: 0.75rem;
	}

	.theme-toggle {
		display: flex;
		align-items: center;
		height: calc(var(--icon-size) + 2 * var(--icon-padding));
	}

	/* The horizontal nav needs room for the site title, a pill of six links
	   and three controls side by side. Below this it does not get it — the
	   theme toggle used to be pushed off the right edge and clipped by the
	   root's `overflow-x: hidden` — so narrower viewports keep the menu
	   button, which handles them properly. The threshold is set by German,
	   where the same six labels run ~90px wider than in English.

	   The columns are `auto 1fr auto` rather than `1fr auto 1fr`: symmetric
	   side columns split the free space evenly, which starved the control
	   side while the title side sat on space it did not need. */
	@media (min-width: 72em) {
		nav {
			display: grid;
			grid-template-columns: auto 1fr auto;
			align-items: center;
			padding: 2.5rem;
			gap: 1rem;
		}

		.menu-header {
			padding: 0;
		}

		.site-title {
			font-size: var(--text-lg);
		}

		.menu-content {
			display: contents;
		}

		/* A single flat pill: one border, one surface colour, no stroke
		   gradient underneath it. */
		.nav-items {
			justify-self: center;
			flex-direction: row;
			font-size: var(--text-sm);
			border: 1px solid var(--border);
			border-radius: var(--radius-full);
			padding: 0.375rem;
			background-color: var(--surface);
		}

		.link {
			padding: 0.5rem 0.75rem;
			border-radius: var(--radius-full);
			transition:
				color var(--theme-transition),
				background-color var(--theme-transition);
		}

		.link:hover,
		.link:focus-visible {
			color: var(--accent-regular);
			background-color: var(--accent-subtle-overlay);
		}

		.link.active {
			color: var(--accent-text-over);
			background-color: var(--accent-regular);
		}

		.link.active:hover,
		.link.active:focus-visible {
			color: var(--accent-text-over);
			background-color: var(--accent-hover);
		}

		.menu-footer {
			--icon-padding: 0.375rem;

			flex-wrap: nowrap;
			justify-self: flex-end;
			padding: 0;
			background-color: transparent;
			border-bottom: 0;
		}

		.socials {
			display: none;
		}
	}

	@media (min-width: 90em) {
		.link {
			padding: 0.5rem 1rem;
		}
	}

	/* Last thing to come back, because it is the one part of the row that
	   has somewhere else to live — the menu on small screens, and the
	   contact section on the home page. The threshold is again set by
	   German, which needs the most width to seat the whole row. */
	@media (min-width: 80em) {
		.socials {
			display: flex;
			flex-wrap: nowrap;
			justify-content: flex-end;
			gap: 0;
		}
	}

	@media (min-width: 100em) {
		nav {
			padding: 2.5rem 5rem;
		}
	}

	@media (forced-colors: active) {
		.link.active {
			color: SelectedItem;
		}
	}
</style>
