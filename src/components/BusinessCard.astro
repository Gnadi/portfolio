---
import Icon from './Icon.astro';
import type { iconPaths } from './IconPaths';

const cardUrl = 'https://www.gnadlinger.me/card';
const qrSrc = `https://api.qrserver.com/v1/create-qr-code/?size=220x220&data=${encodeURIComponent(cardUrl)}&margin=8`;

/** Contact rows on the back of the card. `copy` is what lands on the clipboard;
 *  `label` is the shortened text shown on the card. */
const contacts: {
	icon: keyof typeof iconPaths;
	name: string;
	href: string;
	label: string;
	copy: string;
}[] = [
	{
		icon: 'paper-plane-tilt',
		name: 'email address',
		href: 'mailto:johannes.gnadlinger1997@gmail.com',
		label: 'johannes.gnadlinger1997@gmail.com',
		copy: 'johannes.gnadlinger1997@gmail.com',
	},
	{
		icon: 'github-logo',
		name: 'GitHub link',
		href: 'https://github.com/Gnadi',
		label: 'github.com/Gnadi',
		copy: 'https://github.com/Gnadi',
	},
	{
		icon: 'linkedin-logo',
		name: 'LinkedIn link',
		href: 'https://at.linkedin.com/in/johannes-gnadlinger-842293271',
		label: 'in/johannes-gnadlinger',
		copy: 'https://at.linkedin.com/in/johannes-gnadlinger-842293271',
	},
	{
		icon: 'stackoverflow-logo',
		name: 'Stack Overflow link',
		href: 'https://stackoverflow.com/users/6504152/johannes-gnadlinger',
		label: 'johannes-gnadlinger',
		copy: 'https://stackoverflow.com/users/6504152/johannes-gnadlinger',
	},
	{
		icon: 'external',
		name: 'CV link',
		href: 'https://cv.gnadlinger.me/',
		label: 'cv.gnadlinger.me',
		copy: 'https://cv.gnadlinger.me/',
	},
	{
		icon: 'pencil-line',
		name: 'blog link',
		href: 'https://blog.gnadlinger.me/',
		label: 'blog.gnadlinger.me',
		copy: 'https://blog.gnadlinger.me/',
	},
];
---

<div class="card-scene" tabindex="0" aria-label="Business card for Johannes Gnadlinger – hover or tap to flip">
	<div class="card">

		<!-- ═══ FRONT ═══════════════════════════════════════ -->
		<div class="card-face card-front">
			<!-- Layered background: photo + gradient veil -->
			<div class="front-bg-photo" aria-hidden="true"></div>
			<div class="front-bg-veil" aria-hidden="true"></div>

			<div class="front-body">
				<div class="front-text">
					<span class="card-name">Johannes Gnadlinger</span>
					<span class="card-title">Backend Engineer</span>
					<span class="card-company">Raiffeisen Software GmbH</span>
					<span class="card-location">📍 Linz, Austria</span>
				</div>
			</div>

			<div class="front-footer">
				<span class="flip-hint">Hover or tap to flip ↩</span>
			</div>
		</div>

		<!-- ═══ BACK ════════════════════════════════════════ -->
		<div class="card-face card-back">

			<!-- Header: round portrait + name -->
			<div class="back-header">
				<img
					src="/assets/portrait.webp"
					alt="Johannes Gnadlinger"
					class="back-portrait"
					width="80"
					height="80"
					loading="lazy"
				/>
				<div class="back-name-block">
					<span class="back-name">Johannes Gnadlinger</span>
					<span class="back-title">Backend Engineer · Raiffeisen Software GmbH</span>
				</div>
			</div>

			<!-- Main: contacts left / QR right -->
			<div class="back-main">
				<div class="contact-list">
					{
						contacts.map(({ icon, name, href, label, copy }) => (
							<div class="contact-row">
								<a
									href={href}
									class="contact-item"
									{...(href.startsWith('mailto:')
										? {}
										: { target: '_blank', rel: 'noopener noreferrer' })}
								>
									<Icon icon={icon} size="1em" />
									<span>{label}</span>
								</a>
								<button
									type="button"
									class="copy-btn"
									data-copy={copy}
									data-name={name}
									aria-label={`Copy ${name}`}
									title={`Copy ${name}`}
								>
									<span class="copy-icon"><Icon icon="copy" size="1em" /></span>
									<span class="check-icon"><Icon icon="check" size="1em" /></span>
								</button>
							</div>
						))
					}
				</div>

				<!-- QR code: its own clean panel -->
				<div class="qr-panel">
					<img
						src={qrSrc}
						alt={`QR code – ${cardUrl}`}
						class="qr-code"
						width="110"
						height="110"
						loading="lazy"
					/>
					<span class="qr-label">Scan to share</span>
					<span class="qr-url">gnadlinger.me/card</span>
				</div>
			</div>

			<!-- Footer -->
			<div class="back-footer">
				<span class="card-location-back">📍 Linz, Austria</span>
				<span class="copy-status" role="status" aria-live="polite"></span>
			</div>
		</div>

	</div>
</div>

<script>
	document.querySelectorAll<HTMLElement>('.card-scene').forEach((scene) => {
		const card   = scene.querySelector<HTMLElement>('.card');
		const front  = scene.querySelector<HTMLElement>('.card-front');
		const back   = scene.querySelector<HTMLElement>('.card-back');
		const status = scene.querySelector<HTMLElement>('.copy-status');
		if (!card) return;

		function flip() {
			scene.classList.toggle('is-flipped');
			const flipped = scene.classList.contains('is-flipped');
			front?.setAttribute('aria-hidden', String(flipped));
			back?.setAttribute('aria-hidden', String(!flipped));
		}

		/** Interactive elements handle their own clicks — flipping on top of that
		 *  would yank the card away mid-interaction. */
		const isInteractive = (target: EventTarget | null) =>
			target instanceof Element && !!target.closest('a, button');

		scene.addEventListener('click', (e) => {
			if (isInteractive(e.target)) return;
			flip();
		});
		scene.addEventListener('keydown', (e: KeyboardEvent) => {
			if (isInteractive(e.target)) return;
			if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); flip(); }
		});

		let resetTimer: ReturnType<typeof setTimeout>;

		async function copy(text: string) {
			try {
				await navigator.clipboard.writeText(text);
				return true;
			} catch {
				// Clipboard API needs a secure context; fall back to a scratch textarea.
				const scratch = document.createElement('textarea');
				scratch.value = text;
				scratch.setAttribute('readonly', '');
				scratch.style.position = 'fixed';
				scratch.style.opacity = '0';
				document.body.appendChild(scratch);
				scratch.select();
				let ok = false;
				try { ok = document.execCommand('copy'); } catch { ok = false; }
				document.body.removeChild(scratch);
				return ok;
			}
		}

		scene.querySelectorAll<HTMLButtonElement>('.copy-btn').forEach((btn) => {
			btn.addEventListener('click', async (e) => {
				e.preventDefault();
				e.stopPropagation();

				const text = btn.dataset.copy;
				const name = btn.dataset.name ?? 'Link';
				if (!text) return;

				const ok = await copy(text);

				scene.querySelectorAll('.copy-btn.is-copied').forEach((el) =>
					el.classList.remove('is-copied'),
				);
				if (ok) btn.classList.add('is-copied');
				if (status) status.textContent = ok ? `${name} copied` : `Could not copy ${name}`;

				clearTimeout(resetTimer);
				resetTimer = setTimeout(() => {
					btn.classList.remove('is-copied');
					if (status) status.textContent = '';
				}, 2000);
			});
		});
	});
</script>

<style>
	/* ── Scene ──────────────────────────────────────────── */
	.card-scene {
		perspective: 1200px;
		width: min(700px, 100%);
		height: 400px;
		cursor: pointer;
		outline: none;
	}

	/* ── Card (flipper) ─────────────────────────────────── */
	.card {
		position: relative;
		width: 100%;
		height: 100%;
		transform-style: preserve-3d;
		transition: transform 0.65s cubic-bezier(0.4, 0.2, 0.2, 1);
	}

	@media (hover: hover) {
		.card-scene:hover .card { transform: rotateY(180deg); }
	}
	.card-scene.is-flipped .card,
	.card-scene:focus-visible .card,
	/* Keep the card turned while a copy button or link on the back has focus —
	   otherwise tabbing to one flips it out of reach. */
	.card-scene:focus-within .card { transform: rotateY(180deg); }

	/* ── Shared face ────────────────────────────────────── */
	.card-face {
		position: absolute;
		inset: 0;
		backface-visibility: hidden;
		-webkit-backface-visibility: hidden;
		border-radius: 1.25rem;
		overflow: hidden;
		display: flex;
		flex-direction: column;
		box-shadow: var(--shadow-lg);
	}

	/* Only the face turned towards the viewer may take clicks.
	   `backface-visibility` hides the other face visually, but its children
	   still sit on top in hit-testing — without this the links and copy
	   buttons on the back are unreachable, because `.front-body` swallows
	   every click. Mirrors the flip triggers above. */
	.card-back { pointer-events: none; }

	@media (hover: hover) {
		.card-scene:hover .card-front { pointer-events: none; }
		.card-scene:hover .card-back { pointer-events: auto; }
	}

	.card-scene.is-flipped .card-front,
	.card-scene:focus-visible .card-front,
	.card-scene:focus-within .card-front { pointer-events: none; }

	.card-scene.is-flipped .card-back,
	.card-scene:focus-visible .card-back,
	.card-scene:focus-within .card-back { pointer-events: auto; }

	/* ══════════════════════ FRONT ══════════════════════════ */
	.card-front {
		justify-content: space-between;
		color: #fff;
	}

	/* Photo background */
	.front-bg-photo {
		position: absolute;
		inset: 0;
		background-image: url('/assets/about.jpg');
		background-size: cover;
		background-position: center 15%;
		z-index: 0;
	}

	/* Purple gradient veil over the photo */
	.front-bg-veil {
		position: absolute;
		inset: 0;
		background: linear-gradient(
			125deg,
			rgba(28, 0, 86, 0.82) 0%,
			rgba(118, 17, 166, 0.58) 55%,
			rgba(28, 0, 86, 0.72) 100%
		);
		z-index: 1;
	}

	.front-body {
		position: relative;
		z-index: 2;
		flex: 1;
		display: flex;
		align-items: flex-end;
		padding: 2.25rem 2.5rem;
	}

	.front-text {
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
	}

	.card-name {
		font-family: var(--font-brand);
		font-size: var(--text-2xl);
		font-weight: 700;
		line-height: 1.15;
		color: #fff;
		text-shadow: 0 1px 8px rgba(0,0,0,0.4);
	}

	.card-title {
		font-size: var(--text-lg);
		font-weight: 500;
		color: rgba(255, 255, 255, 0.92);
	}

	.card-company {
		font-size: var(--text-base);
		color: rgba(255, 255, 255, 0.72);
	}

	.card-location {
		margin-top: 0.4rem;
		font-size: var(--text-base);
		color: rgba(255, 255, 255, 0.65);
	}

	.front-footer {
		position: relative;
		z-index: 2;
		padding: 0.65rem 2.5rem;
		background: rgba(0, 0, 0, 0.25);
		display: flex;
		justify-content: flex-end;
	}

	.flip-hint {
		font-size: var(--text-sm);
		color: rgba(255, 255, 255, 0.52);
		letter-spacing: 0.02em;
	}

	/* ══════════════════════ BACK ═══════════════════════════ */
	.card-back {
		transform: rotateY(180deg);
		background: var(--gray-999);
		border: 1px solid var(--gray-800);
		color: var(--gray-0);
		padding: 1.75rem 2rem;
		gap: 1rem;
	}

	/* Header */
	.back-header {
		display: flex;
		align-items: center;
		gap: 1rem;
		padding-bottom: 1rem;
		border-bottom: 1px solid var(--gray-800);
		flex-shrink: 0;
	}

	.back-portrait {
		flex-shrink: 0;
		width: 3.25rem;
		height: 3.25rem;
		border-radius: 50%;
		object-fit: cover;
		object-position: center top;
		border: 2px solid var(--gray-800);
	}

	.back-name-block {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
		min-width: 0;
	}

	.back-name {
		font-family: var(--font-brand);
		font-size: var(--text-lg);
		font-weight: 700;
		color: var(--gray-0);
	}

	.back-title {
		font-size: var(--text-sm);
		color: var(--gray-400);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	/* Main area: contacts + QR panel */
	.back-main {
		flex: 1;
		display: flex;
		gap: 0;
		min-height: 0;
		align-items: stretch;
	}

	/* Contact list */
	.contact-list {
		flex: 1;
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: 0.5rem;
		min-width: 0;
		padding-right: 1.25rem;
	}

	.contact-row {
		display: flex;
		align-items: center;
		gap: 0.35rem;
		min-width: 0;
	}

	.contact-item {
		flex: 1;
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-size: var(--text-base);
		color: var(--gray-200);
		text-decoration: none;
		transition: color var(--theme-transition);
		white-space: nowrap;
		overflow: hidden;
		min-width: 0;
	}

	/* ── Copy buttons ───────────────────────────────────── */
	.copy-btn {
		flex-shrink: 0;
		display: grid;
		place-items: center;
		width: 1.75rem;
		height: 1.75rem;
		padding: 0;
		border: 1px solid transparent;
		border-radius: 0.4rem;
		background: transparent;
		color: var(--gray-400);
		cursor: pointer;
		/* Always present so the affordance is discoverable — the card is already
		   behind a flip, hiding the buttons behind a second hover would bury
		   them. Dimmed so they stay secondary to the links themselves. */
		opacity: 0.55;
		transition:
			opacity var(--theme-transition),
			color var(--theme-transition),
			background-color var(--theme-transition),
			border-color var(--theme-transition);
	}

	.contact-row:hover .copy-btn,
	.copy-btn:focus-visible,
	.copy-btn.is-copied {
		opacity: 1;
	}

	.copy-btn:hover {
		color: var(--accent-regular);
		background-color: var(--accent-subtle-overlay);
		border-color: var(--gray-800);
	}

	.copy-btn:focus-visible {
		outline: 2px solid var(--accent-regular);
		outline-offset: 1px;
	}

	.copy-btn .check-icon { display: none; }
	.copy-btn.is-copied {
		color: var(--accent-regular);
		border-color: var(--accent-regular);
	}
	.copy-btn.is-copied .copy-icon { display: none; }
	.copy-btn.is-copied .check-icon { display: block; }

	.copy-status {
		font-size: var(--text-sm);
		color: var(--accent-regular);
	}

	.contact-item span {
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.contact-item:hover { color: var(--accent-regular); }

	.contact-item :global(svg) {
		flex-shrink: 0;
		color: var(--accent-regular);
	}

	/* QR panel: its own column with left border */
	.qr-panel {
		flex-shrink: 0;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 0.4rem;
		padding-left: 1.25rem;
		border-left: 1px solid var(--gray-800);
	}

	.qr-code {
		display: block;
		width: 110px;
		height: 110px;
		border-radius: 0.6rem;
		/* white container so QR is always scannable regardless of theme */
		background: #fff;
		padding: 6px;
	}

	.qr-label {
		font-size: var(--text-sm);
		font-weight: 600;
		color: var(--gray-200);
	}

	.qr-url {
		font-size: 0.75rem;
		color: var(--gray-500);
		letter-spacing: 0.01em;
	}

	/* Footer */
	.back-footer {
		flex-shrink: 0;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding-top: 0.75rem;
		border-top: 1px solid var(--gray-800);
	}

	.card-location-back {
		font-size: var(--text-base);
		color: var(--gray-400);
	}

	/* ── Mobile ─────────────────────────────────────────── */
	@media (max-width: 36em) {
		.card-scene { height: 340px; }

		.front-body { padding: 1.5rem 1.5rem; }

		.card-name  { font-size: var(--text-xl); }
		.card-title { font-size: var(--text-base); }
		.card-company, .card-location { font-size: var(--text-sm); }

		.front-footer { padding: 0.6rem 1.5rem; }

		.card-back { padding: 1.25rem 1.25rem; }

		.back-portrait { width: 2.5rem; height: 2.5rem; }

		.contact-item { font-size: var(--text-sm); }

		.copy-btn { width: 1.5rem; height: 1.5rem; }
		.copy-status { font-size: 0.7rem; }

		.qr-code { width: 80px; height: 80px; }
		.qr-label { font-size: 0.7rem; }
		.qr-url   { font-size: 0.65rem; }
	}
</style>
