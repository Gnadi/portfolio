---
import { getLangFromUrl } from '../i18n/utils';
import TennisGame from './TennisGame.astro';
import { BLOG_URL, CV_URL, FULL_NAME } from '../lib/schema';

const currentYear = new Date().getFullYear();
const lang = getLangFromUrl(Astro.url);
const isDe = lang === 'de';

/** Links out to the sibling hosts. These run on every page so the three
 *  gnadlinger.me hosts stay mutually reachable. */
const siteLinks: { label: string; href: string }[] = [
	{ label: 'Portfolio', href: isDe ? '/de/' : '/' },
	{ label: isDe ? 'Lebenslauf' : 'CV', href: CV_URL },
	{ label: 'Blog', href: BLOG_URL },
];
---

<footer>
	<div class="group">
		<p>
			Designed & Developed with <a href="https://astro.build/">Astro</a>
		</p>
		<p>&copy; {currentYear} {FULL_NAME}</p>
	</div>
	<nav class="site-links" aria-label={isDe ? 'Weitere Seiten' : 'More pages'}>
		{siteLinks.map(({ label, href }) => <a href={href}>{label}</a>)}
	</nav>

	<div class="play">
		<TennisGame />
	</div>
</footer>
<style>
	footer {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 2rem;
		margin-top: auto;
		padding: 3rem 2rem 3rem;
		text-align: center;
		color: var(--gray-400);
		font-size: var(--text-sm);
	}

	.site-links {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.5rem 1.25rem;
	}

	footer a {
		color: var(--gray-400);
		text-decoration: 1px solid underline transparent;
		text-underline-offset: 0.25em;
		transition: text-decoration-color var(--theme-transition);
	}

	footer a:hover,
	footer a:focus {
		text-decoration-color: currentColor;
	}

	.group {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		/* On narrow screens the credits sit right at the bottom of the page,
		   below the site links and the tennis button. */
		order: 1;
	}

	.play {
		display: flex;
		justify-content: center;
	}

	.socials {
		display: flex;
		justify-content: center;
		gap: 1rem;
		flex-wrap: wrap;
	}

	@media (min-width: 50em) {
		footer {
			flex-direction: row;
			align-items: center;
			justify-content: space-between;
			gap: 1.5rem;
			padding: 2.5rem 5rem;
		}

		.group {
			flex-direction: row;
			gap: 1rem;
			flex-wrap: wrap;
			order: 0;
		}

		/* The credits and the button take equal shares of what is left, so
		   the site links land in the middle of the footer rather than
		   wherever space-between happens to leave them. */
		.group,
		.play {
			flex: 1 1 0;
			min-width: 0;
		}

		.play {
			justify-content: flex-end;
		}

		.site-links {
			flex: 0 1 auto;
		}

		.socials {
			justify-content: flex-end;
		}
	}
</style>
