---
/**
 * The career timeline. Shared by `/career/` and `/de/career/`, which differ
 * only in the language they resolve the entries for.
 */
import Icon from './Icon.astro';
import {
	careerUi,
	sortedCareer,
	translate,
	typeIcons,
	typeKinds,
	typeLabels,
	typeOrder,
	yearLabel,
	type CareerEntry,
	type CareerType,
	type SiteLang,
} from '../data/career';

interface Props {
	lang: SiteLang;
}

const { lang } = Astro.props;

const entries = sortedCareer();
const presentTypes = typeOrder.filter((type) =>
	entries.some((entry) => entry.type === type)
);

const year = (value: string) => yearLabel(value, lang);

/* A linked title, split before its last word: that word and the link button
   are kept on one line, so the button never wraps away on its own. */
const splitTitle = (entry: CareerEntry) => {
	const title = translate(entry.title, lang);
	const cut = title.lastIndexOf(' ') + 1;
	return { lead: title.slice(0, cut), last: title.slice(cut) };
};

/* Projects and hackathons name the role held, not an organisation, so that
   line gets a label to keep "Developer" from reading as an employer. */
const organizationIsRole = (entry: CareerEntry) =>
	typeKinds[entry.type] === 'project' || entry.type === 'hackathon';
---

<div class="filters">
	<label for="career-filter" class="filter-label">{careerUi.filterLabel[lang]}</label>
	<div class="select-wrapper">
		<select id="career-filter" class="filter-select">
			<option value="all">{careerUi.filterAll[lang]}</option>
			{
				presentTypes.map((type: CareerType) => (
					<option value={type}>{typeLabels[type][lang]}</option>
				))
			}
		</select>
	</div>
</div>

<div class="timeline">
	{
		entries.map((entry) => (
			<div class="timeline-item" data-type={entry.type} data-kind={typeKinds[entry.type]}>
				<div class="timeline-marker">
					<div class="icon-wrapper">
						<Icon icon={typeIcons[entry.type] as any} size="1.2em" />
					</div>
				</div>
				<div class="timeline-content card">
					<div class="header">
						<span class="type-badge">{typeLabels[entry.type][lang]}</span>
						<span class="date">
							{year(entry.startDate)} - {year(entry.endDate)}
						</span>
					</div>
					<h2>
						{entry.url ? (
							<a class="title-link" href={entry.url} target="_blank" rel="noopener noreferrer">
								{splitTitle(entry).lead}
								<span class="title-tail">
									{splitTitle(entry).last}
									<span class="link-button">
										<Icon icon="external" size="1.1rem" />
									</span>
								</span>
							</a>
						) : (
							translate(entry.title, lang)
						)}
					</h2>
					{
						entry.phases ? (
							/* One employer, several roles: the phases sit inside the one
							   card so the timeline cannot be read as a change of employer. */
							<ol class="phases">
								{entry.phases.map((phase) => (
									<li class="phase">
										<div class="phase-header">
											<h3>{translate(phase.title, lang)}</h3>
											<span class="phase-date">
												{year(phase.startDate)} - {year(phase.endDate)}
											</span>
										</div>
										<p>{translate(phase.description, lang)}</p>
									</li>
								))}
							</ol>
						) : (
							<Fragment>
								<p class="organization">
									{organizationIsRole(entry) && (
										<span class="organization-label">{careerUi.role[lang]}:</span>
									)}
									{translate(entry.organization, lang)}
								</p>
								{entry.description && <p>{translate(entry.description, lang)}</p>}
							</Fragment>
						)
					}
				</div>
			</div>
		))
	}
</div>

<script>
	const select = document.querySelector<HTMLSelectElement>('.filter-select');
	const items = document.querySelectorAll<HTMLElement>('.timeline-item');

	select?.addEventListener('change', () => {
		const filter = select.value;
		items.forEach((item) => {
			const show = filter === 'all' || item.dataset.type === filter;
			item.style.display = show ? '' : 'none';
		});
	});
</script>

<style>
	.filters {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}

	.filter-label {
		font-size: var(--text-sm);
		font-weight: 600;
		color: var(--gray-300);
	}

	.select-wrapper {
		position: relative;
		display: inline-flex;
	}

	.filter-select {
		font: inherit;
		cursor: pointer;
		appearance: none;
		padding: 0.5rem 2.5rem 0.5rem 1rem;
		border-radius: var(--radius-full);
		border: 1px solid var(--border);
		background-color: var(--surface);
		color: var(--gray-0);
		font-size: var(--text-sm);
		font-weight: 600;
		transition: border-color var(--theme-transition);
	}

	.filter-select:hover,
	.filter-select:focus-visible {
		border-color: var(--accent-regular);
	}

	.select-wrapper::after {
		content: '';
		position: absolute;
		right: 1rem;
		top: 50%;
		width: 0.5rem;
		height: 0.5rem;
		border-right: 2px solid var(--gray-400);
		border-bottom: 2px solid var(--gray-400);
		transform: translateY(-70%) rotate(45deg);
		pointer-events: none;
	}

	/* ── Kinds ─────────────────────────────────────────────────────
	   Each kind carries its own colour, so employment, projects and events
	   stay apart at a glance. `--kind-color` draws lines, icons and the
	   card stripe; `--kind-fill` sits under white text on the badge and the
	   employment marker, so it stays dark enough in both themes. Employment
	   follows the tournament accent; the others keep fixed hues. */
	[data-kind='job'] {
		--kind-color: var(--accent-regular);
		--kind-fill: var(--accent-regular);
	}

	[data-kind='project'] {
		--kind-color: #0f766e;
		--kind-fill: #0f766e;
	}

	[data-kind='event'] {
		--kind-color: #a15c07;
		--kind-fill: #a15c07;
	}

	[data-kind='leave'] {
		--kind-color: #be185d;
		--kind-fill: #be185d;
	}

	:global(.theme-dark) [data-kind='project'] {
		--kind-color: #2dd4bf;
	}

	:global(.theme-dark) [data-kind='event'] {
		--kind-color: #fbbf24;
	}

	:global(.theme-dark) [data-kind='leave'] {
		--kind-color: #f472b6;
	}

	/* ── Timeline ──────────────────────────────────────────────── */

	.timeline {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 2rem;
		padding-left: 2rem;
		border-left: 2px solid var(--border);
	}

	.timeline-item {
		position: relative;
	}

	.timeline-marker {
		position: absolute;
		left: -2rem; /* Adjust based on padding-left of timeline */
		top: 0;
		transform: translateX(-50%);
		width: 3rem;
		height: 3rem;
		display: flex;
		align-items: center;
		justify-content: center;
		background-color: var(--surface);
		border: 2px solid var(--kind-color);
		border-radius: 50%;
		z-index: 1;
	}

	.icon-wrapper {
		display: flex;
		color: var(--kind-color);
	}

	/* Employment is what everything else hangs off: a solid marker. */
	[data-kind='job'] .timeline-marker {
		background-color: var(--kind-fill);
		border-color: var(--kind-fill);
	}

	[data-kind='job'] .icon-wrapper {
		color: var(--accent-text-over);
	}

	/* Events are one-off moments: a diamond rather than a disc. The icon is
	   turned back so it stays upright. */
	[data-kind='event'] .timeline-marker {
		width: 2.5rem;
		height: 2.5rem;
		border-radius: var(--radius-sm);
		transform: translateX(-50%) rotate(45deg);
	}

	[data-kind='event'] .icon-wrapper {
		transform: rotate(-45deg);
	}

	/* Leave is time away, not work: a dashed outline. */
	[data-kind='leave'] .timeline-marker {
		border-style: dashed;
	}

	.timeline-content {
		margin-left: 1.5rem;
	}

	.card {
		border: 1px solid var(--border);
		border-left: 4px solid var(--kind-color);
		border-radius: var(--radius-lg);
		padding: 1.5rem;
		background-color: var(--surface);
		transition: border-color var(--theme-transition);
	}

	.card:hover {
		border-color: var(--kind-color);
	}

	/* The employment card carries a tint of its colour, so it reads as the
	   frame the projects around it sit in. */
	[data-kind='job'] .card {
		background-color: color-mix(in srgb, var(--kind-color) 7%, var(--surface));
	}

	[data-kind='leave'] .card {
		border-style: dashed;
		border-left-style: solid;
	}

	.header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 0.5rem;
		font-size: var(--text-sm);
	}

	/* Flat badge in the kind's colour, no shadow, no gradient. */
	.type-badge {
		background-color: var(--kind-fill);
		color: #ffffff;
		padding: 0.2rem 0.6rem;
		border-radius: var(--radius-full);
		font-weight: 600;
		font-size: 0.8em;
		letter-spacing: 0.03em;
		text-transform: uppercase;
	}

	.date {
		color: var(--gray-400);
	}

	.card h2 {
		font-size: var(--text-xl);
		color: var(--gray-0);
		margin-bottom: 0.25rem;
	}

	.title-link {
		color: inherit;
		text-decoration: none;
	}

	.title-link:hover,
	.title-link:focus-visible {
		color: var(--kind-color);
	}

	.title-tail {
		white-space: nowrap;
	}

	/* Sized as a button rather than a glyph, so it is easy to spot and to
	   hit on a phone — the whole title stays the link either way. */
	.link-button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.25rem;
		height: 2.25rem;
		margin-left: 0.5rem;
		vertical-align: middle;
		border: 1px solid var(--kind-color);
		border-radius: 50%;
		color: var(--kind-color);
		background-color: color-mix(in srgb, var(--kind-color) 10%, var(--surface));
		transition: background-color var(--theme-transition), color var(--theme-transition);
	}

	.title-link:hover .link-button,
	.title-link:focus-visible .link-button {
		background-color: var(--kind-fill);
		border-color: var(--kind-fill);
		color: #ffffff;
	}

	.organization {
		font-weight: 600;
		color: var(--kind-color);
		margin-bottom: 0.5rem;
	}

	.organization-label {
		font-weight: 400;
		color: var(--gray-400);
		margin-right: 0.3em;
	}

	[data-kind='job'] .card h2 {
		font-size: var(--text-2xl);
	}

	/* ── Phases within one entry ───────────────────────────────── */

	.phases {
		list-style: none;
		margin: 0.75rem 0 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}

	/* A rule between phases, not around each one: they belong to the same
	   card, and boxing them would undo that. */
	.phase + .phase {
		padding-top: 1.25rem;
		border-top: 1px solid var(--border);
	}

	.phase-header {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.25rem 1rem;
		margin-bottom: 0.35rem;
	}

	.phase h3 {
		font-size: var(--text-md);
		font-weight: 600;
		color: var(--kind-color);
	}

	.phase-date {
		font-size: var(--text-sm);
		color: var(--gray-400);
	}
</style>
