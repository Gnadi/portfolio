---
/**
 * The three areas of expertise on the home page. Was two components — one per
 * language — whose markup and styles were byte-identical; only the copy
 * differed, so the copy is now the only thing that varies.
 */
import Icon from './Icon.astro';
import type { SiteLang } from '../data/career';

interface Props {
	lang: SiteLang;
}

const { lang } = Astro.props;

const areas = [
	{
		icon: 'bank',
		title: 'Corporate Payment Systems',
		body: {
			en: 'Backend services for payment flows, SEPA transactions, and ledger consistency in regulated, transaction-heavy systems.',
			de: 'Backend-Services für Zahlungsflüsse, SEPA-Transaktionen und Ledger-Konsistenz in regulierten, transaktionsintensiven Systemen.',
		},
	},
	{
		icon: 'terminal-window',
		title: 'Private Banking Systems',
		body: {
			en: 'End-to-end applications, frontend and backend, for customer-facing banking services.',
			de: 'End-to-End-Anwendungen, Frontend und Backend, für kundennahe Bankdienste.',
		},
	},
	{
		icon: 'strategy',
		title: 'Engineering Thinking',
		body: {
			en: 'Designing services that behave predictably under failure, load, and retries. Correctness and operational reliability before features.',
			de: 'Services entwerfen, die sich unter Last, Fehlern und Retries vorhersagbar verhalten. Korrektheit und Betriebsstabilität vor Features.',
		},
	},
] as const;
---

<section class="box skills">
	{
		areas.map((area) => (
			<div class="stack gap-2 lg:gap-4">
				<Icon icon={area.icon as any} color="var(--accent-regular)" size="2.5rem" />
				<h3>{area.title}</h3>
				<p>{area.body[lang]}</p>
			</div>
		))
	}
</section>

<style>
	/* Three flat panels on the page surface: hairline border, white (or navy)
	   fill, no shadow stack. */
	.box {
		border: 1px solid var(--border);
		border-radius: var(--radius-lg);
		padding: 1.5rem;
		background-color: var(--surface);
	}

	.skills {
		display: flex;
		flex-direction: column;
		gap: 3rem;
	}

	.skills h3 {
		font-size: var(--text-lg);
	}

	.skills p {
		color: var(--gray-300);
	}

	@media (min-width: 50em) {
		.box {
			padding: 2.5rem;
		}

		.skills {
			display: grid;
			grid-template-columns: repeat(3, 1fr);
			gap: 3.5rem;
		}

		.skills h3 {
			font-size: var(--text-xl);
		}
	}
</style>
