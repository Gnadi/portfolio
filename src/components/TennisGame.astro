---
/**
 * A match against the machine, played in whichever Grand Slam's stadium the
 * site is currently wearing (src/lib/slam.ts). Pong rules, tie-break scoring
 * — first to seven, and 6–6 is the deciding point — and the tournament's own
 * scoreboard over the court.
 *
 * Each major gets its venue: the bowl's shape, the seats, the surface and the
 * board all change with `data-slam`. Colours come from the palette tokens in
 * src/styles/global.css; the structure comes from VENUES in the script below.
 *
 * The button lives in the footer; the game is a modal dialog, so the canvas
 * and its loop exist once per page and only run while it is open.
 */
import { getLangFromUrl } from '../i18n/utils';
import { FULL_NAME, SITE_ORIGIN } from '../lib/schema';
import { slams } from '../lib/slam';

const lang = getLangFromUrl(Astro.url);

/** Scoreboards show surnames, so this one does too. */
const surname = FULL_NAME.split(' ').pop() ?? 'Player';

const copy = {
	en: {
		play: 'Play a point',
		title: 'Tennis',
		close: 'Close',
		/* The visitor plays; the other end of the court is this site's owner. */
		opponent: surname,
		you: 'You',
		yourName: 'Your name',
		entry: 'Who is playing ' + surname + '?',
		start: 'Play',
		change: 'Change name',
		serve: 'Space or tap to serve',
		hint: 'Mouse, finger or ↑ ↓ to move · first to seven, 6–6 is the deciding point',
		hintUpright: 'Slide to move · first to seven, 6–6 is the deciding point',
		tiebreak: 'Tie-break',
		win: 'Game, set and match, %s.',
		again: 'Tap or press space for a new match',
		decider: 'Deciding point',
		/* The winner's card, and what to do with it. */
		champion: 'Champion',
		versus: 'vs. %o %s',
		saveImage: 'Save image',
		share: 'Share',
		sendLinkedIn: 'Send it to ' + surname,
		playAgain: 'Play again',
		copied: 'Result copied — paste it into your message on LinkedIn.',
		copiedText: 'Result copied to the clipboard.',
		shareText: 'I beat ' + FULL_NAME + ' %s at tennis on ' + SITE_ORIGIN.replace('https://', ''),
		cardAlt: '%p vs. %o %s at tennis on ' + SITE_ORIGIN.replace('https://', ''),
	},
	de: {
		play: 'Einen Punkt spielen',
		title: 'Tennis',
		close: 'Schließen',
		opponent: surname,
		you: 'Du',
		yourName: 'Dein Name',
		entry: 'Wer spielt gegen ' + surname + '?',
		start: 'Spielen',
		change: 'Namen ändern',
		serve: 'Leertaste oder tippen zum Aufschlag',
		hint: 'Maus, Finger oder ↑ ↓ zum Bewegen · wer sieben holt, 6:6 ist der Entscheidungspunkt',
		hintUpright: 'Zum Bewegen wischen · wer sieben holt, 6:6 ist der Entscheidungspunkt',
		tiebreak: 'Tie-Break',
		win: 'Spiel, Satz und Sieg, %s.',
		again: 'Tippen oder Leertaste für ein neues Match',
		decider: 'Entscheidungspunkt',
		champion: 'Sieger',
		versus: 'vs. %o %s',
		saveImage: 'Bild speichern',
		share: 'Teilen',
		sendLinkedIn: 'An ' + surname + ' schicken',
		playAgain: 'Nochmal spielen',
		copied: 'Ergebnis kopiert — füge es in deine Nachricht auf LinkedIn ein.',
		copiedText: 'Ergebnis in die Zwischenablage kopiert.',
		shareText: 'Ich habe ' + FULL_NAME + ' %s im Tennis geschlagen — auf ' + SITE_ORIGIN.replace('https://', ''),
		cardAlt: '%p vs. %o %s im Tennis auf ' + SITE_ORIGIN.replace('https://', ''),
	},
}[lang];

/** Tournament names for the board, keyed by the `data-slam` attribute. */
const names = Object.fromEntries(slams.map((slam) => [slam.id, slam.name]));

/** Where a winner is sent to gloat. Same profile the nav and the card link to. */
const LINKEDIN = 'https://www.linkedin.com/in/johannes-gnadlinger-842293271';
---

<tennis-game
	class="tennis"
	data-names={JSON.stringify(names)}
	data-serve={copy.serve}
	data-again={copy.again}
	data-decider={copy.decider}
	data-tiebreak={copy.tiebreak}
	data-win={copy.win}
	data-hint={copy.hint}
	data-hint-upright={copy.hintUpright}
	data-you={copy.you}
	data-champion={copy.champion}
	data-versus={copy.versus}
	data-share-text={copy.shareText}
	data-card-alt={copy.cardAlt}
	data-copied={copy.copied}
	data-copied-text={copy.copiedText}
	data-opponent={copy.opponent}
	data-lang={lang}
	data-host={SITE_ORIGIN.replace('https://', '')}
>
	<button type="button" class="open">
		<svg class="ball" viewBox="0 0 24 24" aria-hidden="true">
			<circle cx="12" cy="12" r="9"></circle>
			<path d="M4.2 6.2A9 9 0 0 1 9.6 20.5"></path>
			<path d="M19.8 6.2A9 9 0 0 0 14.4 20.5"></path>
		</svg>
		{copy.play}
	</button>

	<dialog class="stage" aria-label={copy.title}>
		<div class="frame">
			<!-- The tournament's own board: name, server, points. -->
			<div class="board" data-board>
				<div class="brand">
					<span class="tournament" data-tournament>US Open</span>
					<span class="venue" data-venue></span>
					<span class="format" data-format-label>{copy.tiebreak}</span>
				</div>
				<div class="rows">
					<div class="row">
						<span class="serving" data-serving-player aria-hidden="true"></span>
						<button type="button" class="name editable" data-rename title={copy.change}>
							<span data-player-name>{copy.you}</span>
						</button>
						<span class="points" data-player-point>0</span>
					</div>
					<div class="row">
						<span class="serving" data-serving-cpu aria-hidden="true"></span>
						<span class="name">{copy.opponent}</span>
						<span class="points" data-cpu-point>0</span>
					</div>
				</div>

				<button type="button" class="close" aria-label={copy.close}>&times;</button>
			</div>

			<div class="court">
				<canvas width="960" height="620"></canvas>
				<p class="overlay" data-overlay>{copy.serve}</p>

				<!-- The winner's card: a result worth keeping, and the ways out
				     of the page it can leave by. -->
				<div class="result" data-result hidden>
					<img class="result-card" data-result-image alt="" />
					<div class="result-actions">
						<button type="button" class="act primary" data-save>{copy.saveImage}</button>
						<button type="button" class="act" data-share hidden>{copy.share}</button>
						<a
							class="act"
							data-linkedin
							href={LINKEDIN}
							target="_blank"
							rel="noopener noreferrer">{copy.sendLinkedIn}</a>
						<button type="button" class="act ghost" data-play-again>{copy.playAgain}</button>
					</div>
					<p class="result-note" data-result-note role="status" aria-live="polite"></p>
				</div>

				<!-- The card for the match: who is on the other side of the net. -->
				<form class="entry" data-entry hidden>
					<label class="entry-label" for="tennis-player-name">{copy.entry}</label>
					<div class="entry-row">
						<input
							id="tennis-player-name"
							class="entry-input"
							data-name-input
							type="text"
							maxlength="14"
							autocomplete="off"
							spellcheck="false"
							placeholder={copy.you}
							aria-label={copy.yourName}
						/>
						<button type="submit" class="entry-go">{copy.start}</button>
					</div>
				</form>
			</div>

			<p class="hint" data-hint-label>{copy.hint}</p>
		</div>
	</dialog>
</tennis-game>

<script>
	/** Canvas units. The stands fill the frame; the court sits inside them. */
	const W = 960;
	const H = 620;
	const COURT_W = 660;
	const COURT_H = Math.round(COURT_W / 2.1667); // 23.77m × 10.97m
	const COURT_X = Math.round((W - COURT_W) / 2);
	const COURT_Y = Math.round((H - COURT_H) / 2);
	const APRON_X = 86; // run-off between the court and the front row
	const APRON_Y = 62;
	const ALLEY = COURT_H * 0.125;
	const SERVICE = COURT_W * 0.269;
	const NET_X = COURT_X + COURT_W / 2;
	const MID_Y = COURT_Y + COURT_H / 2;
	/** Centre mark to singles sideline: the half a server has to stand in. */
	const SERVE_HALF = COURT_H / 2 - ALLEY;

	const PADDLE_W = 11;
	const PADDLE_H = 84;
	const PADDLE_INSET = 20;
	const BALL_R = 8;

	const BASE_SPEED = 430; // px per second
	const MAX_SPEED = 1000;
	const PLAYER_SPEED = 640;

	/** A serve is the fastest ball in tennis, and this one is no exception. */
	const SERVE_SPEED = BASE_SPEED * 1.2;
	/** How far into the service box it comes down, and how clear of the lines. */
	const SERVE_CARRY = 0.62;
	const SERVE_INSET = 0.12;

	/** One tie-break, and at 6–6 the next point is the match. */
	const TARGET = 7;

	/**
	 * The machine's form, and the easter egg inside the easter egg: it only
	 * ever gets worse.
	 *
	 * `speed` is how fast the racket travels. `lag` is how far behind the ball
	 * it reads the line, and it is the rung that decides matches: a racket a
	 * fifth of a second late is most of a paddle out of position on a fast
	 * ball, while one reading live cannot be passed at all. `miss` is how many
	 * pixels off that line it sets up, weighted by how awkward the shot is, so
	 * the ones it gets wrong are the ones worth hitting.
	 *
	 * The first match is played off the top rung and is meant to be lost —
	 * three or four points is a good return off it. Every match lost drops the
	 * machine a rung; a match won pulls it back up one, but never as far as
	 * that first rung again, so there is always something left to beat.
	 */
	const FORM = [
		{ speed: 460, lag: 0.12, miss: 30 },
		{ speed: 405, lag: 0.17, miss: 40 },
		{ speed: 350, lag: 0.23, miss: 50 },
		{ speed: 300, lag: 0.3, miss: 62 },
	];

	/**
	 * What makes each stadium itself: the bowl's corners, how the tiers are
	 * split, where the accent seating runs, and the name on the back wall.
	 */
	const VENUES = {
		usopen: {
			venue: 'Arthur Ashe Stadium',
			corner: 16, // a big square bowl
			tier: 0.46,
			accentBand: 'lower', // the blue ring under the upper tier
			roof: true,
		},
		ao: {
			venue: 'Rod Laver Arena',
			corner: 46, // rounded, almost oval
			tier: 0.44,
			accentBand: 'upper',
			roof: true,
		},
		rg: {
			venue: 'Court Philippe-Chatrier',
			corner: 8, // the rectangle in the Bois de Boulogne
			tier: 0.4,
			accentBand: 'none',
			roof: true,
		},
		wimbledon: {
			venue: 'Centre Court',
			corner: 30,
			tier: 0.42,
			accentBand: 'lower', // the club's purple in the seats
			roof: true,
		},
		atp: {
			// The finals have moved before — London's O2, now Turin — so this
			// is the one venue name here with a shelf life.
			venue: 'Inalpi Arena, Turin',
			corner: 40, // an indoor arena bowl, not a stadium
			tier: 0.5,
			accentBand: 'lower',
			roof: true,
		},
	} as const;

	type Side = 'player' | 'cpu';
	type Scores = { player: number; cpu: number };

	class TennisGame extends HTMLElement {
		constructor() {
			super();

			const dialog = this.querySelector<HTMLDialogElement>('dialog')!;
			const canvas = this.querySelector<HTMLCanvasElement>('canvas')!;
			const overlay = this.querySelector<HTMLElement>('[data-overlay]')!;
			const entry = this.querySelector<HTMLFormElement>('[data-entry]')!;
			const nameInput = this.querySelector<HTMLInputElement>('[data-name-input]')!;
			const courtBox = this.querySelector<HTMLElement>('.court')!;
			const context = canvas.getContext('2d')!;

			const out = {
				playerPoint: this.querySelector<HTMLElement>('[data-player-point]')!,
				cpuPoint: this.querySelector<HTMLElement>('[data-cpu-point]')!,
				servingPlayer: this.querySelector<HTMLElement>('[data-serving-player]')!,
				servingCpu: this.querySelector<HTMLElement>('[data-serving-cpu]')!,
				format: this.querySelector<HTMLElement>('[data-format-label]')!,
				tournament: this.querySelector<HTMLElement>('[data-tournament]')!,
				venue: this.querySelector<HTMLElement>('[data-venue]')!,
				board: this.querySelector<HTMLElement>('[data-board]')!,
				hint: this.querySelector<HTMLElement>('[data-hint-label]')!,
				playerName: this.querySelector<HTMLElement>('[data-player-name]')!,
			};

			const text = {
				serve: this.dataset.serve ?? '',
				win: this.dataset.win ?? '%s',
				again: this.dataset.again ?? '',
				decider: this.dataset.decider ?? '',
				hint: this.dataset.hint ?? '',
				hintUpright: this.dataset.hintUpright ?? '',
				you: this.dataset.you ?? 'You',
				tiebreak: this.dataset.tiebreak ?? 'Tie-break',
				champion: this.dataset.champion ?? 'Champion',
				versus: this.dataset.versus ?? 'vs. %o %s',
				shareText: this.dataset.shareText ?? '',
				cardAlt: this.dataset.cardAlt ?? '',
				copied: this.dataset.copied ?? '',
				copiedText: this.dataset.copiedText ?? '',
			};
			const locale = this.dataset.lang === 'de' ? 'de-AT' : 'en-GB';
			const host = this.dataset.host ?? '';

			/**
			 * Who is at this end of the court. Kept in localStorage so a
			 * returning visitor is still on the scoreboard, and editable from
			 * the board itself.
			 */
			const NAME_KEY = 'tennis-player';
			const opponentName = out.board.querySelector<HTMLElement>('.row:last-child .name')!
				.textContent!.trim();

			function readName() {
				try {
					return (localStorage.getItem(NAME_KEY) ?? '').trim();
				} catch {
					return '';
				}
			}

			function storeName(value: string) {
				try {
					if (value) localStorage.setItem(NAME_KEY, value);
					else localStorage.removeItem(NAME_KEY);
				} catch {
					// Private mode: the name lasts for this visit only.
				}
			}

			let playerName = readName();
			const displayName = () => playerName || text.you;

			// ── The winner's card ─────────────────────────────────────────
			const result = this.querySelector<HTMLElement>('[data-result]')!;
			const resultImage = this.querySelector<HTMLImageElement>('[data-result-image]')!;
			const resultNote = this.querySelector<HTMLElement>('[data-result-note]')!;
			const saveButton = this.querySelector<HTMLButtonElement>('[data-save]')!;
			const shareButton = this.querySelector<HTMLButtonElement>('[data-share]')!;
			const linkedInLink = this.querySelector<HTMLAnchorElement>('[data-linkedin]')!;
			const card = document.createElement('canvas');
			card.width = 1200;
			card.height = 630; // the ratio every social preview crops to

			/** The score as it goes on the card. A tie-break counts plainly. */
			const scoreLine = () => `${points.player}–${points.cpu}`;

			/** Shrinks the font until the text fits the width it is given. */
			function fitText(
				paint: CanvasRenderingContext2D,
				value: string,
				weight: string,
				start: number,
				maxWidth: number
			) {
				let size = start;
				do {
					paint.font = `${weight} ${size}px Rubik, system-ui, sans-serif`;
					size -= 2;
				} while (paint.measureText(value).width > maxWidth && size > 20);
			}

			function paintCard() {
				const paint = card.getContext('2d')!;
				const venue = VENUES[currentSlam()];
				const { width, height } = card;

				paint.fillStyle = shade(colors.stand, -0.2);
				paint.fillRect(0, 0, width, height);

				// The stadium behind the result — held back on the left, where
				// the text sits, and left to show on the right, which is what
				// makes a clay card look like clay and a grass one like grass.
				if (scene) {
					paint.drawImage(scene, 0, 0, scene.width, scene.height, 60, -30, width, 700);
					const veil = paint.createLinearGradient(0, 0, width, 0);
					veil.addColorStop(0, 'rgba(6, 14, 24, 0.92)');
					veil.addColorStop(0.48, 'rgba(6, 14, 24, 0.78)');
					veil.addColorStop(1, 'rgba(6, 14, 24, 0.18)');
					paint.fillStyle = veil;
					paint.fillRect(0, 0, width, height);
				}

				// The tournament's stripe across the top.
				paint.fillStyle = colors.ink;
				paint.fillRect(0, 0, width, 10);

				const left = 72;
				paint.textAlign = 'left';
				paint.textBaseline = 'alphabetic';

				paint.fillStyle = colors.ink;
				paint.letterSpacing = '6px';
				paint.font = '600 26px Rubik, system-ui, sans-serif';
				paint.fillText((names[currentSlam()] ?? '').toUpperCase(), left, 96);
				paint.letterSpacing = '0px';

				paint.fillStyle = 'rgba(255, 255, 255, 0.62)';
				paint.font = '400 24px Rubik, system-ui, sans-serif';
				paint.fillText(venue.venue, left, 132);

				// Champion.
				paint.fillStyle = 'rgba(255, 255, 255, 0.68)';
				paint.letterSpacing = '10px';
				paint.font = '600 22px Rubik, system-ui, sans-serif';
				paint.fillText(text.champion.toUpperCase(), left, 232);
				paint.letterSpacing = '0px';

				paint.fillStyle = '#ffffff';
				fitText(paint, displayName(), '700', 96, width - left * 2 - 120);
				paint.fillText(displayName(), left, 330);

				paint.fillStyle = colors.ink;
				paint.fillRect(left, 348, 96, 6);

				// … vs. Gnadlinger 7–4.
				const line = text.versus.replace('%o', opponentName).replace('%s', scoreLine());
				paint.fillStyle = 'rgba(255, 255, 255, 0.92)';
				fitText(paint, line, '400', 40, width - left * 2 - 120);
				paint.fillText(line, left, 412);

				// The ball, oversized, as the card's mark.
				paint.fillStyle = '#d8f000';
				paint.beginPath();
				paint.arc(width - 132, 158, 46, 0, Math.PI * 2);
				paint.fill();
				paint.strokeStyle = 'rgba(255, 255, 255, 0.85)';
				paint.lineWidth = 5;
                paint.beginPath();
				paint.arc(width - 132, 158, 34, Math.PI * 0.72, Math.PI * 1.45);
				paint.stroke();

				// Footer: where the match was played, and when.
				const when = new Date().toLocaleDateString(locale, {
					day: 'numeric',
					month: 'long',
					year: 'numeric',
				});
				paint.font = '400 24px Rubik, system-ui, sans-serif';
				paint.fillStyle = 'rgba(255, 255, 255, 0.62)';
				paint.fillText(when, left, height - 60);
				const dateWidth = paint.measureText(`${when}   `).width;
				paint.font = '600 26px Rubik, system-ui, sans-serif';
				paint.fillStyle = colors.ink;
				paint.fillText(host, left + dateWidth, height - 60);
			}
			const names: Record<string, string> = JSON.parse(this.dataset.names ?? '{}');

			const currentSlam = () => {
				const id = document.documentElement.dataset.slam ?? 'usopen';
				return (id in VENUES ? id : 'usopen') as keyof typeof VENUES;
			};

			/** Palette, read from the page so the stadium matches the theme. */
			let colors = readColors();
			function readColors() {
				const style = getComputedStyle(document.documentElement);
				const value = (name: string, fallback: string) =>
					style.getPropertyValue(name).trim() || fallback;
				return {
					surface: value('--court-surface', '#2f6cb5'),
					apron: value('--court-apron', '#1d4f8c'),
					line: value('--court-line', '#ffffff'),
					net: value('--court-net', 'rgba(255,255,255,0.62)'),
					stand: value('--stand', '#0e2a4d'),
					seat: value('--stand-seat', '#16406f'),
					accent: value('--stand-accent', '#0057b8'),
					// The board's accent is the one picked to read on a dark
					// panel, which is exactly what the card is.
					ink: value('--board-accent', '#7fb3ee'),
					player: value('--accent-regular', '#0057b8'),
				};
			}

			/**
			 * Everything that never moves — bowl, crowd, court, umpire — is
			 * painted once into this layer and blitted each frame.
			 */
			let scene: HTMLCanvasElement | null = null;

			function paintScene() {
				const venue = VENUES[currentSlam()];
				const layer = document.createElement('canvas');
				layer.width = W;
				layer.height = H;
				const paint = layer.getContext('2d')!;

				// Deterministic crowd: the same house every time the door opens.
				let seed = 20260913;
				const random = () => {
					seed = (seed * 1664525 + 1013904223) % 4294967296;
					return seed / 4294967296;
				};

				// ── The bowl ────────────────────────────────────────────────
				// Roof and outer structure, then two tiers of seating rings
				// with a concourse between them, each one painted as a block
				// and then filled with a crowd.
				paint.fillStyle = shade(colors.stand, -0.45);
				paint.fillRect(0, 0, W, H);

				const outer = { x: 8, y: 6, w: W - 16, h: H - 12 };
				const front = {
					x: COURT_X - APRON_X,
					y: COURT_Y - APRON_Y,
					w: COURT_W + APRON_X * 2,
					h: COURT_H + APRON_Y * 2,
				};
				// The upper tier reaches this far in from the outer wall.
				const split = {
					x: outer.x + (front.x - outer.x) * venue.tier,
					y: outer.y + (front.y - outer.y) * venue.tier,
					w: 0,
					h: 0,
				};
				split.w = outer.w - (split.x - outer.x) * 2;
				split.h = outer.h - (split.y - outer.y) * 2;
				const concourse = inset(split, 14);

				roundRect(paint, outer, venue.corner + 16, shade(colors.seat, -0.4));
				seats(paint, outer, split, venue.accentBand === 'upper', random);

				// Concourse: the dark gap that separates the two tiers.
				roundRect(paint, split, venue.corner + 8, shade(colors.stand, -0.2));
				roundRect(paint, concourse, venue.corner + 6, shade(colors.seat, -0.2));
				seats(paint, concourse, front, venue.accentBand === 'lower', random);

				// The rail along the front row.
				paint.strokeStyle = 'rgba(255, 255, 255, 0.18)';
				paint.lineWidth = 2;
				paint.beginPath();
				paint.roundRect(front.x - 5, front.y - 5, front.w + 10, front.h + 10, 8);
				paint.stroke();

				// ── Back wall, with the venue's name on it ──────────────────
				const wall = { x: front.x, y: front.y - 34, w: front.w, h: 30 };
				roundRect(paint, wall, 4, shade(colors.stand, -0.4));
				paint.fillStyle = 'rgba(255, 255, 255, 0.72)';
				paint.font = '600 13px Rubik, system-ui, sans-serif';
				paint.textAlign = 'center';
				paint.textBaseline = 'middle';
				paint.letterSpacing = '3px';
				paint.fillText(venue.venue.toUpperCase(), W / 2, wall.y + wall.h / 2);
				paint.letterSpacing = '0px';

				// ── Run-off and court ───────────────────────────────────────
				roundRect(paint, front, 6, colors.apron);
				paint.fillStyle = colors.surface;
				paint.fillRect(COURT_X, COURT_Y, COURT_W, COURT_H);

				paint.strokeStyle = colors.line;
				paint.lineWidth = 3;
				paint.strokeRect(COURT_X, COURT_Y, COURT_W, COURT_H);
				const net = NET_X;
				const lines: [number, number, number, number][] = [
					[COURT_X, COURT_Y + ALLEY, COURT_X + COURT_W, COURT_Y + ALLEY],
					[COURT_X, COURT_Y + COURT_H - ALLEY, COURT_X + COURT_W, COURT_Y + COURT_H - ALLEY],
					[net - SERVICE, COURT_Y + ALLEY, net - SERVICE, COURT_Y + COURT_H - ALLEY],
					[net + SERVICE, COURT_Y + ALLEY, net + SERVICE, COURT_Y + COURT_H - ALLEY],
					[net - SERVICE, COURT_Y + COURT_H / 2, net + SERVICE, COURT_Y + COURT_H / 2],
					[COURT_X, COURT_Y + COURT_H / 2, COURT_X + 14, COURT_Y + COURT_H / 2],
					[COURT_X + COURT_W - 14, COURT_Y + COURT_H / 2, COURT_X + COURT_W, COURT_Y + COURT_H / 2],
				];
				for (const [x1, y1, x2, y2] of lines) {
					paint.beginPath();
					paint.moveTo(x1, y1);
					paint.lineTo(x2, y2);
					paint.stroke();
				}

				// Net, strung between posts outside the doubles lines.
				paint.strokeStyle = colors.net;
				paint.lineWidth = 5;
				paint.setLineDash([9, 7]);
				paint.beginPath();
				paint.moveTo(net, COURT_Y - 16);
				paint.lineTo(net, COURT_Y + COURT_H + 16);
				paint.stroke();
				paint.setLineDash([]);
				paint.fillStyle = colors.line;
				dot(paint, net, COURT_Y - 16, 4);
				dot(paint, net, COURT_Y + COURT_H + 16, 4);

				// ── The officials ───────────────────────────────────────────
				// Umpire's chair at the net, ball kids at the posts, line judges
				// behind the baselines.
				paint.fillStyle = shade(colors.stand, -0.25);
				paint.fillRect(net - 11, COURT_Y - APRON_Y + 14, 22, 30);
				paint.fillStyle = 'rgba(255, 255, 255, 0.8)';
				dot(paint, net, COURT_Y - APRON_Y + 22, 5);

				paint.fillStyle = 'rgba(255, 255, 255, 0.55)';
				for (const [x, y] of [
					[COURT_X - 34, COURT_Y - 26],
					[COURT_X - 34, COURT_Y + COURT_H + 26],
					[COURT_X + COURT_W + 34, COURT_Y - 26],
					[COURT_X + COURT_W + 34, COURT_Y + COURT_H + 26],
					[net - 26, COURT_Y + COURT_H + APRON_Y - 18],
					[net + 26, COURT_Y + COURT_H + APRON_Y - 18],
				] as [number, number][]) {
					dot(paint, x, y, 4.5);
				}

				scene = layer;
			}

			/**
			 * Fills the ring between `from` and `to` with a packed crowd: rows
			 * of heads, gangways cut through them, and — where the venue has
			 * one — a band of seats in the tournament's own colour.
			 */
			function seats(
				paint: CanvasRenderingContext2D,
				from: { x: number; y: number; w: number; h: number },
				to: { x: number; y: number; w: number; h: number },
				accented: boolean,
				random: () => number
			) {
				const step = 6;
				for (let y = from.y + 5; y < from.y + from.h - 3; y += step) {
					for (let x = from.x + 5; x < from.x + from.w - 3; x += step) {
						const inside =
							x > to.x - 3 && x < to.x + to.w + 3 && y > to.y - 3 && y < to.y + to.h + 3;
						if (inside) continue;

						// Gangways up through the stand, every so many rows.
						if ((x - from.x) % 84 < 6 || (y - from.y) % 84 < 6) continue;

						const roll = random();
						if (roll < 0.12) continue; // an empty seat

						// A block of the tournament's own colour runs through the
						// tier where the venue has one.
						const band = accented && (y - from.y) % 66 < 12;
						paint.fillStyle = band
							? roll > 0.5
								? colors.accent
								: shade(colors.accent, 0.25)
							: roll > 0.78
								? shade(colors.seat, 0.55) // a shirt catching the light
								: roll > 0.55
									? shade(colors.seat, 0.28)
									: roll > 0.3
										? colors.seat
										: shade(colors.seat, -0.25);
						paint.beginPath();
						paint.arc(x + random(), y + random(), 1.9, 0, Math.PI * 2);
						paint.fill();
					}
				}
			}

			function roundRect(
				paint: CanvasRenderingContext2D,
				box: { x: number; y: number; w: number; h: number },
				radius: number,
				fill: string
			) {
				paint.fillStyle = fill;
				paint.beginPath();
				paint.roundRect(box.x, box.y, box.w, box.h, radius);
				paint.fill();
			}

			function inset(box: { x: number; y: number; w: number; h: number }, by: number) {
				return { x: box.x + by, y: box.y + by, w: box.w - by * 2, h: box.h - by * 2 };
			}

			function dot(paint: CanvasRenderingContext2D, x: number, y: number, r: number) {
				paint.beginPath();
				paint.arc(x, y, r, 0, Math.PI * 2);
				paint.fill();
			}

			/** Mixes a hex colour towards white (positive) or black (negative). */
			function shade(hex: string, amount: number) {
				const match = /^#?([\da-f]{6})$/i.exec(hex.trim());
				if (!match) return hex;
				const value = parseInt(match[1]!, 16);
				const mix = (channel: number) =>
					Math.round(
						amount >= 0 ? channel + (255 - channel) * amount : channel * (1 + amount)
					);
				return `rgb(${mix((value >> 16) & 255)}, ${mix((value >> 8) & 255)}, ${mix(value & 255)})`;
			}

			let playerY = (H - PADDLE_H) / 2;
			let cpuY = playerY;
			let ball = { x: W / 2, y: H / 2, vx: 0, vy: 0 };
			let points: Scores = { player: 0, cpu: 0 };
			let serving = true;
			let over = false;
			let server: Side = 'player';
			let frame = 0;
			let last = 0;
			let pointerY: number | null = null;
			const keys = new Set<string>();

			/**
			 * A phone held upright has no room for a court lying on its side,
			 * so the whole scene is turned a quarter turn. What is played is
			 * the same either way — one tie-break, which is about the right
			 * length for a match found by accident in a footer.
			 */
			const upright = matchMedia('(orientation: portrait)');
			let portrait = upright.matches;
			/** Who started the tie-break: the serve order is counted from it. */
			let opener: Side = 'player';

			/** 6–6: whoever takes the next point takes the match. */
			const deciding = () => points.player === TARGET - 1 && points.cpu === TARGET - 1;

			/**
			 * Which rung of FORM the machine is on, kept beside the name so a
			 * visitor who lost last time comes back to an opponent who has not
			 * got over it either.
			 */
			const FORM_KEY = 'tennis-form';
			let level = readLevel();

			function readLevel() {
				try {
					const stored = Number(localStorage.getItem(FORM_KEY));
					return Number.isInteger(stored) ? clamp(stored, 0, FORM.length - 1) : 0;
				} catch {
					return 0;
				}
			}

			/** After a match: a rung down on a loss, and only one back on a win. */
			function settle(winner: Side) {
				level =
					winner === 'player'
						? Math.max(1, level - 1)
						: Math.min(FORM.length - 1, level + 1);
				try {
					localStorage.setItem(FORM_KEY, String(level));
				} catch {
					// Private mode: the ladder lasts for this visit only.
				}
			}

			/**
			 * How far off the machine reads the ball coming at it. Rolled once
			 * per shot rather than per frame — a racket that twitches looks
			 * broken, one already on the wrong line looks human — and scaled
			 * by how steeply the ball is climbing, so a flat one comes back
			 * and a ball driven into the corner is the one it misjudges.
			 */
			let misread = 0;

			/**
			 * Where the machine means to stand for its own serve, or null when
			 * it is receiving. It walks over between points rather than
			 * appearing there, which is what makes the rotation legible: the
			 * racket visibly changes side every point.
			 */
			let stance: number | null = null;
			function takeStance() {
				stance =
					server === 'cpu'
						// Between the centre mark and the sideline, the way a
						// person stands: rarely right on either.
						? MID_Y + serveSide() * SERVE_HALF * (0.15 + Math.random() * 0.7) - PADDLE_H / 2
						: null;
			}

			function readBall() {
				const awkward = Math.min(1, Math.abs(ball.vy) / 700);
				misread = (Math.random() * 2 - 1) * FORM[level]!.miss * (0.35 + 0.65 * awkward);
			}

			/**
			 * Where the ball has been: what the machine reads the line off a
			 * moment late, and what the tail behind the ball is drawn from.
			 * Stamped with the clock rather than counted in frames, because the
			 * loop's own step is whatever the display gives it.
			 */
			let clock = 0;
			const trail: { at: number; x: number; y: number }[] = [];

			/** The ball's line as the machine has it: `lag` seconds out of date. */
			function seen(lag: number) {
				const want = clock - lag;
				for (let i = trail.length - 1; i >= 0; i--) {
					if (trail[i]!.at <= want) return trail[i]!.y;
				}
				return trail[0]?.y ?? ball.y;
			}

			function paintScore() {
				out.playerName.textContent = displayName();
				out.playerPoint.textContent = String(points.player);
				out.cpuPoint.textContent = String(points.cpu);
				out.servingPlayer.classList.toggle('on', server === 'player');
				out.servingCpu.classList.toggle('on', server === 'cpu');

				// The chip on the board says what is being played — and at 6–6,
				// what is about to be.
				out.format.textContent = deciding() ? text.decider : text.tiebreak;
				out.format.classList.toggle('decider', deciding());

				const slam = currentSlam();
				out.tournament.textContent = names[slam] ?? '';
				out.venue.textContent = VENUES[slam].venue;
			}

			/**
			 * Which half of the baseline the serve is struck from: +1 below the
			 * centre line, −1 above it.
			 *
			 * A tie-break counts as a single game, so its first point is served
			 * from the deuce court and every point after it changes side. Deuce
			 * court means the server's right, and the two ends of this court
			 * face opposite ways: the player looks up it, so their right is the
			 * bottom of the screen, while the machine looks back down it and
			 * its right is the top. The serve therefore always crosses the
			 * middle, which is the diagonal the rules are really asking for.
			 */
			function serveSide() {
				const deuce = (points.player + points.cpu) % 2 === 0;
				return (server === 'player') === deuce ? 1 : -1;
			}

			/** The racket face a serve leaves from. */
			function serveX(side: Side) {
				return side === 'player'
					? COURT_X + PADDLE_INSET + PADDLE_W + BALL_R
					: COURT_X + COURT_W - PADDLE_INSET - PADDLE_W - BALL_R;
			}

			/** The bounds the server's racket is held between while serving. */
			function serveBounds() {
				const from = MID_Y - PADDLE_H / 2;
				const to = from + serveSide() * SERVE_HALF;
				return { low: Math.min(from, to), high: Math.max(from, to) };
			}

			/**
			 * Where the serve is meant to come down, from where it is struck.
			 * Walking out towards your own sideline opens the angle and takes
			 * the ball wide; serving from the centre mark sends it down the
			 * middle. Both land inside the box — there are no faults yet.
			 */
			function serveTarget(from: number) {
				const side = serveSide();
				const out = clamp((from - MID_Y) / (side * SERVE_HALF), 0, 1);
				const depth = SERVE_INSET + out * (1 - SERVE_INSET * 2);
				return MID_Y - side * SERVE_HALF * depth;
			}

			function serve() {
				// The machine walks to its mark between points, but a visitor
				// who taps straight away does not have to wait for it.
				if (server === 'cpu' && stance !== null) cpuY = stance;

				const toward = server === 'player' ? 1 : -1;
				const x = serveX(server);
				const y = (server === 'player' ? playerY : cpuY) + PADDLE_H / 2;
				const landX = NET_X + toward * SERVICE * SERVE_CARRY;
				const angle = Math.atan2(serveTarget(y) - y, landX - x);

				ball = {
					x,
					y,
					vx: Math.cos(angle) * SERVE_SPEED,
					vy: Math.sin(angle) * SERVE_SPEED,
				};
				trail.length = 0;
				readBall();
				serving = false;
				overlay.hidden = true;
			}

			/** The overlay's two lines: a call, and the note under it. */
			function announce(call: string, note: string) {
				const head = document.createElement('strong');
				head.textContent = call;
				const under = document.createElement('span');
				under.textContent = note;
				overlay.replaceChildren(head, under);
				overlay.hidden = false;
			}

			/** Between points. At 6–6 the call is what is at stake. */
			function callServe() {
				if (deciding()) announce(text.decider, text.serve);
				else {
					overlay.textContent = text.serve;
					overlay.hidden = false;
				}
			}

			function awardPoint(to: Side) {
				points[to] += 1;

				// One point on the opening serve, two each after that.
				const played = points.player + points.cpu;
				const flipped = Math.floor((played + 1) / 2) % 2 === 1;
				server = flipped ? (opener === 'player' ? 'cpu' : 'player') : opener;

				paintScore();

				// First to seven, and no two clear about it: at 6–6 the point
				// just played was the deciding one.
				if (points[to] >= TARGET) {
					over = true;
					serving = true;
					settle(to);
					const winner = to === 'player' ? displayName() : opponentName;
					const line = text.win.replace('%s', winner);

					// A win is worth keeping: the visitor gets a card to take
					// away, the other way round gets the line and a restart.
					if (to === 'player') {
						showResult(line);
						return;
					}

					announce(line, text.again);
					return;
				}

				serving = true;
				ball.vx = ball.vy = 0;
				takeStance();
				callServe();
			}

			function reset() {
				hideResult();
				points = { player: 0, cpu: 0 };
				server = 'player';
				opener = 'player';
				over = false;
				serving = true;
				ball = { x: W / 2, y: H / 2, vx: 0, vy: 0 };
				playerY = cpuY = (H - PADDLE_H) / 2;
				takeStance();
				trail.length = 0;
				readBall();
				paintScore();
				callServe();
			}

			function step(seconds: number) {
				clock += seconds;
				trail.push({ at: clock, x: ball.x, y: ball.y });
				// Half a second of history, comfortably past the longest lag.
				while (trail.length > 1 && trail[0]!.at < clock - 0.5) trail.shift();

				if (pointerY !== null) {
					playerY = pointerY - PADDLE_H / 2;
				} else {
					if (keys.has('ArrowUp') || keys.has('ArrowLeft') || keys.has('w') || keys.has('W')) {
						playerY -= PLAYER_SPEED * seconds;
					}
					if (keys.has('ArrowDown') || keys.has('ArrowRight') || keys.has('s') || keys.has('S')) {
						playerY += PLAYER_SPEED * seconds;
					}
				}
				if (serving && server === 'player') {
					// Serving, the racket is held to the half of the baseline
					// the rules put it on — the rule enforced by where you are
					// allowed to stand rather than by a message.
					const bounds = serveBounds();
					playerY = clamp(playerY, bounds.low, bounds.high);
				} else {
					playerY = clamp(playerY, COURT_Y, COURT_Y + COURT_H - PADDLE_H);
				}

				// The machine chases the ball, but only so fast, off a line it
				// read a moment ago, and never quite the line the ball is on.
				// The rest of the time it recovers to the middle. How badly it
				// does each of those three is the rung of FORM it has slipped
				// to — which is the whole easter egg.
				const form = FORM[level]!;
				const chasing = ball.vx > 0;
				const target =
					serving && stance !== null
						? stance // walking to its mark for the serve
						: chasing
							? seen(form.lag) + misread - PADDLE_H / 2
							: COURT_Y + (COURT_H - PADDLE_H) / 2;
				const reach = form.speed * seconds * (chasing ? 1 : 0.55);
				cpuY = clamp(
					cpuY + clamp(target - cpuY, -reach, reach),
					COURT_Y,
					COURT_Y + COURT_H - PADDLE_H
				);

				// Between points the ball is in the server's hand, so it moves
				// with the racket and shows whose serve it is.
				if (serving) {
					ball.x = serveX(server);
					ball.y = (server === 'player' ? playerY : cpuY) + PADDLE_H / 2;
					return;
				}

				ball.x += ball.vx * seconds;
				ball.y += ball.vy * seconds;

				if (ball.y - BALL_R <= COURT_Y && ball.vy < 0) {
					ball.y = COURT_Y + BALL_R;
					ball.vy *= -1;
				}
				if (ball.y + BALL_R >= COURT_Y + COURT_H && ball.vy > 0) {
					ball.y = COURT_Y + COURT_H - BALL_R;
					ball.vy *= -1;
				}

				const playerX = COURT_X + PADDLE_INSET;
				const cpuX = COURT_X + COURT_W - PADDLE_INSET - PADDLE_W;

				if (
					ball.vx < 0 &&
					ball.x - BALL_R <= playerX + PADDLE_W &&
					ball.x - BALL_R >= playerX - 14 &&
					ball.y >= playerY &&
					ball.y <= playerY + PADDLE_H
				) {
					returnBall(playerX + PADDLE_W + BALL_R, playerY, 1);
				}

				if (
					ball.vx > 0 &&
					ball.x + BALL_R >= cpuX &&
					ball.x + BALL_R <= cpuX + PADDLE_W + 14 &&
					ball.y >= cpuY &&
					ball.y <= cpuY + PADDLE_H
				) {
					returnBall(cpuX - BALL_R, cpuY, -1);
				}

				if (ball.x < COURT_X - 70) awardPoint('cpu');
				else if (ball.x > COURT_X + COURT_W + 70) awardPoint('player');
			}

			/** Where the ball meets the racket decides the angle back. */
			function returnBall(x: number, paddleY: number, direction: 1 | -1) {
				const offset = (ball.y - (paddleY + PADDLE_H / 2)) / (PADDLE_H / 2);
				const speed = Math.min(Math.hypot(ball.vx, ball.vy) * 1.05, MAX_SPEED);
				// The jitter matters: a ball met dead centre would otherwise go
				// back perfectly flat, and two players who both return down the
				// middle would rally until the tournament ended.
				const angle = offset * 0.9 + (Math.random() - 0.5) * 0.09;
				ball.x = x;
				ball.vx = Math.cos(angle) * speed * direction;
				ball.vy = Math.sin(angle) * speed;
				// A new shot on its way over: the machine reads it afresh.
				if (direction === 1) readBall();
			}

			/**
			 * A short tail behind the ball. The court is a busy thing to find
			 * a small yellow dot on — a crowd, the lines, the net — and by the
			 * end of a rally that dot is crossing it at a thousand pixels a
			 * second. The tail is what the eye actually tracks; the ball on
			 * its own reads as a flicker.
			 */
			const TAIL = 0.11; // seconds of it, so it stays a tail and not a streak

			function tail() {
				if (serving) return; // nothing to trail, and the trail is stale
				context.fillStyle = '#d8f000';
				for (const mark of trail) {
					const age = (clock - mark.at) / TAIL;
					if (age > 1) continue;
					const left = 1 - age;
					// Squared, so the tail thins out quickly behind the ball
					// rather than dragging an even smear across the court.
					context.globalAlpha = 0.45 * left * left;
					dot(context, mark.x, mark.y, BALL_R * (0.3 + 0.7 * left));
				}
				context.globalAlpha = 1;
			}

			function draw() {
				// Everything below is drawn in the court's own landscape
				// coordinates; upright, the whole scene is turned a quarter
				// turn so the player's end is at the bottom of the screen.
				context.setTransform(1, 0, 0, 1, 0, 0);
				context.clearRect(0, 0, canvas.width, canvas.height);
				if (portrait) {
					context.translate(0, canvas.height);
					context.rotate(-Math.PI / 2);
				}

				if (scene) context.drawImage(scene, 0, 0);

				// Deliberately not the theme colours: these two have to stay
				// apart from each other on clay, grass and blue alike.
				paddle(COURT_X + PADDLE_INSET, playerY, '#11202b');
				paddle(COURT_X + COURT_W - PADDLE_INSET - PADDLE_W, cpuY, '#f2f5f8');

				tail();

				// The ball is yellow on every court there is.
				context.fillStyle = '#d8f000';
				dot(context, ball.x, ball.y, BALL_R);
				context.strokeStyle = 'rgba(255, 255, 255, 0.85)';
				context.lineWidth = 1.5;
				context.beginPath();
				context.arc(ball.x, ball.y, BALL_R - 2.5, Math.PI * 0.75, Math.PI * 1.45);
				context.stroke();
			}

			function paddle(x: number, y: number, color: string) {
				context.fillStyle = color;
				context.beginPath();
				context.roundRect(x, y, PADDLE_W, PADDLE_H, 5);
				context.fill();
			}

			function loop(now: number) {
				const seconds = Math.min((now - last) / 1000, 1 / 30);
				last = now;
				step(seconds);
				draw();
				frame = requestAnimationFrame(loop);
			}

			function start() {
				last = performance.now();
				frame = requestAnimationFrame(loop);
			}

			function stop() {
				cancelAnimationFrame(frame);
			}

			function clamp(value: number, min: number, max: number) {
				return Math.max(min, Math.min(max, value));
			}

			/**
			 * Fits the canvas to the orientation. Only the hint changes with
			 * it, because only the controls do: the same tie-break is played
			 * whichever way the phone is held, so a match survives the turn.
			 */
			function applyLayout() {
				portrait = upright.matches;
				canvas.width = portrait ? H : W;
				canvas.height = portrait ? W : H;
				out.hint.textContent = portrait ? text.hintUpright : text.hint;
			}

			/**
			 * Sizes the canvas to the largest box the court area can hold
			 * without distorting the drawing. Done here rather than in CSS
			 * because the element's box has to match what is painted exactly:
			 * a letterboxed canvas would put every tap out by the margin.
			 */
			function fitCanvas() {
				const box = courtBox.getBoundingClientRect();
				if (!box.width || !box.height) return;

				const ratio = canvas.width / canvas.height;
				let width = box.width;
				let height = width / ratio;
				if (height > box.height) {
					height = box.height;
					width = height * ratio;
				}

				const next = `${Math.round(width)}px`;
				if (canvas.style.width === next) return; // already settled
				canvas.style.width = next;
				canvas.style.height = `${Math.round(height)}px`;
			}

			new ResizeObserver(fitCanvas).observe(courtBox);

			function refresh() {
				colors = readColors();
				paintScene();
				paintScore();
			}

			// Turning the phone only turns the court: the score, the serve and
			// the point in progress all carry across.
			upright.addEventListener('change', () => {
				applyLayout();
				if (!dialog.open) return;
				fitCanvas();
				draw();
			});

			// The stadium follows the theme and the tournament, even mid-match.
			new MutationObserver(() => {
				if (dialog.open) refresh();
			}).observe(document.documentElement, {
				attributes: true,
				attributeFilter: ['class', 'data-slam'],
			});

			// ── Wiring ────────────────────────────────────────────────────
			this.querySelector<HTMLButtonElement>('.open')!.addEventListener('click', () => {
				applyLayout();
				refresh();
				reset();
				dialog.showModal();
				fitCanvas();
				if (playerName) start();
				else askName(true);
			});

			this.querySelector<HTMLButtonElement>('.close')!.addEventListener('click', () => dialog.close());
			dialog.addEventListener('close', () => {
				signing = false;
				entry.hidden = true;
				hideResult();
				stop();
			});
			dialog.addEventListener('click', (event) => {
				if (event.target === dialog) dialog.close();
			});

			/** Blocks play while the card is being filled in. */
			let signing = false;
			/** Blocks it while the winner's card is up. */
			let showing = false;

			function showResult(line: string) {
				paintCard();
				const score = scoreLine();
				const alt = text.cardAlt
					.replace('%p', displayName())
					.replace('%o', opponentName)
					.replace('%s', score);

				resultImage.src = card.toDataURL('image/png');
				resultImage.alt = alt;
				fileName = `tennis-${displayName().toLowerCase().replace(/\s+/g, '-')}-${score.replace('–', '-')}.png`;
				resultNote.textContent = '';
				cardFile = null;
				void cardBlob().then((blob) => {
					cardFile = blob;
				});

				showing = true;
				overlay.hidden = true;
				result.hidden = false;
				stop();
				// The match is over; the keyboard belongs to the card now.
				saveButton.focus();
			}

			function hideResult() {
				showing = false;
				result.hidden = true;
			}

			/**
			 * The card as a file, for the share sheet and the clipboard. Made
			 * as soon as the card is shown: writing to the clipboard has to
			 * happen close to the click that asked for it, and encoding a PNG
			 * in between is enough to lose that in some browsers.
			 */
			let cardFile: Blob | null = null;
			let fileName = 'tennis.png';
			function cardBlob(): Promise<Blob | null> {
				return new Promise((resolve) => card.toBlob(resolve, 'image/png'));
			}

			saveButton.addEventListener('click', () => {
				const link = document.createElement('a');
				link.href = card.toDataURL('image/png');
				link.download = fileName;
				link.click();
			});

			function shareLine() {
				return text.shareText.replace('%s', scoreLine());
			}

			// The share sheet only exists on some browsers; the button stays
			// hidden where it does not, rather than failing when pressed.
			if (typeof navigator.share === 'function') shareButton.hidden = false;

			shareButton.addEventListener('click', async () => {
				const blob = cardFile ?? (await cardBlob());
				const file = blob ? new File([blob], 'tennis.png', { type: 'image/png' }) : null;
				const payload: ShareData = { text: shareLine(), url: `https://${host}/` };

				try {
					if (file && navigator.canShare?.({ files: [file] })) {
						await navigator.share({ ...payload, files: [file] });
					} else {
						await navigator.share(payload);
					}
				} catch {
					// A cancelled share sheet is not a failure worth reporting.
				}
			});

			// LinkedIn takes no attachment through a link, so the result goes to
			// the clipboard on the way out and the note says to paste it. The
			// link itself opens the profile either way — the copy is a bonus,
			// and the note never claims a copy that did not happen.
			linkedInLink.addEventListener('click', async () => {
				const line = shareLine();

				try {
					if (cardFile && typeof ClipboardItem !== 'undefined' && navigator.clipboard?.write) {
						await navigator.clipboard.write([
							new ClipboardItem({
								'image/png': cardFile,
								'text/plain': new Blob([line], { type: 'text/plain' }),
							}),
						]);
						resultNote.textContent = text.copied;
						return;
					}
					await navigator.clipboard.writeText(line);
					resultNote.textContent = text.copiedText;
				} catch {
					// No clipboard: hand them the line to copy by hand.
					resultNote.textContent = line;
				}
			});

			this.querySelector<HTMLButtonElement>('[data-play-again]')!.addEventListener('click', () => {
				hideResult();
				reset();
				start();
			});

			function askName(initial: boolean) {
				signing = true;
				entry.hidden = false;
				overlay.hidden = true;
				// The card sits over the stadium, so there has to be one on the
				// canvas before the loop is stopped underneath it.
				draw();
				nameInput.value = playerName;
				// A returning player is renaming, so start from a clean field
				// only when there is nothing to rename.
				if (initial) nameInput.value = '';
				stop();
				nameInput.focus();
				nameInput.select();
			}

			function closeName() {
				signing = false;
				entry.hidden = true;
				overlay.hidden = over || serving ? false : true;
				start();
			}

			entry.addEventListener('submit', (event) => {
				event.preventDefault();
				playerName = nameInput.value.trim().slice(0, 14);
				storeName(playerName);
				paintScore();
				closeName();
			});

			this.querySelector<HTMLButtonElement>('[data-rename]')!.addEventListener('click', () => {
				askName(false);
			});

			const serveOrRestart = () => {
				if (signing) return;
				if (showing) {
					// The card has its own "play again"; a stray tap should not
					// throw the result away.
					return;
				}
				if (over) reset();
				else if (serving) serve();
			};

			canvas.addEventListener('pointerdown', (event) => {
				if (signing) return;
				track(event);
				serveOrRestart();
			});
			canvas.addEventListener('pointermove', track);
			canvas.addEventListener('pointerleave', () => {
				pointerY = null;
			});

			function track(event: PointerEvent) {
				const box = canvas.getBoundingClientRect();
				// Upright, the court's length runs down the screen, so the
				// racket is moved across it — the finger's x, not its y.
				pointerY = portrait
					? ((event.clientX - box.left) / box.width) * H
					: ((event.clientY - box.top) / box.height) * H;
			}

			/** A control that wants the key for itself: buttons and the name field. */
			const ownsKeys = (target: EventTarget | null) =>
				target instanceof Element && target.closest('button, input, select, textarea, a[href]') !== null;

			// The match listens on the document, not on the dialog: hiding the
			// name field or the winner's card drops focus back to the body, and
			// a listener on the dialog would never see the keys again.
			document.addEventListener('keydown', (event: KeyboardEvent) => {
				if (!dialog.open) return;
				if (signing) {
					// The field owns the keyboard: space types a space, Escape
					// leaves the name as it was rather than closing the match.
					if (event.key === 'Escape') {
						event.preventDefault();
						event.stopPropagation();
						closeName();
					}
					return;
				}
				if (event.key === ' ' || event.key === 'Enter') {
					// Space and Enter belong to whichever button is focused.
					if (ownsKeys(event.target)) return;
					event.preventDefault();
					serveOrRestart();
					return;
				}
				if (['ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight', 'w', 'W', 's', 'S'].includes(event.key)) {
					event.preventDefault();
					pointerY = null; // hand control back to the keyboard
					keys.add(event.key);
				}
			});
			document.addEventListener('keyup', (event: KeyboardEvent) => keys.delete(event.key));

			// A tab sent to the background should not bank a walkover.
			document.addEventListener('visibilitychange', () => {
				if (!dialog.open) return;
				if (document.hidden) stop();
				else start();
			});

			applyLayout();
			paintScore();
		}
	}

	customElements.define('tennis-game', TennisGame);
</script>

