---
/**
 * A match against the machine, played in whichever Grand Slam's stadium the
 * site is currently wearing (src/lib/slam.ts). Pong rules, tennis scoring —
 * 15, 30, 40, deuce, advantage — and the tournament's own scoreboard over
 * the court.
 *
 * Each major gets its venue: the bowl's shape, the seats, the surface and the
 * board all change with `data-slam`. Colours come from the palette tokens in
 * src/styles/global.css; the structure comes from VENUES in the script below.
 *
 * The button lives in the footer; the game is a modal dialog, so the canvas
 * and its loop exist once per page and only run while it is open.
 */
import { getLangFromUrl } from '../i18n/utils';
import { FULL_NAME } from '../lib/schema';
import { slams } from '../lib/slam';

const lang = getLangFromUrl(Astro.url);

/** Scoreboards show surnames, so this one does too. */
const surname = FULL_NAME.split(' ').pop() ?? 'Player';

const copy = {
	en: {
		play: 'Play a point',
		title: 'Tennis',
		close: 'Close',
		opponent: 'Machine',
		serve: 'Space or tap to serve',
		hint: 'Mouse, finger or ↑ ↓ to move · first to four games takes the match',
		youWin: 'Game, set and match, ' + surname + '.',
		cpuWin: 'Game, set and match, Machine.',
		again: 'Tap or press space for a new match',
		deuce: 'Deuce',
	},
	de: {
		play: 'Einen Punkt spielen',
		title: 'Tennis',
		close: 'Schließen',
		opponent: 'Maschine',
		serve: 'Leertaste oder tippen zum Aufschlag',
		hint: 'Maus, Finger oder ↑ ↓ zum Bewegen · wer vier Spiele holt, gewinnt',
		youWin: 'Spiel, Satz und Sieg, ' + surname + '.',
		cpuWin: 'Spiel, Satz und Sieg, Maschine.',
		again: 'Tippen oder Leertaste für ein neues Match',
		deuce: 'Einstand',
	},
}[lang];

/** Tournament names for the board, keyed by the `data-slam` attribute. */
const names = Object.fromEntries(slams.map((slam) => [slam.id, slam.name]));
---

<tennis-game
	class="tennis"
	data-names={JSON.stringify(names)}
	data-serve={copy.serve}
	data-you-win={copy.youWin}
	data-cpu-win={copy.cpuWin}
	data-again={copy.again}
	data-deuce={copy.deuce}
>
	<button type="button" class="open">
		<svg class="ball" viewBox="0 0 24 24" aria-hidden="true">
			<circle cx="12" cy="12" r="9"></circle>
			<path d="M4.2 6.2A9 9 0 0 1 9.6 20.5"></path>
			<path d="M19.8 6.2A9 9 0 0 0 14.4 20.5"></path>
		</svg>
		{copy.play}
	</button>

	<dialog class="stage" aria-label={copy.title}>
		<div class="frame">
			<!-- The tournament's own board: name, server, games, points. -->
			<div class="board">
				<div class="brand">
					<span class="tournament" data-tournament>US Open</span>
					<span class="venue" data-venue></span>
				</div>
				<div class="rows">
					<div class="row">
						<span class="serving" data-serving-player aria-hidden="true"></span>
						<span class="name">{surname}</span>
						<span class="games" data-player-games>0</span>
						<span class="points" data-player-point>0</span>
					</div>
					<div class="row">
						<span class="serving" data-serving-cpu aria-hidden="true"></span>
						<span class="name">{copy.opponent}</span>
						<span class="games" data-cpu-games>0</span>
						<span class="points" data-cpu-point>0</span>
					</div>
				</div>
			</div>

			<button type="button" class="close" aria-label={copy.close}>&times;</button>

			<div class="court">
				<canvas width="960" height="620"></canvas>
				<p class="overlay" data-overlay>{copy.serve}</p>
			</div>

			<p class="hint">{copy.hint}</p>
		</div>
	</dialog>
</tennis-game>

<script>
	/** Canvas units. The stands fill the frame; the court sits inside them. */
	const W = 960;
	const H = 620;
	const COURT_W = 660;
	const COURT_H = Math.round(COURT_W / 2.1667); // 23.77m × 10.97m
	const COURT_X = Math.round((W - COURT_W) / 2);
	const COURT_Y = Math.round((H - COURT_H) / 2);
	const APRON_X = 86; // run-off between the court and the front row
	const APRON_Y = 62;
	const ALLEY = COURT_H * 0.125;
	const SERVICE = COURT_W * 0.269;

	const PADDLE_W = 11;
	const PADDLE_H = 84;
	const PADDLE_INSET = 20;
	const BALL_R = 8;

	const BASE_SPEED = 430; // px per second
	const MAX_SPEED = 1000;
	const PLAYER_SPEED = 640;
	const CPU_SPEED = 440;

	/**
	 * What makes each stadium itself: the bowl's corners, how the tiers are
	 * split, where the accent seating runs, and the name on the back wall.
	 */
	const VENUES = {
		usopen: {
			venue: 'Arthur Ashe Stadium',
			corner: 16, // a big square bowl
			tier: 0.46,
			accentBand: 'lower', // the blue ring under the upper tier
			roof: true,
		},
		ao: {
			venue: 'Rod Laver Arena',
			corner: 46, // rounded, almost oval
			tier: 0.44,
			accentBand: 'upper',
			roof: true,
		},
		rg: {
			venue: 'Court Philippe-Chatrier',
			corner: 8, // the rectangle in the Bois de Boulogne
			tier: 0.4,
			accentBand: 'none',
			roof: true,
		},
		wimbledon: {
			venue: 'Centre Court',
			corner: 30,
			tier: 0.42,
			accentBand: 'lower', // the club's purple in the seats
			roof: true,
		},
	} as const;

	type Side = 'player' | 'cpu';
	type Scores = { player: number; cpu: number };

	class TennisGame extends HTMLElement {
		constructor() {
			super();

			const dialog = this.querySelector<HTMLDialogElement>('dialog')!;
			const canvas = this.querySelector<HTMLCanvasElement>('canvas')!;
			const overlay = this.querySelector<HTMLElement>('[data-overlay]')!;
			const context = canvas.getContext('2d')!;

			const out = {
				playerPoint: this.querySelector<HTMLElement>('[data-player-point]')!,
				cpuPoint: this.querySelector<HTMLElement>('[data-cpu-point]')!,
				playerGames: this.querySelector<HTMLElement>('[data-player-games]')!,
				cpuGames: this.querySelector<HTMLElement>('[data-cpu-games]')!,
				servingPlayer: this.querySelector<HTMLElement>('[data-serving-player]')!,
				servingCpu: this.querySelector<HTMLElement>('[data-serving-cpu]')!,
				tournament: this.querySelector<HTMLElement>('[data-tournament]')!,
				venue: this.querySelector<HTMLElement>('[data-venue]')!,
			};

			const text = {
				serve: this.dataset.serve ?? '',
				youWin: this.dataset.youWin ?? '',
				cpuWin: this.dataset.cpuWin ?? '',
				again: this.dataset.again ?? '',
				deuce: this.dataset.deuce ?? '',
			};
			const names: Record<string, string> = JSON.parse(this.dataset.names ?? '{}');

			const currentSlam = () => {
				const id = document.documentElement.dataset.slam ?? 'usopen';
				return (id in VENUES ? id : 'usopen') as keyof typeof VENUES;
			};

			/** Palette, read from the page so the stadium matches the theme. */
			let colors = readColors();
			function readColors() {
				const style = getComputedStyle(document.documentElement);
				const value = (name: string, fallback: string) =>
					style.getPropertyValue(name).trim() || fallback;
				return {
					surface: value('--court-surface', '#2f6cb5'),
					apron: value('--court-apron', '#1d4f8c'),
					line: value('--court-line', '#ffffff'),
					net: value('--court-net', 'rgba(255,255,255,0.62)'),
					stand: value('--stand', '#0e2a4d'),
					seat: value('--stand-seat', '#16406f'),
					accent: value('--stand-accent', '#0057b8'),
					player: value('--accent-regular', '#0057b8'),
				};
			}

			/**
			 * Everything that never moves — bowl, crowd, court, umpire — is
			 * painted once into this layer and blitted each frame.
			 */
			let scene: HTMLCanvasElement | null = null;

			function paintScene() {
				const venue = VENUES[currentSlam()];
				const layer = document.createElement('canvas');
				layer.width = W;
				layer.height = H;
				const paint = layer.getContext('2d')!;

				// Deterministic crowd: the same house every time the door opens.
				let seed = 20260913;
				const random = () => {
					seed = (seed * 1664525 + 1013904223) % 4294967296;
					return seed / 4294967296;
				};

				// ── The bowl ────────────────────────────────────────────────
				// Roof and outer structure, then two tiers of seating rings
				// with a concourse between them, each one painted as a block
				// and then filled with a crowd.
				paint.fillStyle = shade(colors.stand, -0.45);
				paint.fillRect(0, 0, W, H);

				const outer = { x: 8, y: 6, w: W - 16, h: H - 12 };
				const front = {
					x: COURT_X - APRON_X,
					y: COURT_Y - APRON_Y,
					w: COURT_W + APRON_X * 2,
					h: COURT_H + APRON_Y * 2,
				};
				// The upper tier reaches this far in from the outer wall.
				const split = {
					x: outer.x + (front.x - outer.x) * venue.tier,
					y: outer.y + (front.y - outer.y) * venue.tier,
					w: 0,
					h: 0,
				};
				split.w = outer.w - (split.x - outer.x) * 2;
				split.h = outer.h - (split.y - outer.y) * 2;
				const concourse = inset(split, 14);

				roundRect(paint, outer, venue.corner + 16, shade(colors.seat, -0.4));
				seats(paint, outer, split, venue.accentBand === 'upper', random);

				// Concourse: the dark gap that separates the two tiers.
				roundRect(paint, split, venue.corner + 8, shade(colors.stand, -0.2));
				roundRect(paint, concourse, venue.corner + 6, shade(colors.seat, -0.2));
				seats(paint, concourse, front, venue.accentBand === 'lower', random);

				// The rail along the front row.
				paint.strokeStyle = 'rgba(255, 255, 255, 0.18)';
				paint.lineWidth = 2;
				paint.beginPath();
				paint.roundRect(front.x - 5, front.y - 5, front.w + 10, front.h + 10, 8);
				paint.stroke();

				// ── Back wall, with the venue's name on it ──────────────────
				const wall = { x: front.x, y: front.y - 34, w: front.w, h: 30 };
				roundRect(paint, wall, 4, shade(colors.stand, -0.4));
				paint.fillStyle = 'rgba(255, 255, 255, 0.72)';
				paint.font = '600 13px Rubik, system-ui, sans-serif';
				paint.textAlign = 'center';
				paint.textBaseline = 'middle';
				paint.letterSpacing = '3px';
				paint.fillText(venue.venue.toUpperCase(), W / 2, wall.y + wall.h / 2);
				paint.letterSpacing = '0px';

				// ── Run-off and court ───────────────────────────────────────
				roundRect(paint, front, 6, colors.apron);
				paint.fillStyle = colors.surface;
				paint.fillRect(COURT_X, COURT_Y, COURT_W, COURT_H);

				paint.strokeStyle = colors.line;
				paint.lineWidth = 3;
				paint.strokeRect(COURT_X, COURT_Y, COURT_W, COURT_H);
				const net = COURT_X + COURT_W / 2;
				const lines: [number, number, number, number][] = [
					[COURT_X, COURT_Y + ALLEY, COURT_X + COURT_W, COURT_Y + ALLEY],
					[COURT_X, COURT_Y + COURT_H - ALLEY, COURT_X + COURT_W, COURT_Y + COURT_H - ALLEY],
					[net - SERVICE, COURT_Y + ALLEY, net - SERVICE, COURT_Y + COURT_H - ALLEY],
					[net + SERVICE, COURT_Y + ALLEY, net + SERVICE, COURT_Y + COURT_H - ALLEY],
					[net - SERVICE, COURT_Y + COURT_H / 2, net + SERVICE, COURT_Y + COURT_H / 2],
					[COURT_X, COURT_Y + COURT_H / 2, COURT_X + 14, COURT_Y + COURT_H / 2],
					[COURT_X + COURT_W - 14, COURT_Y + COURT_H / 2, COURT_X + COURT_W, COURT_Y + COURT_H / 2],
				];
				for (const [x1, y1, x2, y2] of lines) {
					paint.beginPath();
					paint.moveTo(x1, y1);
					paint.lineTo(x2, y2);
					paint.stroke();
				}

				// Net, strung between posts outside the doubles lines.
				paint.strokeStyle = colors.net;
				paint.lineWidth = 5;
				paint.setLineDash([9, 7]);
				paint.beginPath();
				paint.moveTo(net, COURT_Y - 16);
				paint.lineTo(net, COURT_Y + COURT_H + 16);
				paint.stroke();
				paint.setLineDash([]);
				paint.fillStyle = colors.line;
				dot(paint, net, COURT_Y - 16, 4);
				dot(paint, net, COURT_Y + COURT_H + 16, 4);

				// ── The officials ───────────────────────────────────────────
				// Umpire's chair at the net, ball kids at the posts, line judges
				// behind the baselines.
				paint.fillStyle = shade(colors.stand, -0.25);
				paint.fillRect(net - 11, COURT_Y - APRON_Y + 14, 22, 30);
				paint.fillStyle = 'rgba(255, 255, 255, 0.8)';
				dot(paint, net, COURT_Y - APRON_Y + 22, 5);

				paint.fillStyle = 'rgba(255, 255, 255, 0.55)';
				for (const [x, y] of [
					[COURT_X - 34, COURT_Y - 26],
					[COURT_X - 34, COURT_Y + COURT_H + 26],
					[COURT_X + COURT_W + 34, COURT_Y - 26],
					[COURT_X + COURT_W + 34, COURT_Y + COURT_H + 26],
					[net - 26, COURT_Y + COURT_H + APRON_Y - 18],
					[net + 26, COURT_Y + COURT_H + APRON_Y - 18],
				] as [number, number][]) {
					dot(paint, x, y, 4.5);
				}

				scene = layer;
			}

			/**
			 * Fills the ring between `from` and `to` with a packed crowd: rows
			 * of heads, gangways cut through them, and — where the venue has
			 * one — a band of seats in the tournament's own colour.
			 */
			function seats(
				paint: CanvasRenderingContext2D,
				from: { x: number; y: number; w: number; h: number },
				to: { x: number; y: number; w: number; h: number },
				accented: boolean,
				random: () => number
			) {
				const step = 6;
				for (let y = from.y + 5; y < from.y + from.h - 3; y += step) {
					for (let x = from.x + 5; x < from.x + from.w - 3; x += step) {
						const inside =
							x > to.x - 3 && x < to.x + to.w + 3 && y > to.y - 3 && y < to.y + to.h + 3;
						if (inside) continue;

						// Gangways up through the stand, every so many rows.
						if ((x - from.x) % 84 < 6 || (y - from.y) % 84 < 6) continue;

						const roll = random();
						if (roll < 0.12) continue; // an empty seat

						// A block of the tournament's own colour runs through the
						// tier where the venue has one.
						const band = accented && (y - from.y) % 66 < 12;
						paint.fillStyle = band
							? roll > 0.5
								? colors.accent
								: shade(colors.accent, 0.25)
							: roll > 0.78
								? shade(colors.seat, 0.55) // a shirt catching the light
								: roll > 0.55
									? shade(colors.seat, 0.28)
									: roll > 0.3
										? colors.seat
										: shade(colors.seat, -0.25);
						paint.beginPath();
						paint.arc(x + random(), y + random(), 1.9, 0, Math.PI * 2);
						paint.fill();
					}
				}
			}

			function roundRect(
				paint: CanvasRenderingContext2D,
				box: { x: number; y: number; w: number; h: number },
				radius: number,
				fill: string
			) {
				paint.fillStyle = fill;
				paint.beginPath();
				paint.roundRect(box.x, box.y, box.w, box.h, radius);
				paint.fill();
			}

			function inset(box: { x: number; y: number; w: number; h: number }, by: number) {
				return { x: box.x + by, y: box.y + by, w: box.w - by * 2, h: box.h - by * 2 };
			}

			function dot(paint: CanvasRenderingContext2D, x: number, y: number, r: number) {
				paint.beginPath();
				paint.arc(x, y, r, 0, Math.PI * 2);
				paint.fill();
			}

			/** Mixes a hex colour towards white (positive) or black (negative). */
			function shade(hex: string, amount: number) {
				const match = /^#?([\da-f]{6})$/i.exec(hex.trim());
				if (!match) return hex;
				const value = parseInt(match[1]!, 16);
				const mix = (channel: number) =>
					Math.round(
						amount >= 0 ? channel + (255 - channel) * amount : channel * (1 + amount)
					);
				return `rgb(${mix((value >> 16) & 255)}, ${mix((value >> 8) & 255)}, ${mix(value & 255)})`;
			}

			let playerY = (H - PADDLE_H) / 2;
			let cpuY = playerY;
			let ball = { x: W / 2, y: H / 2, vx: 0, vy: 0 };
			let points: Scores = { player: 0, cpu: 0 };
			let games: Scores = { player: 0, cpu: 0 };
			let serving = true;
			let over = false;
			let server: Side = 'player';
			let frame = 0;
			let last = 0;
			let pointerY: number | null = null;
			const keys = new Set<string>();

			const LADDER = ['0', '15', '30', '40'];
			function pointLabel(mine: number, theirs: number) {
				if (mine < 3 || theirs < 3) return LADDER[Math.min(mine, 3)]!;
				if (mine === theirs) return '40';
				return mine > theirs ? 'AD' : '40';
			}

			function paintScore() {
				out.playerPoint.textContent = pointLabel(points.player, points.cpu);
				out.cpuPoint.textContent = pointLabel(points.cpu, points.player);
				out.playerGames.textContent = String(games.player);
				out.cpuGames.textContent = String(games.cpu);
				out.servingPlayer.classList.toggle('on', server === 'player');
				out.servingCpu.classList.toggle('on', server === 'cpu');

				const slam = currentSlam();
				out.tournament.textContent = names[slam] ?? '';
				out.venue.textContent = VENUES[slam].venue;
			}

			function serve() {
				const toward = server === 'player' ? -1 : 1;
				ball = {
					x: W / 2,
					y: H / 2,
					vx: BASE_SPEED * toward,
					vy: BASE_SPEED * (Math.random() * 0.5 - 0.25),
				};
				serving = false;
				overlay.hidden = true;
			}

			function awardPoint(to: Side) {
				const other: Side = to === 'player' ? 'cpu' : 'player';
				points[to] += 1;

				if (points[to] >= 4 && points[to] - points[other] >= 2) {
					games[to] += 1;
					points = { player: 0, cpu: 0 };
					server = server === 'player' ? 'cpu' : 'player';
				}

				paintScore();

				if (games[to] >= 4) {
					over = true;
					serving = true;
					overlay.innerHTML = `<strong>${to === 'player' ? text.youWin : text.cpuWin}</strong><span>${text.again}</span>`;
					overlay.hidden = false;
					return;
				}

				serving = true;
				ball = { x: W / 2, y: H / 2, vx: 0, vy: 0 };
				overlay.textContent =
					points.player >= 3 && points.player === points.cpu ? text.deuce : text.serve;
				overlay.hidden = false;
			}

			function reset() {
				points = { player: 0, cpu: 0 };
				games = { player: 0, cpu: 0 };
				server = 'player';
				over = false;
				serving = true;
				ball = { x: W / 2, y: H / 2, vx: 0, vy: 0 };
				playerY = cpuY = (H - PADDLE_H) / 2;
				paintScore();
				overlay.textContent = text.serve;
				overlay.hidden = false;
			}

			function step(seconds: number) {
				if (pointerY !== null) {
					playerY = pointerY - PADDLE_H / 2;
				} else {
					if (keys.has('ArrowUp') || keys.has('w') || keys.has('W')) {
						playerY -= PLAYER_SPEED * seconds;
					}
					if (keys.has('ArrowDown') || keys.has('s') || keys.has('S')) {
						playerY += PLAYER_SPEED * seconds;
					}
				}
				playerY = clamp(playerY, COURT_Y, COURT_Y + COURT_H - PADDLE_H);

				// The machine chases the ball, but only so fast, and recovers to
				// the middle while the ball is travelling away from it.
				const chasing = ball.vx > 0;
				const target = chasing ? ball.y - PADDLE_H / 2 : COURT_Y + (COURT_H - PADDLE_H) / 2;
				const reach = CPU_SPEED * seconds * (chasing ? 1 : 0.55);
				cpuY = clamp(
					cpuY + clamp(target - cpuY, -reach, reach),
					COURT_Y,
					COURT_Y + COURT_H - PADDLE_H
				);

				if (serving) return;

				ball.x += ball.vx * seconds;
				ball.y += ball.vy * seconds;

				if (ball.y - BALL_R <= COURT_Y && ball.vy < 0) {
					ball.y = COURT_Y + BALL_R;
					ball.vy *= -1;
				}
				if (ball.y + BALL_R >= COURT_Y + COURT_H && ball.vy > 0) {
					ball.y = COURT_Y + COURT_H - BALL_R;
					ball.vy *= -1;
				}

				const playerX = COURT_X + PADDLE_INSET;
				const cpuX = COURT_X + COURT_W - PADDLE_INSET - PADDLE_W;

				if (
					ball.vx < 0 &&
					ball.x - BALL_R <= playerX + PADDLE_W &&
					ball.x - BALL_R >= playerX - 14 &&
					ball.y >= playerY &&
					ball.y <= playerY + PADDLE_H
				) {
					returnBall(playerX + PADDLE_W + BALL_R, playerY, 1);
				}

				if (
					ball.vx > 0 &&
					ball.x + BALL_R >= cpuX &&
					ball.x + BALL_R <= cpuX + PADDLE_W + 14 &&
					ball.y >= cpuY &&
					ball.y <= cpuY + PADDLE_H
				) {
					returnBall(cpuX - BALL_R, cpuY, -1);
				}

				if (ball.x < COURT_X - 70) awardPoint('cpu');
				else if (ball.x > COURT_X + COURT_W + 70) awardPoint('player');
			}

			/** Where the ball meets the racket decides the angle back. */
			function returnBall(x: number, paddleY: number, direction: 1 | -1) {
				const offset = (ball.y - (paddleY + PADDLE_H / 2)) / (PADDLE_H / 2);
				const speed = Math.min(Math.hypot(ball.vx, ball.vy) * 1.05, MAX_SPEED);
				const angle = offset * 0.9;
				ball.x = x;
				ball.vx = Math.cos(angle) * speed * direction;
				ball.vy = Math.sin(angle) * speed;
			}

			function draw() {
				if (scene) context.drawImage(scene, 0, 0);

				// Deliberately not the theme colours: these two have to stay
				// apart from each other on clay, grass and blue alike.
				paddle(COURT_X + PADDLE_INSET, playerY, '#11202b');
				paddle(COURT_X + COURT_W - PADDLE_INSET - PADDLE_W, cpuY, '#f2f5f8');

				// The ball is yellow on every court there is.
				context.fillStyle = '#d8f000';
				dot(context, ball.x, ball.y, BALL_R);
				context.strokeStyle = 'rgba(255, 255, 255, 0.85)';
				context.lineWidth = 1.5;
				context.beginPath();
				context.arc(ball.x, ball.y, BALL_R - 2.5, Math.PI * 0.75, Math.PI * 1.45);
				context.stroke();
			}

			function paddle(x: number, y: number, color: string) {
				context.fillStyle = color;
				context.beginPath();
				context.roundRect(x, y, PADDLE_W, PADDLE_H, 5);
				context.fill();
			}

			function loop(now: number) {
				const seconds = Math.min((now - last) / 1000, 1 / 30);
				last = now;
				step(seconds);
				draw();
				frame = requestAnimationFrame(loop);
			}

			function start() {
				last = performance.now();
				frame = requestAnimationFrame(loop);
			}

			function stop() {
				cancelAnimationFrame(frame);
			}

			function clamp(value: number, min: number, max: number) {
				return Math.max(min, Math.min(max, value));
			}

			function refresh() {
				colors = readColors();
				paintScene();
				paintScore();
			}

			// The stadium follows the theme and the tournament, even mid-match.
			new MutationObserver(() => {
				if (dialog.open) refresh();
			}).observe(document.documentElement, {
				attributes: true,
				attributeFilter: ['class', 'data-slam'],
			});

			// ── Wiring ────────────────────────────────────────────────────
			this.querySelector<HTMLButtonElement>('.open')!.addEventListener('click', () => {
				refresh();
				reset();
				dialog.showModal();
				start();
			});

			this.querySelector<HTMLButtonElement>('.close')!.addEventListener('click', () => dialog.close());
			dialog.addEventListener('close', stop);
			dialog.addEventListener('click', (event) => {
				if (event.target === dialog) dialog.close();
			});

			const serveOrRestart = () => {
				if (over) reset();
				else if (serving) serve();
			};

			canvas.addEventListener('pointerdown', (event) => {
				track(event);
				serveOrRestart();
			});
			canvas.addEventListener('pointermove', track);
			canvas.addEventListener('pointerleave', () => {
				pointerY = null;
			});

			function track(event: PointerEvent) {
				const box = canvas.getBoundingClientRect();
				pointerY = ((event.clientY - box.top) / box.height) * H;
			}

			dialog.addEventListener('keydown', (event: KeyboardEvent) => {
				if (event.key === ' ' || event.key === 'Enter') {
					event.preventDefault();
					serveOrRestart();
					return;
				}
				if (['ArrowUp', 'ArrowDown', 'w', 'W', 's', 'S'].includes(event.key)) {
					event.preventDefault();
					pointerY = null; // hand control back to the keyboard
					keys.add(event.key);
				}
			});
			dialog.addEventListener('keyup', (event: KeyboardEvent) => keys.delete(event.key));

			// A tab sent to the background should not bank a walkover.
			document.addEventListener('visibilitychange', () => {
				if (!dialog.open) return;
				if (document.hidden) stop();
				else start();
			});

			paintScore();
		}
	}

	customElements.define('tennis-game', TennisGame);
</script>

