---
/**
 * A match against the machine, played in whichever Grand Slam's stadium the
 * site is currently wearing (src/lib/slam.ts) — and, since the surface and
 * the scoring are the tournament's, played the way that tournament plays.
 *
 * Pong is still underneath it, but the racket now has two halves. Meet the
 * ball on the one nearer your hitting side and it is a forehand; on the other
 * and it is a backhand, which is exactly the asymmetry the whole sport is
 * organised around. Swing through the ball for topspin, pull off it for
 * slice. Serve by winding up and letting go: too much and it is a fault,
 * twice and it is a double fault.
 *
 * Around the match sits a career: you enter the draw at the round your
 * ranking earns, rounds pay ranking points and prize money, and the money
 * buys the six things a coach would work on. All of that lives in
 * src/lib/tennis/, along with the surfaces, the stat sheet and the copy.
 *
 * The button lives in the footer; the game is a modal dialog, so the canvas
 * and its loop exist once per page and only run while it is open.
 */
import { getLangFromUrl } from '../i18n/utils';
import { copy as allCopy } from '../lib/tennis/copy';

const lang = getLangFromUrl(Astro.url);
const copy = allCopy[lang];

/** Where a winner is sent to gloat. Same profile the nav and the card link to. */
const LINKEDIN = 'https://www.linkedin.com/in/johannes-gnadlinger-842293271';
---

<tennis-game class="tennis" data-lang={lang}>
	<button type="button" class="open">
		<svg class="ball" viewBox="0 0 24 24" aria-hidden="true">
			<circle cx="12" cy="12" r="9"></circle>
			<path d="M4.2 6.2A9 9 0 0 1 9.6 20.5"></path>
			<path d="M19.8 6.2A9 9 0 0 0 14.4 20.5"></path>
		</svg>
		{copy.play}
	</button>

	<dialog class="stage" aria-label={copy.title}>
		<div class="frame">
			<!-- The tournament's own board: name, round, server, games, points. -->
			<div class="board" data-board data-format="match">
				<div class="brand">
					<span class="tournament" data-tournament>US Open</span>
					<span class="venue" data-venue></span>
					<span class="standing" data-standing></span>
					<span class="format" data-format-label>{copy.tiebreak}</span>
				</div>
				<div class="rows">
					<div class="row">
						<span class="serving" data-serving-player aria-hidden="true"></span>
						<button type="button" class="name editable" data-rename title={copy.change}>
							<span data-player-name>{copy.you}</span>
						</button>
						<span class="games" data-player-games>0</span>
						<span class="points" data-player-point>0</span>
					</div>
					<div class="row">
						<span class="serving" data-serving-cpu aria-hidden="true"></span>
						<span class="name">{copy.opponent}</span>
						<span class="games" data-cpu-games>0</span>
						<span class="points" data-cpu-point>0</span>
					</div>
				</div>

				<div class="gauges">
					<!-- How much is left in the legs, and what the last serve was
					     clocked at: the two numbers a broadcast keeps on screen. -->
					<div class="fitness" title={copy.fitness}>
						<span class="fitness-bar"><span data-fitness></span></span>
					</div>
					<span class="speed" data-serve-speed></span>
					<button type="button" class="chip" data-career-open>{copy.careerButton}</button>
				</div>

				<button type="button" class="close" aria-label={copy.close}>&times;</button>
			</div>

			<div class="court">
				<canvas width="960" height="620"></canvas>
				<p class="overlay" data-overlay>{copy.serve}</p>

				<!-- The end of a match: what it did to the career, how it was
				     won, and — for a win — a card worth keeping. -->
				<div class="result" data-result hidden>
					<div class="result-body">
						<div class="result-main">
							<p class="result-head" data-result-head></p>
							<img class="result-card" data-result-image alt="" hidden />
							<p class="result-earned" data-result-earned></p>
						</div>
						<div class="result-stats">
							<h3 class="panel-title">{copy.statsTitle}</h3>
							<table class="stats">
								<thead>
									<tr>
										<th scope="col" data-stats-player>{copy.statsYou}</th>
										<th scope="col"></th>
										<th scope="col">{copy.opponent}</th>
									</tr>
								</thead>
								<tbody data-stats-body></tbody>
							</table>
						</div>
					</div>
					<div class="result-actions">
						<button type="button" class="act primary" data-next>{copy.nextMatch}</button>
						<button type="button" class="act" data-save hidden>{copy.saveImage}</button>
						<button type="button" class="act" data-share hidden>{copy.share}</button>
						<a
							class="act"
							data-linkedin
							href={LINKEDIN}
							target="_blank"
							rel="noopener noreferrer"
							hidden>{copy.sendLinkedIn}</a>
						<button type="button" class="act ghost" data-career-from-result
							>{copy.careerButton}</button
						>
					</div>
					<p class="result-note" data-result-note role="status" aria-live="polite"></p>
				</div>

				<!-- The career: the ranking, the money, and the six things the
				     money is spent on. Built in script from src/lib/tennis. -->
				<div class="career" data-career hidden>
					<div class="career-head">
						<h3 class="panel-title">{copy.careerTitle}</h3>
						<dl class="career-figures" data-career-figures></dl>
					</div>
					<div class="career-body" data-career-body></div>
					<div class="career-foot">
						<p class="career-note">{copy.careerNote}</p>
						<div class="career-actions">
							<button type="button" class="act ghost" data-career-reset
								>{copy.resetCareer}</button
							>
							<button type="button" class="act primary" data-career-done>{copy.done}</button>
						</div>
					</div>
				</div>

				<!-- The card for the match: who is on the other side of the net. -->
				<form class="entry" data-entry hidden>
					<label class="entry-label" for="tennis-player-name">{copy.entry}</label>
					<div class="entry-row">
						<input
							id="tennis-player-name"
							class="entry-input"
							data-name-input
							type="text"
							maxlength="14"
							autocomplete="off"
							spellcheck="false"
							placeholder={copy.you}
							aria-label={copy.yourName}
						/>
						<button type="submit" class="entry-go">{copy.start}</button>
					</div>
				</form>
			</div>

			<p class="hint" data-hint-label>{copy.hint}</p>
		</div>
	</dialog>
</tennis-game>

<script>
	import {
		W,
		H,
		COURT_W,
		COURT_H,
		COURT_X,
		COURT_Y,
		COURT_MID,
		NET_X,
		APRON_X,
		APRON_Y,
		ALLEY,
		SERVICE,
		PADDLE_W,
		PADDLE_H,
		PADDLE_INSET,
		BALL_R,
		BASE_SPEED,
		MAX_SPEED,
		PLAYER_SPEED,
		SERVE_MIN,
		SERVE_MAX,
		SERVE_KMH,
		CHARGE_SECONDS,
		SECOND_SERVE_CHARGE,
		clamp,
		forehandBelow,
		other,
		wingFor,
		type Hand,
		type Shot,
		type Side,
		type Wing,
	} from '../lib/tennis/court';
	import { VENUES, paceLabel, type VenueId } from '../lib/tennis/venues';
	import {
		BRANCHES,
		CHAMPION,
		ROUNDS,
		available,
		clearCareer,
		entryRound,
		formatPrize,
		formatRank,
		freshCareer,
		loadCareer,
		nodesIn,
		opponentFor,
		ratingsFor,
		saveCareer,
		seedFor,
		type BackhandStyle,
		type Career,
		type Ratings,
		type SkillNode,
	} from '../lib/tennis/career';
	import { cardLine, freshStats, summarise, type MatchStats } from '../lib/tennis/stats';
	import { copy as allCopy } from '../lib/tennis/copy';
	import { SITE_ORIGIN } from '../lib/schema';
	import { slams } from '../lib/slam';

	/** The one player who is never the visitor. Right-handed, like most of them. */
	const CPU_HAND: Hand = 'right';

	/** Tournament names for the board, keyed by the `data-slam` attribute. */
	const names = Object.fromEntries(slams.map((slam) => [slam.id, slam.name]));

	type Scores = { player: number; cpu: number };
	/** Where a point is: winding up, the serve in the air, or a rally. */
	type Phase = 'serve' | 'flight' | 'rally';

	class TennisGame extends HTMLElement {
		constructor() {
			super();

			const dialog = this.querySelector<HTMLDialogElement>('dialog')!;
			const canvas = this.querySelector<HTMLCanvasElement>('canvas')!;
			const overlay = this.querySelector<HTMLElement>('[data-overlay]')!;
			const entry = this.querySelector<HTMLFormElement>('[data-entry]')!;
			const nameInput = this.querySelector<HTMLInputElement>('[data-name-input]')!;
			const courtBox = this.querySelector<HTMLElement>('.court')!;
			const context = canvas.getContext('2d')!;

			const out = {
				playerPoint: this.querySelector<HTMLElement>('[data-player-point]')!,
				cpuPoint: this.querySelector<HTMLElement>('[data-cpu-point]')!,
				playerGames: this.querySelector<HTMLElement>('[data-player-games]')!,
				cpuGames: this.querySelector<HTMLElement>('[data-cpu-games]')!,
				servingPlayer: this.querySelector<HTMLElement>('[data-serving-player]')!,
				servingCpu: this.querySelector<HTMLElement>('[data-serving-cpu]')!,
				tournament: this.querySelector<HTMLElement>('[data-tournament]')!,
				venue: this.querySelector<HTMLElement>('[data-venue]')!,
				standing: this.querySelector<HTMLElement>('[data-standing]')!,
				board: this.querySelector<HTMLElement>('[data-board]')!,
				hint: this.querySelector<HTMLElement>('[data-hint-label]')!,
				playerName: this.querySelector<HTMLElement>('[data-player-name]')!,
				fitness: this.querySelector<HTMLElement>('[data-fitness]')!,
				serveSpeed: this.querySelector<HTMLElement>('[data-serve-speed]')!,
			};

			const lang = this.dataset.lang === 'de' ? 'de' : 'en';
			const text = allCopy[lang];
			const locale = lang === 'de' ? 'de-AT' : 'en-GB';
			const host = SITE_ORIGIN.replace('https://', '');
			const opponentName = text.opponent;

			/**
			 * Who is at this end of the court. Kept in localStorage so a
			 * returning visitor is still on the scoreboard, and editable from
			 * the board itself.
			 */
			const NAME_KEY = 'tennis-player';

			function readName() {
				try {
					return (localStorage.getItem(NAME_KEY) ?? '').trim();
				} catch {
					return '';
				}
			}

			function storeName(value: string) {
				try {
					if (value) localStorage.setItem(NAME_KEY, value);
					else localStorage.removeItem(NAME_KEY);
				} catch {
					// Private mode: the name lasts for this visit only.
				}
			}

			let playerName = readName();
			const displayName = () => playerName || text.you;

			// ── The career ────────────────────────────────────────────────
			let career: Career = loadCareer();
			let ratings: Ratings = ratingsFor(career);
			let opponent = opponentFor(career.round);
			/** What this match has paid so far, for the panel at the end of it. */
			let award = { points: 0, prize: 0 };

			const currentSlam = (): VenueId => {
				const id = document.documentElement.dataset.slam ?? 'usopen';
				return (id in VENUES ? id : 'usopen') as VenueId;
			};
			const venue = () => VENUES[currentSlam()];

			/** Money into the bank, points onto the ranking, and remember both. */
			function bank(points: number, prize: number) {
				career.points += points;
				career.prize += prize;
				career.earned += prize;
				award.points += points;
				award.prize += prize;
			}

			/** A draw is entered once, and the first cheque comes with the entry. */
			function enterDraw() {
				if (career.entered) return;
				const round = ROUNDS[Math.min(career.round, entryRound(career.points))]!;
				bank(round.points, round.prize);
				career.entered = true;
				saveCareer(career);
			}

			function newDraw() {
				career.round = entryRound(career.points);
				career.entered = false;
			}

			/**
			 * What a result did to the career. A win is one round further in —
			 * and the round's own money, less what the last one already paid.
			 * A loss is the end of the tournament, and the next one starts
			 * wherever the ranking now puts you.
			 */
			function finishMatch(playerWon: boolean) {
				const at = career.round;
				if (playerWon) {
					const next = at + 1;
					bank(ROUNDS[next]!.points - ROUNDS[at]!.points, ROUNDS[next]!.prize - ROUNDS[at]!.prize);
					career.won += 1;
					career.best = Math.max(career.best, next);
					if (next >= CHAMPION) {
						career.titles += 1;
						newDraw();
					} else {
						career.round = next;
					}
				} else {
					newDraw();
				}
				saveCareer(career);
				opponent = opponentFor(career.round);
			}

			// ── The winner's card ─────────────────────────────────────────
			const result = this.querySelector<HTMLElement>('[data-result]')!;
			const resultImage = this.querySelector<HTMLImageElement>('[data-result-image]')!;
			const resultHead = this.querySelector<HTMLElement>('[data-result-head]')!;
			const resultEarned = this.querySelector<HTMLElement>('[data-result-earned]')!;
			const resultNote = this.querySelector<HTMLElement>('[data-result-note]')!;
			const statsBody = this.querySelector<HTMLElement>('[data-stats-body]')!;
			const statsPlayer = this.querySelector<HTMLElement>('[data-stats-player]')!;
			const nextButton = this.querySelector<HTMLButtonElement>('[data-next]')!;
			const saveButton = this.querySelector<HTMLButtonElement>('[data-save]')!;
			const shareButton = this.querySelector<HTMLButtonElement>('[data-share]')!;
			const linkedInLink = this.querySelector<HTMLAnchorElement>('[data-linkedin]')!;
			/** The round the card being painted is for. */
			let cardRound = 0;
			const card = document.createElement('canvas');
			card.width = 1200;
			card.height = 630; // the ratio every social preview crops to

			/** The score as it goes on the card: games for a match, points for a tie-break. */
			const scoreLine = () =>
				format === 'tiebreak' ? `${points.player}–${points.cpu}` : `${games.player}–${games.cpu}`;

			/** Shrinks the font until the text fits the width it is given. */
			function fitText(
				paint: CanvasRenderingContext2D,
				value: string,
				weight: string,
				start: number,
				maxWidth: number
			) {
				let size = start;
				do {
					paint.font = `${weight} ${size}px Rubik, system-ui, sans-serif`;
					size -= 2;
				} while (paint.measureText(value).width > maxWidth && size > 20);
			}

			function paintCard() {
				const paint = card.getContext('2d')!;
				const here = venue();
				const { width, height } = card;

				paint.fillStyle = shade(colors.stand, -0.2);
				paint.fillRect(0, 0, width, height);

				// The stadium behind the result — held back on the left, where
				// the text sits, and left to show on the right, which is what
				// makes a clay card look like clay and a grass one like grass.
				if (scene) {
					paint.drawImage(scene, 0, 0, scene.width, scene.height, 60, -30, width, 700);
					const veil = paint.createLinearGradient(0, 0, width, 0);
					veil.addColorStop(0, 'rgba(6, 14, 24, 0.92)');
					veil.addColorStop(0.48, 'rgba(6, 14, 24, 0.78)');
					veil.addColorStop(1, 'rgba(6, 14, 24, 0.18)');
					paint.fillStyle = veil;
					paint.fillRect(0, 0, width, height);
				}

				// The tournament's stripe across the top.
				paint.fillStyle = colors.ink;
				paint.fillRect(0, 0, width, 10);

				const left = 72;
				paint.textAlign = 'left';
				paint.textBaseline = 'alphabetic';

				paint.fillStyle = colors.ink;
				paint.letterSpacing = '6px';
				paint.font = '600 26px Rubik, system-ui, sans-serif';
				paint.fillText((names[currentSlam()] ?? '').toUpperCase(), left, 92);
				paint.letterSpacing = '0px';

				paint.fillStyle = 'rgba(255, 255, 255, 0.62)';
				paint.font = '400 24px Rubik, system-ui, sans-serif';
				paint.fillText(`${here.venue} · ${here.surface[lang]}`, left, 128);

				// The round this match won, which is the thing worth boasting about.
				const round = ROUNDS[clamp(cardRound, 0, CHAMPION)]!;
				paint.fillStyle = 'rgba(255, 255, 255, 0.68)';
				paint.letterSpacing = '10px';
				paint.font = '600 22px Rubik, system-ui, sans-serif';
				paint.fillText(
					(cardRound >= CHAMPION ? text.champion : round.name[lang]).toUpperCase(),
					left,
					220
				);
				paint.letterSpacing = '0px';

				paint.fillStyle = '#ffffff';
				fitText(paint, displayName(), '700', 92, width - left * 2 - 120);
				paint.fillText(displayName(), left, 314);

				paint.fillStyle = colors.ink;
				paint.fillRect(left, 332, 96, 6);

				// … beat Gnadlinger 4–2.
				const line = text.beat.replace('%o', opponentName).replace('%s', scoreLine());
				paint.fillStyle = 'rgba(255, 255, 255, 0.92)';
				fitText(paint, line, '400', 38, width - left * 2 - 120);
				paint.fillText(line, left, 394);

				// The stat line under it: how the match was actually won.
				const summary = cardLine(stats, 'player', lang);
				if (summary) {
					paint.fillStyle = 'rgba(255, 255, 255, 0.72)';
					fitText(paint, summary, '400', 26, width - left * 2 - 120);
					paint.fillText(summary, left, 438);
				}

				// The ranking the win is worth, and the tie-break chip if it was one.
				let chipX = left;
				const chip = (label: string, y: number) => {
					paint.font = '600 20px Rubik, system-ui, sans-serif';
					const pad = 14;
					const chipWidth = paint.measureText(label).width + pad * 2 + 6;
					paint.fillStyle = 'rgba(255, 255, 255, 0.16)';
					paint.beginPath();
					paint.roundRect(chipX, y, chipWidth, 36, 8);
					paint.fill();
					paint.fillStyle = '#ffffff';
					paint.letterSpacing = '2px';
					paint.fillText(label, chipX + pad, y + 25);
					paint.letterSpacing = '0px';
					chipX += chipWidth + 10;
				};

				chip(formatRank(career.points, lang).toUpperCase(), 470);
				if (format === 'tiebreak') chip(text.tiebreak.toUpperCase(), 470);

				// The ball, oversized, as the card's mark.
				paint.fillStyle = '#d8f000';
				paint.beginPath();
				paint.arc(width - 132, 158, 46, 0, Math.PI * 2);
				paint.fill();
				paint.strokeStyle = 'rgba(255, 255, 255, 0.85)';
				paint.lineWidth = 5;
				paint.beginPath();
				paint.arc(width - 132, 158, 34, Math.PI * 0.72, Math.PI * 1.45);
				paint.stroke();

				// Footer: where the match was played, and when.
				const when = new Date().toLocaleDateString(locale, {
					day: 'numeric',
					month: 'long',
					year: 'numeric',
				});
				paint.font = '400 24px Rubik, system-ui, sans-serif';
				paint.fillStyle = 'rgba(255, 255, 255, 0.62)';
				paint.fillText(when, left, height - 56);
				const dateWidth = paint.measureText(`${when}   `).width;
				paint.font = '600 26px Rubik, system-ui, sans-serif';
				paint.fillStyle = colors.ink;
				paint.fillText(host, left + dateWidth, height - 56);
			}

			/** Palette, read from the page so the stadium matches the theme. */
			let colors = readColors();
			function readColors() {
				const style = getComputedStyle(document.documentElement);
				const value = (name: string, fallback: string) =>
					style.getPropertyValue(name).trim() || fallback;
				return {
					surface: value('--court-surface', '#2f6cb5'),
					apron: value('--court-apron', '#1d4f8c'),
					line: value('--court-line', '#ffffff'),
					net: value('--court-net', 'rgba(255,255,255,0.62)'),
					stand: value('--stand', '#0e2a4d'),
					seat: value('--stand-seat', '#16406f'),
					accent: value('--stand-accent', '#0057b8'),
					// The board's accent is the one picked to read on a dark
					// panel, which is exactly what the card is.
					ink: value('--board-accent', '#7fb3ee'),
				};
			}

			/**
			 * Everything that never moves — bowl, crowd, court, umpire — is
			 * painted once into this layer and blitted each frame.
			 */
			let scene: HTMLCanvasElement | null = null;

			function paintScene() {
				const here = venue();
				const layer = document.createElement('canvas');
				layer.width = W;
				layer.height = H;
				const paint = layer.getContext('2d')!;

				// Deterministic crowd: the same house every time the door opens.
				let seed = 20260913;
				const random = () => {
					seed = (seed * 1664525 + 1013904223) % 4294967296;
					return seed / 4294967296;
				};

				// ── The bowl ────────────────────────────────────────────────
				// Roof and outer structure, then two tiers of seating rings
				// with a concourse between them, each one painted as a block
				// and then filled with a crowd.
				paint.fillStyle = shade(colors.stand, -0.45);
				paint.fillRect(0, 0, W, H);

				const outer = { x: 8, y: 6, w: W - 16, h: H - 12 };
				const front = {
					x: COURT_X - APRON_X,
					y: COURT_Y - APRON_Y,
					w: COURT_W + APRON_X * 2,
					h: COURT_H + APRON_Y * 2,
				};
				// The upper tier reaches this far in from the outer wall.
				const split = {
					x: outer.x + (front.x - outer.x) * here.tier,
					y: outer.y + (front.y - outer.y) * here.tier,
					w: 0,
					h: 0,
				};
				split.w = outer.w - (split.x - outer.x) * 2;
				split.h = outer.h - (split.y - outer.y) * 2;
				const concourse = inset(split, 14);

				roundRect(paint, outer, here.corner + 16, shade(colors.seat, -0.4));
				seats(paint, outer, split, here.accentBand === 'upper', random);

				// Concourse: the dark gap that separates the two tiers.
				roundRect(paint, split, here.corner + 8, shade(colors.stand, -0.2));
				roundRect(paint, concourse, here.corner + 6, shade(colors.seat, -0.2));
				seats(paint, concourse, front, here.accentBand === 'lower', random);

				// The rail along the front row.
				paint.strokeStyle = 'rgba(255, 255, 255, 0.18)';
				paint.lineWidth = 2;
				paint.beginPath();
				paint.roundRect(front.x - 5, front.y - 5, front.w + 10, front.h + 10, 8);
				paint.stroke();

				// ── Back wall, with the venue's name on it ──────────────────
				const wall = { x: front.x, y: front.y - 34, w: front.w, h: 30 };
				roundRect(paint, wall, 4, shade(colors.stand, -0.4));
				paint.fillStyle = 'rgba(255, 255, 255, 0.72)';
				paint.font = '600 13px Rubik, system-ui, sans-serif';
				paint.textAlign = 'center';
				paint.textBaseline = 'middle';
				paint.letterSpacing = '3px';
				paint.fillText(here.venue.toUpperCase(), W / 2, wall.y + wall.h / 2);
				paint.letterSpacing = '0px';

				// ── Run-off and court ───────────────────────────────────────
				roundRect(paint, front, 6, colors.apron);
				paint.fillStyle = colors.surface;
				paint.fillRect(COURT_X, COURT_Y, COURT_W, COURT_H);

				paint.strokeStyle = colors.line;
				paint.lineWidth = 3;
				paint.strokeRect(COURT_X, COURT_Y, COURT_W, COURT_H);
				const lines: [number, number, number, number][] = [
					[COURT_X, COURT_Y + ALLEY, COURT_X + COURT_W, COURT_Y + ALLEY],
					[COURT_X, COURT_Y + COURT_H - ALLEY, COURT_X + COURT_W, COURT_Y + COURT_H - ALLEY],
					[NET_X - SERVICE, COURT_Y + ALLEY, NET_X - SERVICE, COURT_Y + COURT_H - ALLEY],
					[NET_X + SERVICE, COURT_Y + ALLEY, NET_X + SERVICE, COURT_Y + COURT_H - ALLEY],
					[NET_X - SERVICE, COURT_MID, NET_X + SERVICE, COURT_MID],
					[COURT_X, COURT_MID, COURT_X + 14, COURT_MID],
					[COURT_X + COURT_W - 14, COURT_MID, COURT_X + COURT_W, COURT_MID],
				];
				for (const [x1, y1, x2, y2] of lines) {
					paint.beginPath();
					paint.moveTo(x1, y1);
					paint.lineTo(x2, y2);
					paint.stroke();
				}

				// Net, strung between posts outside the doubles lines.
				paint.strokeStyle = colors.net;
				paint.lineWidth = 5;
				paint.setLineDash([9, 7]);
				paint.beginPath();
				paint.moveTo(NET_X, COURT_Y - 16);
				paint.lineTo(NET_X, COURT_Y + COURT_H + 16);
				paint.stroke();
				paint.setLineDash([]);
				paint.fillStyle = colors.line;
				dot(paint, NET_X, COURT_Y - 16, 4);
				dot(paint, NET_X, COURT_Y + COURT_H + 16, 4);

				// ── The officials ───────────────────────────────────────────
				// Umpire's chair at the net, ball kids at the posts, line judges
				// behind the baselines.
				paint.fillStyle = shade(colors.stand, -0.25);
				paint.fillRect(NET_X - 11, COURT_Y - APRON_Y + 14, 22, 30);
				paint.fillStyle = 'rgba(255, 255, 255, 0.8)';
				dot(paint, NET_X, COURT_Y - APRON_Y + 22, 5);

				paint.fillStyle = 'rgba(255, 255, 255, 0.55)';
				for (const [x, y] of [
					[COURT_X - 34, COURT_Y - 26],
					[COURT_X - 34, COURT_Y + COURT_H + 26],
					[COURT_X + COURT_W + 34, COURT_Y - 26],
					[COURT_X + COURT_W + 34, COURT_Y + COURT_H + 26],
					[NET_X - 26, COURT_Y + COURT_H + APRON_Y - 18],
					[NET_X + 26, COURT_Y + COURT_H + APRON_Y - 18],
				] as [number, number][]) {
					dot(paint, x, y, 4.5);
				}

				scene = layer;
			}

			/**
			 * Fills the ring between `from` and `to` with a packed crowd: rows
			 * of heads, gangways cut through them, and — where the venue has
			 * one — a band of seats in the tournament's own colour.
			 */
			function seats(
				paint: CanvasRenderingContext2D,
				from: { x: number; y: number; w: number; h: number },
				to: { x: number; y: number; w: number; h: number },
				accented: boolean,
				random: () => number
			) {
				const step = 6;
				for (let y = from.y + 5; y < from.y + from.h - 3; y += step) {
					for (let x = from.x + 5; x < from.x + from.w - 3; x += step) {
						const inside =
							x > to.x - 3 && x < to.x + to.w + 3 && y > to.y - 3 && y < to.y + to.h + 3;
						if (inside) continue;

						// Gangways up through the stand, every so many rows.
						if ((x - from.x) % 84 < 6 || (y - from.y) % 84 < 6) continue;

						const roll = random();
						if (roll < 0.12) continue; // an empty seat

						// A block of the tournament's own colour runs through the
						// tier where the venue has one.
						const band = accented && (y - from.y) % 66 < 12;
						paint.fillStyle = band
							? roll > 0.5
								? colors.accent
								: shade(colors.accent, 0.25)
							: roll > 0.78
								? shade(colors.seat, 0.55) // a shirt catching the light
								: roll > 0.55
									? shade(colors.seat, 0.28)
									: roll > 0.3
										? colors.seat
										: shade(colors.seat, -0.25);
						paint.beginPath();
						paint.arc(x + random(), y + random(), 1.9, 0, Math.PI * 2);
						paint.fill();
					}
				}
			}

			function roundRect(
				paint: CanvasRenderingContext2D,
				box: { x: number; y: number; w: number; h: number },
				radius: number,
				fill: string
			) {
				paint.fillStyle = fill;
				paint.beginPath();
				paint.roundRect(box.x, box.y, box.w, box.h, radius);
				paint.fill();
			}

			function inset(box: { x: number; y: number; w: number; h: number }, by: number) {
				return { x: box.x + by, y: box.y + by, w: box.w - by * 2, h: box.h - by * 2 };
			}

			function dot(paint: CanvasRenderingContext2D, x: number, y: number, r: number) {
				paint.beginPath();
				paint.arc(x, y, r, 0, Math.PI * 2);
				paint.fill();
			}

			/** Mixes a hex colour towards white (positive) or black (negative). */
			function shade(hex: string, amount: number) {
				const match = /^#?([\da-f]{6})$/i.exec(hex.trim());
				if (!match) return hex;
				const value = parseInt(match[1]!, 16);
				const mix = (channel: number) =>
					Math.round(amount >= 0 ? channel + (255 - channel) * amount : channel * (1 + amount));
				return `rgb(${mix((value >> 16) & 255)}, ${mix((value >> 8) & 255)}, ${mix(value & 255)})`;
			}

			// ── The match ─────────────────────────────────────────────────
			// The ball is kept as a speed and an angle rather than a pair of
			// velocities: spin bends the angle, the surface scales the speed,
			// and both stay honest that way — a curving ball keeps its pace
			// instead of quietly gaining some.
			let playerY = (H - PADDLE_H) / 2;
			let cpuY = playerY;
			let playerVy = 0;
			let cpuVy = 0;
			let ball = { x: W / 2, y: H / 2, speed: 0, angle: 0, dir: 1, spin: 0, curve: 0 };
			let points: Scores = { player: 0, cpu: 0 };
			let games: Scores = { player: 0, cpu: 0 };
			let over = false;
			let server: Side = 'player';
			let serveNumber: 1 | 2 = 1;
			let serveKick = 0;
			let charging = false;
			let charge = 0;
			let serveTarget: { x: number; y: number; in: boolean } | null = null;
			let mark: { x: number; y: number; in: boolean; life: number } | null = null;
			let phase: Phase = 'serve';
			/** Shots in this point, the serve counted as the first of them. */
			let shots = 0;
			let touched = false;
			/** How far the ball passed the racket by, which is what tells a winner from a miss. */
			let missGap: number | null = null;
			let pointBreak = false;
			/** Set when a shot was missed outright: into the net, or long. */
			let spoiled: 'net' | 'long' | null = null;
			let waiting = 0;
			let cpuServeDelay = 0;
			let clock = 0;
			let rushUntil = 0;
			let stamina = ratings.stamina;
			let stats: MatchStats = freshStats();
			let lastShot: { side: Side; wing: Wing; shot: Shot; at: number } | null = null;
			let frame = 0;
			let last = 0;
			/** Whether the loop should ask for another frame after this one. */
			let running = false;
			let pointerY: number | null = null;
			const keys = new Set<string>();

			/**
			 * A phone held upright has no room for a court lying on its side,
			 * so the whole scene is turned a quarter turn and the match becomes
			 * a tie-break — first to seven, two clear — which is the right
			 * length for a game played standing up.
			 */
			const upright = matchMedia('(orientation: portrait)');
			let portrait = upright.matches;
			let format: 'match' | 'tiebreak' = portrait ? 'tiebreak' : 'match';
			/** Who started the tie-break: the serve order is counted from it. */
			let opener: Side = 'player';

			// ── Rackets, wings and where they stand ───────────────────────

			/**
			 * The racket as it is this instant: which half is the forehand, and
			 * how far it reaches. A one-hander's extra reach really is extra
			 * racket, and it is added on the backhand side, where it is the
			 * hand that is off the grip.
			 */
			function racketOf(side: Side) {
				const top = side === 'player' ? playerY : cpuY;
				const hand: Hand = side === 'player' ? career.hand : CPU_HAND;
				const reach = side === 'player' ? ratings.backhandReach : 0;
				const below = forehandBelow(side, hand);
				return {
					hand,
					below,
					top: top - (below ? reach : 0),
					bottom: top + PADDLE_H + (below ? 0 : reach),
					mid: top + PADDLE_H / 2,
				};
			}

			/** A returner who has learned to stand in stands in. */
			function paddleX(side: Side) {
				if (side === 'cpu') return COURT_X + COURT_W - PADDLE_INSET - PADDLE_W;
				return COURT_X + PADDLE_INSET + (server === 'cpu' ? ratings.returnStep : 0);
			}

			/** The middle of the half of the court a given wing covers. */
			function wingCentre(side: Side, hand: Hand, wing: Wing) {
				const low = COURT_MID + COURT_H * 0.24;
				const high = COURT_MID - COURT_H * 0.24;
				const fore = forehandBelow(side, hand) ? low : high;
				return wing === 'forehand' ? fore : forehandBelow(side, hand) ? high : low;
			}

			// ── Scoring ───────────────────────────────────────────────────

			const LADDER = ['0', '15', '30', '40'];
			function pointLabel(mine: number, theirs: number) {
				if (format === 'tiebreak') return String(mine); // a tie-break counts plainly
				if (mine < 3 || theirs < 3) return LADDER[Math.min(mine, 3)]!;
				if (mine === theirs) return '40';
				return mine > theirs ? 'AD' : '40';
			}

			/** One point from taking the server's game, which is the whole sport. */
			function isBreakPoint() {
				if (format === 'tiebreak') return false;
				const returner = other(server);
				return points[returner] >= 3 && points[returner] - points[server] >= 1;
			}

			function isMatchPoint(side: Side) {
				const them = other(side);
				if (format === 'tiebreak') return points[side] >= 6 && points[side] - points[them] >= 1;
				if (games[side] < 3) return false;
				return points[side] >= 3 && points[side] - points[them] >= 1;
			}

			/** The moments the "under pressure" branch is bought for. */
			function attacking() {
				if (ratings.pressureScope >= 2 && isMatchPoint('player')) return true;
				if (ratings.pressureScope >= 1 && format === 'tiebreak') return true;
				return server === 'cpu' && pointBreak;
			}

			function defending() {
				if (ratings.pressureScope >= 2 && isMatchPoint('cpu')) return true;
				if (ratings.pressureScope >= 1 && format === 'tiebreak') return true;
				return server === 'player' && pointBreak;
			}

			function paintScore() {
				out.playerName.textContent = displayName();
				out.playerPoint.textContent = pointLabel(points.player, points.cpu);
				out.cpuPoint.textContent = pointLabel(points.cpu, points.player);
				out.playerGames.textContent = String(games.player);
				out.cpuGames.textContent = String(games.cpu);
				out.servingPlayer.classList.toggle('on', server === 'player');
				out.servingCpu.classList.toggle('on', server === 'cpu');

				const slam = currentSlam();
				const here = VENUES[slam];
				out.tournament.textContent = names[slam] ?? '';
				out.venue.textContent = `${here.venue} · ${here.surface[lang]} · ${text.pace}: ${paceLabel[here.category][lang]}`;

				const seed = seedFor(career.points);
				const round = ROUNDS[career.round]!.name[lang];
				const badge = seed
					? text.seed.replace('%s', String(seed))
					: entryRound(career.points) > 0
						? text.unseeded
						: text.qualifier;
				out.standing.textContent = `${round} · ${formatRank(career.points, lang)} · ${badge}`;

				const left = clamp(stamina / ratings.stamina, 0, 1);
				out.fitness.style.width = `${Math.round(left * 100)}%`;
				out.fitness.dataset.low = left < 0.4 ? 'true' : 'false';
			}

			// ── The serve ─────────────────────────────────────────────────

			/**
			 * The box this serve has to land in. The server's deuce court is on
			 * their right and the ball crosses the net to the receiver's right,
			 * which — because the two of them face opposite ways — is the other
			 * half of the screen. The alternation from deuce to advantage court
			 * comes straight off the point count.
			 */
			function serveBox(from: Side) {
				const deuce = (points.player + points.cpu) % 2 === 0;
				const upper = from === 'player' ? deuce : !deuce;
				const top = upper ? COURT_Y + ALLEY : COURT_MID;
				const bottom = upper ? COURT_MID : COURT_Y + COURT_H - ALLEY;
				return {
					top,
					bottom,
					centre: (top + bottom) / 2,
					half: (bottom - top) / 2,
					dir: from === 'player' ? 1 : -1,
				};
			}

			/** What the machine goes for: the receiver's backhand, with nerve. */
			function cpuAim(box: ReturnType<typeof serveBox>) {
				const target = wingCentre('player', career.hand, 'backhand');
				const toward = clamp((target - box.centre) / box.half, -1, 1);
				return clamp(toward * opponent.nerve + (Math.random() - 0.5) * 0.35, -1, 1);
			}

			/**
			 * The serve has reached the court. Off the bounce it sheds pace —
			 * less of it the quicker the surface — and a second serve with kick
			 * on it climbs away toward the returner's backhand, which is the
			 * whole reason anyone hits one.
			 */
			function landServe() {
				const target = serveTarget!;
				mark = { x: target.x, y: target.y, in: target.in, life: 1.2 };
				if (!target.in) {
					faultServe();
					return;
				}
				if (serveNumber === 1) stats[server].firstIn += 1;

				const here = venue();
				const receiver = other(server);
				const hand: Hand = receiver === 'player' ? career.hand : CPU_HAND;
				const toward = wingCentre(receiver, hand, 'backhand');
				const aimY = target.y + (toward - target.y) * 0.4 * serveKick;

				ball.x = target.x;
				ball.y = target.y;
				ball.speed = Math.min(ball.speed * (0.58 + 0.07 * here.category), MAX_SPEED * 1.25);
				ball.angle = clamp(
					Math.atan2(aimY - target.y, Math.abs(paddleX(receiver) - target.x)),
					-1.05,
					1.05
				);
				ball.spin = serveKick * 0.85;
				ball.curve = 0;
				phase = 'rally';
			}

			function faultServe() {
				ball.speed = 0;
				if (serveNumber === 1) {
					serveNumber = 2;
					stats[server].secondPlayed += 1;
					announce(text.fault, text.secondServe);
					pending = 'serve';
					waiting = 0.9;
					return;
				}
				stats[server].doubleFaults += 1;
				awardPoint(other(server), 'double');
			}

			/** Puts the ball back on the server's racket and waits for them. */
			function beginServe() {
				phase = 'serve';
				charging = false;
				charge = 0;
				serveTarget = null;
				serveKick = 0;
				touched = false;
				missGap = null;
				spoiled = null;
				lastShot = null;
				ball.speed = 0;
				ball.spin = 0;
				ball.curve = 0;
				const racket = racketOf(server);
				ball.x = paddleX(server) + (server === 'player' ? PADDLE_W + BALL_R + 4 : -BALL_R - 4);
				ball.y = racket.mid;
				cpuServeDelay = 0.7 + Math.random() * 0.45;

				if (server === 'player') {
					const note = pointBreak
						? isMatchPoint('cpu')
							? text.matchPoint
							: text.breakPoint
						: format === 'match' && points.player >= 3 && points.player === points.cpu
							? text.deuce
							: '';
					announce(serveNumber === 2 ? text.secondServe : portrait ? text.serveTap : text.serve, note);
				} else {
					announce(pointBreak ? text.breakPoint : '');
				}
			}

			/** A fresh point: the serve count, the break-point books, the ball. */
			function startPoint() {
				serveNumber = 1;
				shots = 0;
				stats[server].serves += 1;
				pointBreak = isBreakPoint();
				if (pointBreak) stats[server].faced += 1;
				beginServe();
			}

			/** What waits at the end of the pause: a whole new point, or serve two. */
			let pending: 'point' | 'serve' = 'point';

			// ── Playing the point ─────────────────────────────────────────

			function playerSpeed() {
				let mul = ratings.speed;
				if (clock < rushUntil) mul *= 1.18;
				if (defending()) mul *= 1 + ratings.pressureGuard;
				const left = stamina / ratings.stamina;
				if (left < 0.5) mul *= 0.8 + 0.2 * (left / 0.5);
				return PLAYER_SPEED * mul;
			}

			/**
			 * The racket follows the pointer, but only as fast as the player can
			 * actually run — which is what makes the fitness branch worth
			 * anything, and what lets the speed of the racket at contact mean
			 * something. A racket that teleported would have no swing to read.
			 */
			function movePlayer(seconds: number) {
				const before = playerY;
				const speed = playerSpeed();

				if (pointerY !== null) {
					const want = pointerY - PADDLE_H / 2;
					playerY += clamp(want - playerY, -speed * seconds, speed * seconds);
				} else {
					if (keys.has('ArrowUp') || keys.has('ArrowLeft') || keys.has('w') || keys.has('W')) {
						playerY -= speed * seconds;
					}
					if (keys.has('ArrowDown') || keys.has('ArrowRight') || keys.has('s') || keys.has('S')) {
						playerY += speed * seconds;
					}
				}

				playerY = clamp(playerY, COURT_Y, COURT_Y + COURT_H - PADDLE_H);
				playerVy = seconds > 0 ? (playerY - before) / seconds : 0;
				stamina = Math.max(0, stamina - (Math.abs(playerVy) / PLAYER_SPEED) * 2.4 * seconds);
			}

			function moveCpu(seconds: number) {
				const before = cpuY;
				const chasing = ball.dir > 0 && phase !== 'serve' && ball.speed > 0;
				const target = chasing ? ball.y - PADDLE_H / 2 : COURT_Y + (COURT_H - PADDLE_H) / 2;
				const reach = opponent.speed * seconds * (chasing ? 1 : opponent.recovery);
				cpuY = clamp(
					cpuY + clamp(target - cpuY, -reach, reach),
					COURT_Y,
					COURT_Y + COURT_H - PADDLE_H
				);
				cpuVy = seconds > 0 ? (cpuY - before) / seconds : 0;
			}

			/** How far the ball passed a racket by — nothing if it was reached. */
			function gapTo(racket: { top: number; bottom: number }) {
				if (ball.y < racket.top) return racket.top - ball.y;
				if (ball.y > racket.bottom) return ball.y - racket.bottom;
				return 0;
			}

			/**
			 * Where a serve struck now would land, and whether that is in. The
			 * drawing wants the answer before the ball is hit — the target is
			 * shown while the racket is still going back — so the sums live
			 * here and `hitServe` reads them off.
			 */
			function projectServe(from: Side, value: number, aim: number) {
				const box = serveBox(from);
				const second = serveNumber === 2;
				const margin = from === 'player' ? ratings.serveMargin : 0.06 + opponent.nerve * 0.14;
				const spread = (0.72 + 0.95 * value) * (1 - margin) * (second ? 0.74 : 1);
				const depth = (0.55 + 0.62 * value) * (1 - margin * 0.5) * (second ? 0.86 : 1);
				const y = box.centre + aim * box.half * spread;
				const x = NET_X + box.dir * SERVICE * clamp(depth, 0.1, 1.4);
				return {
					box,
					x,
					y,
					in:
						value > 0.08 &&
						Math.abs(y - box.centre) <= box.half &&
						Math.abs(x - NET_X) <= SERVICE,
				};
			}

			/** The longest wind-up that still lands in front of the service line. */
			function safeCharge() {
				const second = serveNumber === 2;
				const scale = (1 - ratings.serveMargin * 0.5) * (second ? 0.86 : 1);
				return clamp((1 / scale - 0.55) / 0.62, 0, 1);
			}

			/** Where the player's racket is standing, as an aim from -1 to 1. */
			const playerAim = () =>
				clamp((racketOf('player').mid - COURT_MID) / (COURT_H / 2), -1, 1);

			function hitServe(from: Side, value: number) {
				const here = venue();
				const aim = from === 'player' ? playerAim() : cpuAim(serveBox(from));
				const shot = projectServe(from, value, aim);
				const second = serveNumber === 2;

				const power = from === 'player' ? ratings.serveSpeed : opponent.serve;
				const speed = (SERVE_MIN + (SERVE_MAX - SERVE_MIN) * value) * power * here.pace.serve;
				serveKick = second ? (from === 'player' ? ratings.secondServe : 0.55) : 0;

				const startX = paddleX(from) + (from === 'player' ? PADDLE_W + BALL_R : -BALL_R);
				ball.x = startX;
				ball.y = racketOf(from).mid;
				ball.speed = speed;
				ball.dir = shot.box.dir;
				ball.angle = clamp(
					Math.atan2(shot.y - ball.y, Math.max(60, Math.abs(shot.x - startX))),
					-1.2,
					1.2
				);
				ball.spin = 0;
				ball.curve = 0;

				serveTarget = { x: shot.x, y: shot.y, in: shot.in };
				phase = 'flight';
				shots = 1;
				lastShot = null;
				charging = false;
				charge = 0;

				const kmh = Math.round(speed * SERVE_KMH);
				out.serveSpeed.textContent = `${kmh} km/h`;
				if (shot.in) stats[from].fastest = Math.max(stats[from].fastest, kmh);
				announce('');
			}

			function serveStep(seconds: number) {
				const racket = racketOf(server);
				ball.x = paddleX(server) + (server === 'player' ? PADDLE_W + BALL_R + 4 : -BALL_R - 4);
				ball.y = racket.mid;

				if (server === 'cpu') {
					cpuServeDelay -= seconds;
					if (cpuServeDelay <= 0) {
						const value =
							serveNumber === 2
								? SECOND_SERVE_CHARGE * (0.82 + Math.random() * 0.18)
								: clamp(0.42 + opponent.nerve * 0.5 + (Math.random() - 0.5) * 0.14, 0.2, 1);
						hitServe('cpu', value);
					}
					return;
				}

				if (!charging) return;
				const cap = serveNumber === 2 ? SECOND_SERVE_CHARGE : 1;
				charge = Math.min(charge + seconds / CHARGE_SECONDS, cap);
				// Held all the way back, the racket goes through it anyway.
				if (charge >= cap) hitServe('player', cap);
			}

			function advanceBall(seconds: number) {
				const here = venue();

				// A heavy ball gathers pace off the court where the surface grips
				// it; a sliced one dies on a surface that does not.
				if (phase === 'rally' && ball.spin !== 0) {
					const drive =
						ball.spin > 0
							? 0.34 * ball.spin * here.pace.kick
							: 0.5 * ball.spin * (1 - here.pace.skid);
					ball.speed = clamp(ball.speed * (1 + drive * seconds), 200, MAX_SPEED);
				}

				// Spin bends the flight, and then stops bending it.
				if (ball.curve) {
					ball.angle = clamp(ball.angle + ball.curve * seconds, -1.05, 1.05);
					ball.curve *= Math.pow(0.4, seconds);
					if (Math.abs(ball.curve) < 0.02) ball.curve = 0;
				}

				ball.x += Math.cos(ball.angle) * ball.speed * ball.dir * seconds;
				ball.y += Math.sin(ball.angle) * ball.speed * seconds;

				if (phase === 'flight') {
					const target = serveTarget!;
					const arrived =
						ball.dir > 0 ? ball.x >= target.x : ball.x <= target.x;
					if (arrived) landServe();
					return;
				}

				if (ball.y - BALL_R <= COURT_Y && ball.angle < 0) {
					ball.y = COURT_Y + BALL_R;
					ball.angle = -ball.angle;
				}
				if (ball.y + BALL_R >= COURT_Y + COURT_H && ball.angle > 0) {
					ball.y = COURT_Y + COURT_H - BALL_R;
					ball.angle = -ball.angle;
				}

				if (spoiled) {
					// Whoever put it into the tape or over the baseline has lost
					// the point, and the ball is travelling away from them.
					const against: Side = ball.dir > 0 ? 'cpu' : 'player';
					if (spoiled === 'net') {
						const reached = ball.dir > 0 ? ball.x >= NET_X : ball.x <= NET_X;
						if (reached) {
							mark = { x: NET_X, y: ball.y, in: false, life: 1.1 };
							ball.speed = 0;
							awardPoint(against, 'rally');
						}
						return;
					}
					const past = ball.x < COURT_X - 70 || ball.x > COURT_X + COURT_W + 70;
					if (past) awardPoint(against, 'rally');
					return;
				}

				const px = paddleX('player');
				const cx = paddleX('cpu');
				const pr = racketOf('player');
				const cr = racketOf('cpu');

				if (
					ball.dir < 0 &&
					ball.x - BALL_R <= px + PADDLE_W &&
					ball.x - BALL_R >= px - 16 &&
					ball.y >= pr.top &&
					ball.y <= pr.bottom
				) {
					hit('player', px + PADDLE_W + BALL_R);
				} else if (
					ball.dir > 0 &&
					ball.x + BALL_R >= cx &&
					ball.x + BALL_R <= cx + PADDLE_W + 16 &&
					ball.y >= cr.top &&
					ball.y <= cr.bottom
				) {
					hit('cpu', cx - BALL_R);
				}

				// Past the racket, and by how much: a ball nowhere near it was a
				// winner, one that went straight through it was a miss.
				if (missGap === null) {
					if (ball.dir < 0 && ball.x + BALL_R < px) missGap = gapTo(pr);
					else if (ball.dir > 0 && ball.x - BALL_R > cx + PADDLE_W) missGap = gapTo(cr);
				}

				if (ball.x < COURT_X - 70) awardPoint('cpu', 'rally');
				else if (ball.x > COURT_X + COURT_W + 70) awardPoint('player', 'rally');
			}

			/** Stretched, he slices; given time, he goes after it. */
			function cpuShot(mid: number): Shot {
				const stretch = Math.abs(ball.y - mid) / (PADDLE_H / 2);
				if (stretch > 0.72) return 'slice';
				return Math.random() < 0.7 ? 'topspin' : 'flat';
			}

			/**
			 * The shot. Which half of the racket the ball met decides the wing,
			 * how fast the racket was travelling decides whether it was driven,
			 * blocked or carved, and what arrived — heavy and climbing, or low
			 * and skidding — decides how much of any of it is possible.
			 */
			function hit(side: Side, x: number) {
				const here = venue();
				const racket = racketOf(side);
				const raw = clamp((ball.y - racket.mid) / (PADDLE_H / 2), -1.4, 1.4);
				const runAround = side === 'player' ? ratings.runAround : 0;
				const wing = wingFor(side, racket.hand, raw, runAround);
				const player = side === 'player';

				shots += 1;
				if (side !== server) touched = true;

				const swing = player ? playerVy : cpuVy;
				const effort = Math.min(Math.abs(swing) / PLAYER_SPEED, 1.4);
				const along = swing * (Math.sin(ball.angle) >= 0 ? 1 : -1);
				const shot: Shot = !player
					? cpuShot(racket.mid)
					: effort < 0.18
						? 'flat'
						: along > 0
							? 'topspin'
							: 'slice';

				// The wing. A backhand is never quite the forehand, trained or not.
				const wingPace =
					wing === 'forehand'
						? player
							? ratings.forehandPace
							: 1
						: player
							? ratings.backhandPace * 0.94
							: 1 - opponent.weakness * 0.6;

				// What arrived: a ball kicking up at the backhand is the oldest
				// way there is to make somebody miss.
				const high = Math.max(0, ball.spin) * here.pace.kick;
				const guard = player ? ratings.backhandHigh : 1 - opponent.weakness;
				const trouble = wing === 'backhand' ? high * (1 - guard) * 0.42 : high * 0.08;
				const low = Math.max(0, -ball.spin) * here.pace.skid;
				const quality = clamp(1 - trouble - low * 0.2, 0.5, 1);

				const shotPace =
					shot === 'topspin'
						? 1 + 0.16 * effort
						: shot === 'slice'
							? 0.72 + 0.22 * here.pace.skid
							: 1;

				// ── The unforced error ────────────────────────────────────
				// Seven points in ten are over inside four shots, and the ones
				// that are not are decided as often by a miss as by a winner.
				// So: the faster the ball, the further out on the frame it was
				// met, the longer the point has gone and the emptier the legs,
				// the likelier this one finds the net or sails long. It is the
				// only thing that ends a rally two good retrievers could
				// otherwise keep going until the tournament did.
				const strain = clamp((ball.speed / MAX_SPEED - 0.6) / 0.4, 0, 1);
				const stretched = Math.min(Math.abs(raw), 1);
				const spent = player ? 1 - clamp(stamina / ratings.stamina, 0, 1) : 0;
				const grind = clamp((shots - 4) / 10, 0, 1);
				let loose = strain * 0.5 + stretched * 0.22 + spent * 0.35 + grind * 0.45;
				loose *= player
					? 1 / (wing === 'forehand' ? ratings.forehandPace : ratings.backhandPace)
					: 1.15 - opponent.nerve * 0.5;
				// A ball that was never under control in the first place is the
				// one most likely to go.
				loose *= 2 - quality;

				if (Math.random() < loose * 0.1) {
					stats[side].errors += 1;
					spoiled = Math.random() < 0.55 ? 'net' : 'long';
					ball.dir = player ? 1 : -1;
					ball.x = x;
					ball.curve = 0;
					ball.spin = 0;
					if (spoiled === 'net') {
						// Dumped into the tape, at nothing like the pace it was
						// struck with.
						ball.speed = Math.max(220, ball.speed * 0.35);
						ball.angle = clamp(raw * 0.4, -0.6, 0.6);
					} else {
						// Over the baseline, and past anybody's racket.
						ball.speed = Math.min(ball.speed * 1.15, MAX_SPEED);
						ball.angle = clamp(raw * 0.5 + (Math.random() - 0.5) * 0.3, -0.7, 0.7);
					}
					lastShot = { side, wing, shot, at: clock };
					return;
				}


				let plus = 1;
				if (player) {
					if (shots === 3 && side === server) plus = ratings.servePlusOne;
					if (shots === 4 && side !== server) plus = ratings.returnPlusOne;
					if (shots === 2 && side !== server) {
						if (shot !== 'topspin') plus = 1 + ratings.returnBlock * 0.16;
						if (shot === 'slice' && ratings.returnRush) rushUntil = clock + ratings.returnRush;
					}
					if (attacking()) plus *= 1 + ratings.pressureBite;
					const left = stamina / ratings.stamina;
					if (left < 0.5) plus *= 0.9 + 0.2 * (left / 0.5);
					stamina = Math.max(0, stamina - 0.9);
				} else {
					plus = opponent.pace;
				}

				const speed = clamp(
					ball.speed * here.pace.rally * wingPace * shotPace * quality * plus,
					BASE_SPEED * 0.82,
					MAX_SPEED
				);

				// Where on the racket it was met decides the angle — and the
				// forehand opens the court up further than the backhand will.
				const angleMul = wing === 'forehand' ? 1 : player ? 0.84 * ratings.backhandAngle : 0.8;
				let angle = raw * 0.9 * angleMul + (Math.random() - 0.5) * 0.09;

				if (!player) {
					// He plays the backhand, and reads it better the deeper in the
					// draw you are.
					const target = wingCentre('player', career.hand, 'backhand');
					const toward = Math.atan2(target - ball.y, Math.max(140, Math.abs(paddleX('player') - x)));
					const bias = opponent.nerve * 0.5;
					angle = angle * (1 - bias) + toward * bias;
				}

				ball.angle = clamp(angle, -1.05, 1.05);
				ball.dir = player ? 1 : -1;
				ball.x = x;
				ball.speed = speed;

				const rpm = player
					? wing === 'forehand'
						? ratings.forehandSpin
						: 2450 * ratings.backhandPace
					: 2500 + opponent.pace * 500;
				const heavy = clamp((rpm - 2000) / 1400, 0, 1);
				const bite = player && wing === 'backhand' ? ratings.backhandSlice : 1;
				ball.spin =
					shot === 'topspin'
						? clamp(heavy * (0.45 + 0.55 * effort), 0, 1)
						: shot === 'slice'
							? -clamp(0.45 * bite, 0, 1)
							: 0;
				ball.curve =
					shot === 'topspin'
						? (swing >= 0 ? 1 : -1) * heavy * 0.42
						: shot === 'slice'
							? (swing >= 0 ? -1 : 1) * 0.16
							: 0;

				lastShot = { side, wing, shot, at: clock };
			}

			/** The overlay, as two lines: what happened, and what it means. */
			function announce(line: string, note = '') {
				overlay.textContent = '';
				if (!line && !note) {
					overlay.hidden = true;
					return;
				}
				if (line) {
					const strong = document.createElement('strong');
					strong.textContent = line;
					overlay.append(strong);
				}
				if (note) {
					const span = document.createElement('span');
					span.textContent = note;
					overlay.append(span);
				}
				overlay.hidden = false;
			}

			function awardPoint(to: Side, how: 'ace' | 'double' | 'rally') {
				const loser = other(to);

				// A point the returner never got a racket on is an ace.
				const kind = how === 'rally' && to === server && !touched ? 'ace' : how;

				stats[to].points += 1;
				if (kind === 'ace') stats[to].aces += 1;
				if (kind === 'rally' && !spoiled) {
					if ((missGap ?? 0) > 34) stats[to].winners += 1;
					else stats[loser].errors += 1;
				}
				if (to === server && kind !== 'double') {
					if (serveNumber === 1) stats[server].firstWon += 1;
					else stats[server].secondWon += 1;
					if (pointBreak) stats[server].saved += 1;
				}
				stats.longest = Math.max(stats.longest, shots);

				points[to] += 1;
				ball.speed = 0;

				if (format === 'tiebreak') {
					// One point on the opening serve, two each after that.
					const played = points.player + points.cpu;
					const flipped = Math.floor((played + 1) / 2) % 2 === 1;
					server = flipped ? other(opener) : opener;
				} else if (points[to] >= 4 && points[to] - points[loser] >= 2) {
					games[to] += 1;
					points = { player: 0, cpu: 0 };
					server = other(server);
					// Ninety seconds in the chair at every odd game.
					if ((games.player + games.cpu) % 2 === 1) {
						stamina = Math.min(ratings.stamina, stamina + 22 * ratings.recovery);
					}
				}

				stamina = Math.min(ratings.stamina, stamina + 7 * ratings.recovery);
				paintScore();

				const won =
					format === 'tiebreak'
						? points[to] >= 7 && points[to] - points[loser] >= 2
						: games[to] >= 4;

				if (won) {
					endMatch(to === 'player');
					return;
				}

				if (kind === 'ace') announce(text.ace);
				else if (kind === 'double') announce(text.doubleFault);
				pending = 'point';
				waiting = kind === 'rally' ? 0.75 : 1.1;
			}

			function endMatch(playerWon: boolean) {
				over = true;
				ball.speed = 0;
				const line = (format === 'tiebreak' ? text.winTiebreak : text.win).replace(
					'%s',
					playerWon ? displayName() : opponentName
				);
				const played = career.round;
				finishMatch(playerWon);
				showResult(playerWon, line, played);
			}

			function reset() {
				hideResult();
				hideCareer();
				ratings = ratingsFor(career);
				opponent = opponentFor(career.round);
				points = { player: 0, cpu: 0 };
				games = { player: 0, cpu: 0 };
				server = 'player';
				opener = 'player';
				over = false;
				stamina = ratings.stamina;
				stats = freshStats();
				award = { points: 0, prize: 0 };
				clock = 0;
				rushUntil = 0;
				waiting = 0;
				mark = null;
				playerY = cpuY = (H - PADDLE_H) / 2;
				playerVy = cpuVy = 0;
				pointerY = null;
				out.serveSpeed.textContent = '';
				enterDraw();
				paintScore();
				startPoint();
			}

			function step(seconds: number) {
				clock += seconds;
				movePlayer(seconds);
				moveCpu(seconds);

				if (mark) {
					mark.life -= seconds;
					if (mark.life <= 0) mark = null;
				}

				if (waiting > 0) {
					waiting -= seconds;
					if (waiting <= 0) {
						if (pending === 'point') startPoint();
						else beginServe();
					}
					return;
				}

				if (over) return;
				if (phase === 'serve') {
					serveStep(seconds);
					return;
				}
				advanceBall(seconds);
			}

			// ── Drawing ───────────────────────────────────────────────────

			function draw() {
				// Everything below is drawn in the court's own landscape
				// coordinates; upright, the whole scene is turned a quarter
				// turn so the player's end is at the bottom of the screen.
				context.setTransform(1, 0, 0, 1, 0, 0);
				context.clearRect(0, 0, canvas.width, canvas.height);
				if (portrait) {
					context.translate(0, canvas.height);
					context.rotate(-Math.PI / 2);
				}

				if (scene) context.drawImage(scene, 0, 0);

				if (phase === 'serve' && server === 'player' && charging) drawTarget();
				if (mark) drawMark();

				drawRacket('player');
				drawRacket('cpu');
				drawBall();
				drawCall();

				if (phase === 'serve' && server === 'player') drawCharge();
			}

			/** The box the serve has to find, and where this one is heading. */
			function drawTarget() {
				const shot = projectServe('player', charge, playerAim());
				const { box } = shot;
				context.fillStyle = 'rgba(255, 255, 255, 0.1)';
				context.fillRect(
					Math.min(NET_X, NET_X + box.dir * SERVICE),
					box.top,
					SERVICE,
					box.bottom - box.top
				);

				context.strokeStyle = shot.in ? 'rgba(216, 240, 0, 0.9)' : 'rgba(255, 93, 77, 0.9)';
				context.lineWidth = 2;
				context.beginPath();
				context.moveTo(shot.x - 9, shot.y);
				context.lineTo(shot.x + 9, shot.y);
				context.moveTo(shot.x, shot.y - 9);
				context.lineTo(shot.x, shot.y + 9);
				context.stroke();
			}

			/** Where the last serve pitched, and whether the call went with it. */
			function drawMark() {
				const { x, y, in: landed, life } = mark!;
				context.globalAlpha = Math.min(1, life);
				context.fillStyle = landed ? 'rgba(255, 255, 255, 0.85)' : 'rgba(255, 93, 77, 0.95)';
				context.beginPath();
				context.ellipse(x, y, 9, 5.5, 0, 0, Math.PI * 2);
				context.fill();
				context.globalAlpha = 1;
			}

			/**
			 * The racket, in two tones: the forehand half in the solid colour,
			 * the backhand half held back, and a line between them. It is the
			 * one thing on the court the player has to be able to read at a
			 * glance, because everything else follows from it.
			 */
			function drawRacket(side: Side) {
				const racket = racketOf(side);
				const x = paddleX(side);
				const run = side === 'player' ? ratings.runAround : 0;
				const boundary = racket.mid + (racket.below ? -1 : 1) * run * (PADDLE_H / 2);
				const solid = side === 'player' ? '#11202b' : '#f2f5f8';
				const held = side === 'player' ? shade('#11202b', 0.42) : shade('#f2f5f8', -0.34);

				context.save();
				context.beginPath();
				context.roundRect(x, racket.top, PADDLE_W, racket.bottom - racket.top, 5);
				context.clip();
				context.fillStyle = held;
				context.fillRect(x, racket.top, PADDLE_W, racket.bottom - racket.top);
				context.fillStyle = solid;
				if (racket.below) context.fillRect(x, boundary, PADDLE_W, racket.bottom - boundary);
				else context.fillRect(x, racket.top, PADDLE_W, boundary - racket.top);
				context.restore();

				context.strokeStyle = 'rgba(216, 240, 0, 0.7)';
				context.lineWidth = 1.5;
				context.beginPath();
				context.moveTo(x - 1.5, boundary);
				context.lineTo(x + PADDLE_W + 1.5, boundary);
				context.stroke();
			}

			/**
			 * The shot the player just hit, named beside their racket for a
			 * moment. Two wings and three swings is a lot to discover from the
			 * way the ball comes off, so the court says it out loud instead.
			 */
			function drawCall() {
				if (!lastShot || lastShot.side !== 'player') return;
				const age = clock - lastShot.at;
				if (age > 0.8) return;

				const racket = racketOf('player');
				context.save();
				context.globalAlpha = Math.min(1, (0.8 - age) * 3);
				if (portrait) {
					// Upright the whole court is on its side; the label is not.
					context.translate(paddleX('player') + 26, racket.mid);
					context.rotate(Math.PI / 2);
					context.translate(-(paddleX('player') + 26), -racket.mid);
				}
				context.textAlign = 'left';
				context.textBaseline = 'middle';
				context.font = '600 15px Rubik, system-ui, sans-serif';
				context.fillStyle = 'rgba(255, 255, 255, 0.92)';
				context.fillText(
					`${text.wings[lastShot.wing]} · ${text.shots[lastShot.shot]}`,
					paddleX('player') + 26,
					racket.mid
				);
				context.restore();
			}

			function drawBall() {
				// A trail behind it, tinted by what is on the ball: yellow and
				// long for a heavy one, short and pale for a skidding slice.
				if (ball.speed > 0 && phase !== 'serve') {
					const vx = Math.cos(ball.angle) * ball.dir;
					const vy = Math.sin(ball.angle);
					const tint =
						ball.spin > 0.12
							? '216, 240, 0'
							: ball.spin < -0.12
								? '236, 244, 255'
								: '216, 240, 0';
					for (let i = 3; i >= 1; i--) {
						context.globalAlpha = 0.09 * (4 - i);
						context.fillStyle = `rgb(${tint})`;
						dot(context, ball.x - vx * i * 7, ball.y - vy * i * 7, Math.max(1, BALL_R - i * 1.7));
					}
					context.globalAlpha = 1;
				}

				// In the air on the way to the bounce, the ball reads bigger.
				const lift = phase === 'flight' ? 2.5 : 0;
				context.fillStyle = '#d8f000';
				dot(context, ball.x, ball.y, BALL_R + lift);
				context.strokeStyle = 'rgba(255, 255, 255, 0.85)';
				context.lineWidth = 1.5;
				context.beginPath();
				context.arc(ball.x, ball.y, BALL_R + lift - 2.5, Math.PI * 0.75, Math.PI * 1.45);
				context.stroke();
			}

			/**
			 * The wind-up, as a bar beside the racket, with the part of it that
			 * still lands in the court marked. Past that line it is a fault,
			 * and the bar says so before the ball does.
			 */
			function drawCharge() {
				const racket = racketOf('player');
				const x = paddleX('player') - 18;
				const top = racket.mid - PADDLE_H / 2;
				const safe = safeCharge();

				context.fillStyle = 'rgba(8, 16, 26, 0.45)';
				context.fillRect(x, top, 6, PADDLE_H);
				context.fillStyle = 'rgba(255, 255, 255, 0.26)';
				context.fillRect(x, top + PADDLE_H * (1 - safe), 6, PADDLE_H * safe);
				if (charge > 0) {
					context.fillStyle = charge > safe ? '#ff5d4d' : '#d8f000';
					context.fillRect(x, top + PADDLE_H * (1 - charge), 6, PADDLE_H * charge);
				}
			}

			function loop(now: number) {
				const seconds = Math.min((now - last) / 1000, 1 / 30);
				last = now;
				step(seconds);
				draw();
				if (running) frame = requestAnimationFrame(loop);
			}

			function start() {
				if (running) return;
				running = true;
				last = performance.now();
				frame = requestAnimationFrame(loop);
			}

			function stop() {
				running = false;
				cancelAnimationFrame(frame);
			}

			// ── The stat sheet ────────────────────────────────────────────

			function renderStats() {
				statsPlayer.textContent = displayName();
				statsBody.textContent = '';
				for (const row of summarise(stats)) {
					const line = document.createElement('tr');
					const mine = document.createElement('td');
					mine.textContent = row.player;
					const label = document.createElement('th');
					label.scope = 'row';
					label.textContent = row.label[lang];
					const theirs = document.createElement('td');
					theirs.textContent = row.cpu;
					const [a, b] = row.share;
					const ahead = row.better === 'fewer' ? (x: number, y: number) => x < y : (x: number, y: number) => x > y;
					if (a !== b && ahead(a, b)) mine.classList.add('lead');
					if (a !== b && ahead(b, a)) theirs.classList.add('lead');
					line.append(mine, label, theirs);
					statsBody.append(line);
				}
			}

			// ── The career panel ──────────────────────────────────────────

			const careerPanel = this.querySelector<HTMLElement>('[data-career]')!;
			const careerFigures = this.querySelector<HTMLElement>('[data-career-figures]')!;
			const careerBody = this.querySelector<HTMLElement>('[data-career-body]')!;
			const careerDone = this.querySelector<HTMLButtonElement>('[data-career-done]')!;
			/** Blocks play while the tree is open. */
			let browsing = false;

			function figure(label: string, value: string) {
				const term = document.createElement('dt');
				term.textContent = label;
				const detail = document.createElement('dd');
				detail.textContent = value;
				careerFigures.append(term, detail);
			}

			function renderCareer() {
				careerFigures.textContent = '';
				figure(text.ranking, `${formatRank(career.points, lang)} · ${career.points}`);
				figure(text.prizeMoney, formatPrize(career.prize, locale));
				figure(text.titles, String(career.titles));
				figure(text.matchesWon, String(career.won));
				figure(text.best, ROUNDS[Math.min(career.best, CHAMPION)]!.name[lang]);

				careerBody.textContent = '';
				careerBody.append(handRow());
				for (const branch of BRANCHES) careerBody.append(branchColumn(branch));
			}

			/**
			 * Which way round the player's own two wings are. It costs nothing,
			 * because it is not an upgrade — a left-hander's forehand simply
			 * lands on the other half of the racket, and on the other half of
			 * his.
			 */
			function handRow() {
				const row = document.createElement('section');
				row.className = 'branch hand';

				const title = document.createElement('h4');
				title.textContent = text.plays;
				const note = document.createElement('p');
				note.className = 'branch-note';
				note.textContent = text.handNote;
				row.append(title, note);

				for (const hand of ['right', 'left'] as Hand[]) {
					const button = document.createElement('button');
					button.type = 'button';
					button.className = 'node choice';
					button.dataset.state = career.hand === hand ? 'owned' : 'open';
					const name = document.createElement('span');
					name.className = 'node-name';
					name.textContent = hand === 'right' ? text.rightHanded : text.leftHanded;
					button.append(name);
					button.addEventListener('click', () => {
						career.hand = hand;
						saveCareer(career);
						renderCareer();
					});
					row.append(button);
				}
				return row;
			}

			function branchColumn(branch: (typeof BRANCHES)[number]) {
				const section = document.createElement('section');
				section.className = 'branch';

				const title = document.createElement('h4');
				title.textContent = branch.name[lang];
				const note = document.createElement('p');
				note.className = 'branch-note';
				note.textContent = branch.note[lang];
				section.append(title, note);

				if (branch.id === 'backhand' && career.backhand === null) {
					section.append(backhandFork());
					return section;
				}

				for (const node of nodesIn(branch.id, career.backhand)) {
					section.append(nodeCard(node));
				}
				return section;
			}

			/** The one choice in the tree that cannot be bought back. */
			function backhandFork() {
				const wrap = document.createDocumentFragment();
				const styles: [BackhandStyle, string, string][] = [
					['two', text.twoHanded, text.twoHandedNote],
					['one', text.oneHanded, text.oneHandedNote],
				];
				for (const [style, name, note] of styles) {
					const button = document.createElement('button');
					button.type = 'button';
					button.className = 'node choice';
					button.dataset.state = 'open';
					const label = document.createElement('span');
					label.className = 'node-name';
					label.textContent = name;
					const detail = document.createElement('span');
					detail.className = 'node-note';
					detail.textContent = note;
					button.append(label, detail);
					button.addEventListener('click', () => {
						career.backhand = style;
						saveCareer(career);
						ratings = ratingsFor(career);
						renderCareer();
						paintScore();
					});
					wrap.append(button);
				}
				const caution = document.createElement('p');
				caution.className = 'branch-note quiet';
				caution.textContent = text.backhandNote;
				wrap.append(caution);
				return wrap;
			}

			function nodeCard(node: SkillNode) {
				const owned = career.unlocked.includes(node.id);
				const open = available(node, career);
				const afford = career.prize >= node.cost;

				const button = document.createElement('button');
				button.type = 'button';
				button.className = 'node';
				button.disabled = owned || !open || !afford;
				button.dataset.state = owned ? 'owned' : !open ? 'locked' : afford ? 'open' : 'dear';

				const name = document.createElement('span');
				name.className = 'node-name';
				name.textContent = node.name[lang];

				const note = document.createElement('span');
				note.className = 'node-note';
				note.textContent = node.note[lang];

				const state = document.createElement('span');
				state.className = 'node-cost';
				state.textContent = owned
					? text.trained
					: !open
						? text.locked
						: afford
							? `${text.train} · ${formatPrize(node.cost, locale)}`
							: `${text.tooDear} · ${formatPrize(node.cost, locale)}`;

				button.append(name, note, state);
				button.addEventListener('click', () => {
					if (!available(node, career) || career.prize < node.cost) return;
					career.prize -= node.cost;
					career.unlocked = [...career.unlocked, node.id];
					saveCareer(career);
					ratings = ratingsFor(career);
					stamina = Math.min(stamina, ratings.stamina);
					renderCareer();
					paintScore();
				});
				return button;
			}

			function showCareer() {
				renderCareer();
				browsing = true;
				charging = false;
				charge = 0;
				overlay.hidden = true;
				draw(); // one frame under the panel before the loop stops
				stop();
				careerPanel.hidden = false;
				careerDone.focus();
			}

			function hideCareer() {
				browsing = false;
				careerPanel.hidden = true;
			}

			// ── The end of a match ────────────────────────────────────────

			/** Blocks play while the card is being filled in. */
			let signing = false;
			/** Blocks it while the result is up. */
			let showing = false;

			function showResult(playerWon: boolean, line: string, played: number) {
				renderStats();

				const champion = playerWon && played + 1 >= CHAMPION;
				resultHead.textContent = '';
				const headline = document.createElement('strong');
				headline.textContent = line;
				const progress = document.createElement('span');
				progress.textContent = champion
					? text.titleWon.replace('%s', String(career.titles))
					: playerWon
						? text.through.replace('%s', ROUNDS[career.round]!.name[lang])
						: text.knockedOut.replace('%s', ROUNDS[played]!.name[lang]);
				resultHead.append(headline, progress);

				resultEarned.textContent = text.earned
					.replace('%p', String(award.points))
					.replace('%m', formatPrize(award.prize, locale));
				nextButton.textContent = playerWon && !champion ? text.nextMatch : text.newDraw;

				// A win is worth keeping; a loss is worth reading the sheet over.
				resultImage.hidden = !playerWon;
				saveButton.hidden = !playerWon;
				linkedInLink.hidden = !playerWon;
				shareButton.hidden = !playerWon || typeof navigator.share !== 'function';

				if (playerWon) {
					cardRound = played + 1;
					paintCard();
					const score = scoreLine();
					resultImage.src = card.toDataURL('image/png');
					resultImage.alt = text.cardAlt
						.replace('%p', displayName())
						.replace('%o', opponentName)
						.replace('%s', score);
					fileName = `tennis-${displayName().toLowerCase().replace(/\s+/g, '-')}-${score.replace('–', '-')}.png`;
					cardFile = null;
					void cardBlob().then((blob) => {
						cardFile = blob;
					});
				}

				resultNote.textContent = '';
				showing = true;
				overlay.hidden = true;
				result.hidden = false;
				stop();
				// The match is over; the keyboard belongs to the panel now.
				nextButton.focus();
			}

			function hideResult() {
				showing = false;
				result.hidden = true;
			}

			/**
			 * The card as a file, for the share sheet and the clipboard. Made
			 * as soon as the card is shown: writing to the clipboard has to
			 * happen close to the click that asked for it, and encoding a PNG
			 * in between is enough to lose that in some browsers.
			 */
			let cardFile: Blob | null = null;
			let fileName = 'tennis.png';
			function cardBlob(): Promise<Blob | null> {
				return new Promise((resolve) => card.toBlob(resolve, 'image/png'));
			}

			function shareLine() {
				return text.shareText.replace('%s', scoreLine());
			}

			// ── Fitting the court to the screen ───────────────────────────

			/**
			 * Fits the canvas to the orientation and picks the format that
			 * goes with it. Returns true when the format changed, because a
			 * match and a tie-break cannot be continued into one another.
			 */
			function applyLayout() {
				portrait = upright.matches;
				canvas.width = portrait ? H : W;
				canvas.height = portrait ? W : H;

				const next = portrait ? 'tiebreak' : 'match';
				const changed = next !== format;
				format = next;
				out.board.dataset.format = format;
				out.hint.textContent = format === 'tiebreak' ? text.hintTiebreak : text.hint;
				return changed;
			}

			/**
			 * Sizes the canvas to the largest box the court area can hold
			 * without distorting the drawing. Done here rather than in CSS
			 * because the element's box has to match what is painted exactly:
			 * a letterboxed canvas would put every tap out by the margin.
			 */
			function fitCanvas() {
				const box = courtBox.getBoundingClientRect();
				if (!box.width || !box.height) return;

				const ratio = canvas.width / canvas.height;
				let width = box.width;
				let height = width / ratio;
				if (height > box.height) {
					height = box.height;
					width = height * ratio;
				}

				const across = `${Math.round(width)}px`;
				const down = `${Math.round(height)}px`;
				if (canvas.style.width === across && canvas.style.height === down) return; // settled
				canvas.style.width = across;
				canvas.style.height = down;
			}

			new ResizeObserver(fitCanvas).observe(courtBox);

			function refresh() {
				colors = readColors();
				paintScene();
				paintScore();
			}

			// Turning the phone changes the match being played, so it starts
			// the new one rather than carrying a half-finished score across.
			upright.addEventListener('change', () => {
				const changed = applyLayout();
				if (!dialog.open) return;
				fitCanvas();
				if (changed) {
					reset();
					if (!signing && !browsing) start();
				} else draw();
			});

			// The stadium follows the theme and the tournament, even mid-match.
			new MutationObserver(() => {
				if (dialog.open) refresh();
			}).observe(document.documentElement, {
				attributes: true,
				attributeFilter: ['class', 'data-slam'],
			});

			// ── Wiring ────────────────────────────────────────────────────

			this.querySelector<HTMLButtonElement>('.open')!.addEventListener('click', () => {
				applyLayout();
				refresh();
				reset();
				dialog.showModal();
				fitCanvas();
				if (playerName) start();
				else askName(true);
			});

			this.querySelector<HTMLButtonElement>('.close')!.addEventListener('click', () =>
				dialog.close()
			);
			dialog.addEventListener('close', () => {
				signing = false;
				entry.hidden = true;
				hideResult();
				hideCareer();
				stop();
			});
			dialog.addEventListener('click', (event) => {
				if (event.target === dialog) dialog.close();
			});

			saveButton.addEventListener('click', () => {
				const link = document.createElement('a');
				link.href = card.toDataURL('image/png');
				link.download = fileName;
				link.click();
			});

			// The share sheet only exists on some browsers; the button stays
			// hidden where it does not, rather than failing when pressed.
			shareButton.addEventListener('click', async () => {
				const blob = cardFile ?? (await cardBlob());
				const file = blob ? new File([blob], 'tennis.png', { type: 'image/png' }) : null;
				const payload: ShareData = { text: shareLine(), url: `https://${host}/` };

				try {
					if (file && navigator.canShare?.({ files: [file] })) {
						await navigator.share({ ...payload, files: [file] });
					} else {
						await navigator.share(payload);
					}
				} catch {
					// A cancelled share sheet is not a failure worth reporting.
				}
			});

			// LinkedIn takes no attachment through a link, so the result goes to
			// the clipboard on the way out and the note says to paste it. The
			// link itself opens the profile either way — the copy is a bonus,
			// and the note never claims a copy that did not happen.
			linkedInLink.addEventListener('click', async () => {
				const line = shareLine();

				try {
					if (cardFile && typeof ClipboardItem !== 'undefined' && navigator.clipboard?.write) {
						await navigator.clipboard.write([
							new ClipboardItem({
								'image/png': cardFile,
								'text/plain': new Blob([line], { type: 'text/plain' }),
							}),
						]);
						resultNote.textContent = text.copied;
						return;
					}
					await navigator.clipboard.writeText(line);
					resultNote.textContent = text.copiedText;
				} catch {
					// No clipboard: hand them the line to copy by hand.
					resultNote.textContent = line;
				}
			});

			nextButton.addEventListener('click', () => {
				hideResult();
				reset();
				start();
			});

			this.querySelector<HTMLButtonElement>('[data-career-open]')!.addEventListener('click', () => {
				if (!dialog.open) return;
				showCareer();
			});
			this.querySelector<HTMLButtonElement>('[data-career-from-result]')!.addEventListener(
				'click',
				() => {
					hideResult();
					showCareer();
				}
			);
			careerDone.addEventListener('click', () => {
				hideCareer();
				if (over || showing) {
					// The match it was opened over is already finished.
					result.hidden = false;
					showing = true;
					nextButton.focus();
					return;
				}
				announce(
					phase === 'serve' && server === 'player'
						? portrait
							? text.serveTap
							: text.serve
						: ''
				);
				start();
			});

			this.querySelector<HTMLButtonElement>('[data-career-reset]')!.addEventListener('click', () => {
				if (!confirm(text.resetConfirm)) return;
				clearCareer();
				career = freshCareer();
				ratings = ratingsFor(career);
				hideCareer();
				reset();
				start();
			});

			function askName(initial: boolean) {
				signing = true;
				charging = false;
				charge = 0;
				entry.hidden = false;
				overlay.hidden = true;
				// The card sits over the stadium, so there has to be one on the
				// canvas before the loop is stopped underneath it.
				draw();
				nameInput.value = playerName;
				// A returning player is renaming, so start from a clean field
				// only when there is nothing to rename.
				if (initial) nameInput.value = '';
				stop();
				nameInput.focus();
				nameInput.select();
			}

			function closeName() {
				signing = false;
				entry.hidden = true;
				if (!showing && !browsing) {
					announce(
						phase === 'serve' && server === 'player'
							? portrait
								? text.serveTap
								: text.serve
							: ''
					);
					start();
				}
			}

			entry.addEventListener('submit', (event) => {
				event.preventDefault();
				playerName = nameInput.value.trim().slice(0, 14);
				storeName(playerName);
				paintScore();
				closeName();
			});

			this.querySelector<HTMLButtonElement>('[data-rename]')!.addEventListener('click', () => {
				askName(false);
			});

			// ── Serving: hold to wind up, let go to hit ───────────────────

			const busy = () => signing || showing || browsing || over;

			function windUp() {
				if (busy()) return;
				if (phase !== 'serve' || server !== 'player' || waiting > 0) return;
				charging = true;
			}

			function letGo() {
				if (!charging) return;
				const value = charge;
				charging = false;
				if (phase !== 'serve' || server !== 'player') {
					charge = 0;
					return;
				}
				// A quick tap is a soft serve, not a fault: the racket still
				// goes through the ball.
				hitServe('player', Math.max(value, 0.2));
			}

			canvas.addEventListener('pointerdown', (event) => {
				if (signing) return;
				track(event);
				windUp();
			});
			canvas.addEventListener('pointermove', track);
			canvas.addEventListener('pointerup', letGo);
			canvas.addEventListener('pointercancel', letGo);
			canvas.addEventListener('pointerleave', () => {
				pointerY = null;
			});
			// A finger lifted off the canvas still finishes the serve.
			addEventListener('pointerup', letGo);

			function track(event: PointerEvent) {
				const box = canvas.getBoundingClientRect();
				// Upright, the court's length runs down the screen, so the
				// racket is moved across it — the finger's x, not its y.
				pointerY = portrait
					? ((event.clientX - box.left) / box.width) * H
					: ((event.clientY - box.top) / box.height) * H;
			}

			/** A control that wants the key for itself: buttons and the name field. */
			const ownsKeys = (target: EventTarget | null) =>
				target instanceof Element &&
				target.closest('button, input, select, textarea, a[href]') !== null;

			// The match listens on the document, not on the dialog: hiding the
			// name field or the result panel drops focus back to the body, and
			// a listener on the dialog would never see the keys again.
			document.addEventListener('keydown', (event: KeyboardEvent) => {
				if (!dialog.open) return;
				if (signing) {
					// The field owns the keyboard: space types a space, Escape
					// leaves the name as it was rather than closing the match.
					if (event.key === 'Escape') {
						event.preventDefault();
						event.stopPropagation();
						closeName();
					}
					return;
				}
				if (browsing && event.key === 'Escape') {
					event.preventDefault();
					event.stopPropagation();
					careerDone.click();
					return;
				}
				if (event.key === ' ' || event.key === 'Enter') {
					// Space and Enter belong to whichever button is focused.
					if (ownsKeys(event.target)) return;
					event.preventDefault();
					if (!event.repeat) windUp();
					return;
				}
				if (
					['ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight', 'w', 'W', 's', 'S'].includes(
						event.key
					)
				) {
					event.preventDefault();
					pointerY = null; // hand control back to the keyboard
					keys.add(event.key);
				}
			});

			document.addEventListener('keyup', (event: KeyboardEvent) => {
				keys.delete(event.key);
				if ((event.key === ' ' || event.key === 'Enter') && dialog.open && !ownsKeys(event.target)) {
					letGo();
				}
			});

			// A tab sent to the background should not bank a walkover.
			document.addEventListener('visibilitychange', () => {
				if (!dialog.open) return;
				if (document.hidden) stop();
				else if (!signing && !showing && !browsing) start();
			});

			applyLayout();
			paintScore();
		}
	}

	customElements.define('tennis-game', TennisGame);
</script>

<style>
	.open {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		padding: 0.4rem 0.9rem;
		font: inherit;
		font-size: var(--text-sm);
		font-family: var(--font-brand);
		color: var(--gray-400);
		background-color: transparent;
		border: 1px solid var(--border);
		border-radius: var(--radius-full);
		cursor: pointer;
		transition:
			color var(--theme-transition),
			border-color var(--theme-transition);
	}

	.open:hover,
	.open:focus-visible {
		color: var(--accent-regular);
		border-color: var(--accent-regular);
	}

	.ball {
		width: 1.1em;
		height: 1.1em;
		fill: none;
		stroke: currentcolor;
		stroke-width: 1.6;
	}

	.stage {
		width: min(58rem, 94vw);
		max-width: 94vw;
		/* The global reset zeroes every margin, which also takes away the
		   `margin: auto` a modal dialog is centred with. */
		margin: auto;
		padding: 0;
		border: 1px solid var(--border);
		border-radius: var(--radius-lg);
		background-color: var(--surface);
		color: var(--gray-200);
		overflow: hidden;
	}

	.stage::backdrop {
		background: hsla(212, 65%, 8%, 0.86);
	}

	.frame {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		padding: 1rem;
	}

	/* ── The tournament's scoreboard ──────────────────────────────── */

	.board {
		position: relative;
		display: flex;
		align-items: center;
		gap: 1.25rem;
		padding: 0.6rem 3.25rem 0.6rem 0.9rem;
		border-radius: var(--board-radius);
		background-color: var(--board-bg);
		color: var(--board-text);
		font-family: var(--font-brand);
	}

	.brand {
		display: flex;
		flex-direction: column;
		gap: 0.1rem;
		min-width: 0;
		flex: 1;
	}

	.tournament {
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--board-accent);
	}

	.venue {
		font-size: 0.7rem;
		color: var(--board-muted);
		/* On a narrow board this would otherwise wrap to three lines and
		   push the court down the screen. */
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	/* Where the match sits in the draw: the round, the ranking, the seeding.
	   A broadcast puts this under the tournament's name, and so does this. */
	.standing {
		font-size: 0.68rem;
		font-weight: 600;
		letter-spacing: 0.04em;
		color: var(--board-accent);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.format {
		display: none;
		align-self: flex-start;
		margin-top: 0.2rem;
		padding: 0.05rem 0.4rem;
		border-radius: calc(var(--board-radius) / 2);
		background-color: rgba(255, 255, 255, 0.16);
		font-size: 0.65rem;
		font-weight: 600;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	/* A tie-break has no games to show, and says so instead. */
	.board[data-format='tiebreak'] .format {
		display: inline-block;
	}

	.board[data-format='tiebreak'] .games {
		display: none;
