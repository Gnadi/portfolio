{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"redirects": [
		{
			"source": "/:path*",
			"has": [{ "type": "host", "value": "gnadlinger.me" }],
			"destination": "https://www.gnadlinger.me/:path*",
			"permanent": true
		},
		{ "source": "/gnadlinger", "destination": "/about/", "permanent": true },
		{ "source": "/de/gnadlinger", "destination": "/de/about/", "permanent": true }
	]
}
